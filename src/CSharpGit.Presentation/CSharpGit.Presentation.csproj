<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <UnoSingleProject>true</UnoSingleProject>
    <AssemblyName>CSharpGit</AssemblyName>
    <ApplicationTitle>CSharpGit</ApplicationTitle>
    <ApplicationId>io.csharpgit.desktop</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <MicrosoftLoggingVersion>10.0.10</MicrosoftLoggingVersion>
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="../CSharpGit.Application/CSharpGit.Application.csproj" />
    <ProjectReference Include="../CSharpGit.Domain/CSharpGit.Domain.csproj" />
    <ProjectReference Include="../CSharpGit.Git/CSharpGit.Git.csproj" />
    <ProjectReference Include="../CSharpGit.Infrastructure/CSharpGit.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <UnoIcon Include="Assets\Icons\icon.png" Resize="true" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="PrepareWindowsRuntimeAppIcon"
          DependsOnTargets="UnoResizetizeImages"
          Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <_WindowsRuntimeAppIcon Include="$(AppIconPath)"
                              Condition="'$(AppIconPath)' != '' and Exists('$(AppIconPath)')" />
      <_WindowsRuntimeAppIcon Include="$(IntermediateOutputPath)unoresizetizer\AppIcons\*.ico"
                              Condition="'@(_WindowsRuntimeAppIcon)' == ''" />
    </ItemGroup>
    <Error Condition="'@(_WindowsRuntimeAppIcon)' == ''"
           Text="Uno.Resizetizer did not generate the Windows application icon." />
  </Target>

  <Target Name="CopyWindowsRuntimeAppIconToOutput"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="PrepareWindowsRuntimeAppIcon"
          Condition="'$(OS)' == 'Windows_NT'">
    <Copy SourceFiles="@(_WindowsRuntimeAppIcon)"
          DestinationFiles="@(_WindowsRuntimeAppIcon->'$(TargetDir)CSharpGit.ico')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWindowsRuntimeAppIconToPublish"
          AfterTargets="Publish"
          DependsOnTargets="PrepareWindowsRuntimeAppIcon"
          Condition="'$(OS)' == 'Windows_NT' and '$(PublishDir)' != ''">
    <Copy SourceFiles="@(_WindowsRuntimeAppIcon)"
          DestinationFiles="@(_WindowsRuntimeAppIcon->'$(PublishDir)CSharpGit.ico')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
