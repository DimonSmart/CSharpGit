<UserControl
    x:Class="CSharpGit.Presentation.RecentRepositoriesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="1120"
                  Margin="{StaticResource Padding.Page}"
                  Spacing="{StaticResource Spacing.XL}"
                  HorizontalAlignment="Center">
        <StackPanel Spacing="{StaticResource Spacing.M}">
          <TextBlock Text="Recent repositories" Style="{StaticResource TitleTextStyle}" />
          <TextBlock Text="Continue with a repository you opened recently, or choose another local repository."
                     Style="{StaticResource BodyTextStyle}"
                     Opacity="0.68"
                     TextWrapping="Wrap" />
        </StackPanel>

        <GridView ItemsSource="{Binding RecentRepositories}"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  HorizontalAlignment="Stretch"
                  Padding="0">
          <GridView.ItemsPanel>
            <ItemsPanelTemplate>
              <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="344" ItemHeight="156" />
            </ItemsPanelTemplate>
          </GridView.ItemsPanel>
          <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
          </GridView.ItemContainerStyle>
          <GridView.ItemTemplate>
            <DataTemplate>
              <Grid Width="344" Height="156" Padding="6">
                <Button Command="{Binding OpenCommand}"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                  <Border Style="{StaticResource FormCardStyle}"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="10"
                          Opacity="{Binding TileOpacity}">
                    <Grid ColumnDefinitions="64,*"
                          RowDefinitions="Auto,Auto,*"
                          ColumnSpacing="{StaticResource Spacing.XL}">
                      <Border Grid.RowSpan="3"
                              Width="64" Height="64" CornerRadius="9"
                              Background="{ThemeResource AccentFillColorSecondaryBrush}"
                              VerticalAlignment="Top">
                        <Grid>
                          <FontIcon Glyph="&#xE8B7;"
                                    FontSize="25"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="{Binding RepositoryGlyphOpacity}" />
                          <Image Source="{Binding RepositoryImage}"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Opacity="{Binding RepositoryImageOpacity}"
                                 ImageFailed="RepositoryImage_ImageFailed" />
                        </Grid>
                      </Border>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding DisplayName}"
                                 Style="{StaticResource TitleTextStyle}"
                                 Margin="0,1,34,0"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding Path}"
                                 Style="{StaticResource SecondaryTextStyle}"
                                 Margin="0,5,10,0"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTipService.ToolTip="{Binding Path}" />
                      <TextBlock Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding Metadata}"
                                 Style="{StaticResource SecondaryTextStyle}"
                                 Margin="0,8,10,0"
                                 VerticalAlignment="Top"
                                 Opacity="0.72"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </Button>

                <Button Command="{Binding RemoveCommand}"
                        Width="30" Height="30"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,12,12,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Remove from recent">
                  <FontIcon Glyph="&#xE711;" FontSize="{StaticResource Icon.Small}" />
                </Button>
              </Grid>
            </DataTemplate>
          </GridView.ItemTemplate>
        </GridView>

        <StackPanel Orientation="Horizontal"
                    Spacing="{StaticResource Spacing.M}"
                    HorizontalAlignment="Left">
          <Button Command="{Binding OpenRepositoryCommand}"
                  Width="240" Height="82"
                  Padding="{StaticResource Padding.Form}"
                  HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="42,*" ColumnSpacing="{StaticResource Spacing.XL}">
              <FontIcon Glyph="&#xE8B7;" FontSize="24" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="{StaticResource Spacing.XS}" VerticalAlignment="Center">
                <TextBlock Text="Open repository" Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="Choose a folder…" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </Grid>
          </Button>

          <Button Command="{Binding RemoveUnavailableRepositoriesCommand}"
                  IsEnabled="{Binding HasUnavailableRepositories}"
                  Width="240" Height="82"
                  Padding="{StaticResource Padding.Form}"
                  HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="42,*" ColumnSpacing="{StaticResource Spacing.XL}">
              <FontIcon Glyph="&#xE74D;" FontSize="24" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="{StaticResource Spacing.XS}" VerticalAlignment="Center">
                <TextBlock Text="Remove missing" Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="Clean up recent list" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </Grid>
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
