<Page x:Class="CSharpGit.Presentation.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="Auto,*">
    <Border Style="{StaticResource FormHeaderSurfaceStyle}">
      <TextBlock Text="Settings" Style="{StaticResource TitleTextStyle}" VerticalAlignment="Center" />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="200,*">
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0"
              Padding="{StaticResource Padding.Form}">
        <ListView x:Name="SettingsNavigation"
                  SelectionMode="Single"
                  SelectedIndex="0"
                  SelectionChanged="SettingsNavigation_SelectionChanged">
          <ListViewItem IsSelected="True" Style="{StaticResource FormNavigationItemStyle}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.L}">
              <FontIcon Glyph="&#xE713;" FontSize="{StaticResource Icon.Normal}" />
              <TextBlock Text="General" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
          <ListViewItem Style="{StaticResource FormNavigationItemStyle}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.L}">
              <FontIcon Glyph="&#xE943;" FontSize="{StaticResource Icon.Normal}" />
              <TextBlock Text="Git Tools" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
          <ListViewItem Style="{StaticResource FormNavigationItemStyle}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.L}">
              <FontIcon Glyph="&#xE9D9;" FontSize="{StaticResource Icon.Normal}" />
              <TextBlock Text="Diagnostics" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
        </ListView>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,Auto">
        <ScrollViewer x:Name="GeneralSettingsPanel" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="{StaticResource Padding.Page}"
                      Spacing="{StaticResource Spacing.XL}"
                      MaxWidth="760"
                      HorizontalAlignment="Left">
            <TextBlock Text="General" Style="{StaticResource TitleTextStyle}" />

            <TextBlock Text="Appearance"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <TextBlock Text="Theme" Style="{StaticResource BodyStrongTextStyle}" />
                <ComboBox x:Name="ThemeModeComboBox"
                          ItemsSource="{Binding ThemeModes}"
                          SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="220"
                          HorizontalAlignment="Left"
                          SelectionChanged="ThemeModeComboBox_SelectionChanged" />
                <TextBlock Text="System follows the operating system appearance."
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="620" />
              </StackPanel>
            </Border>

            <TextBlock Text="Git push"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <ToggleSwitch x:Name="AutoSetupRemoteOnPushToggle"
                              Header="Automatically set upstream on first push"
                              IsOn="{Binding AutoSetupRemoteOnPush, Mode=TwoWay}"
                              OnContent="On"
                              OffContent="Off"
                              Toggled="AutoSetupRemoteOnPushToggle_Toggled" />
                <TextBlock Text="Use Git push.autoSetupRemote for branches without an upstream. CSharpGit applies it only to the push command and does not modify Git configuration."
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="620" />
              </StackPanel>
            </Border>

            <TextBlock Text="Commit time display"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <TextBlock Text="Choose how commit timestamps are shown throughout CSharpGit. The setting is global, applies immediately, and is saved for future launches. Hover a commit time to see its exact local date, time, and time-zone offset."
                       Style="{StaticResource BodySubduedTextStyle}"
                       TextWrapping="Wrap"
                       MaxWidth="680" />

            <ListView x:Name="CommitTimeModeList"
                      ItemsSource="{Binding CommitTimeModes}"
                      SelectedItem="{Binding SelectedCommitTimeMode, Mode=TwoWay}"
                      SelectionMode="Single"
                      SelectionChanged="CommitTimeModeList_SelectionChanged"
                      MaxWidth="680"
                      HorizontalAlignment="Stretch"
                      ItemContainerStyle="{StaticResource FormListItemStyle}">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource FormCardStyle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.XXL}">
                      <StackPanel Spacing="{StaticResource Spacing.S}">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodyStrongTextStyle}" />
                        <TextBlock Text="{Binding Description}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Example}"
                                 Style="{StaticResource SecondaryTextStyle}"
                                 VerticalAlignment="Center"
                                 Opacity="0.78" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="GitToolsSettingsPanel"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="{StaticResource Padding.Page}"
                      Spacing="{StaticResource Spacing.XL}"
                      MaxWidth="760"
                      HorizontalAlignment="Left">
            <TextBlock Text="Git Tools" Style="{StaticResource TitleTextStyle}" />
            <TextBlock Text="CSharpGit reads and edits standard Git configuration. Presets are only UI shortcuts; the effective tool always comes from Git configuration and environment precedence."
                       Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap"
                       MaxWidth="680" />

            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <TextBlock Text="EDITOR" Style="{StaticResource SectionHeaderTextStyle}" />
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Spacing.S}">
                  <TextBlock Text="Effective" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Column="1" Text="{Binding Editor.EffectiveDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="1" Text="Source" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Editor.SourceDisplay}" Style="{StaticResource BodyTextStyle}" />
                  <TextBlock Grid.Row="2" Text="Origin" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Editor.OriginDisplay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="3" Text="Global" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Editor.GlobalDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="4" Text="Repository" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Editor.RepositoryDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="5" Text="Worktree" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Editor.WorktreeDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="6" Text="System" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Editor.SystemDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                </Grid>
                <TextBlock Text="Edit scope" Style="{StaticResource BodyStrongTextStyle}" />
                <ComboBox ItemsSource="{Binding Editor.Scopes}"
                          SelectedItem="{Binding Editor.SelectedScope, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="220"
                          HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Editor.OverrideNotice}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="Preset" Style="{StaticResource BodyStrongTextStyle}" />
                <ComboBox ItemsSource="{Binding Editor.Presets}"
                          SelectedItem="{Binding Editor.SelectedPreset, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="260"
                          HorizontalAlignment="Left" />
                <TextBox Header="Command (core.editor)"
                         Text="{Binding Editor.Value, Mode=TwoWay}"
                         Style="{StaticResource TechnicalTextBoxStyle}" />
                <TextBlock Text="Resolved executable" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="{Binding Editor.ResolvedExecutableDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Editor.ValidationDisplay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.M}">
                  <Button Content="Save" Click="EditorSave_Click" Style="{StaticResource CompactButtonStyle}" />
                  <Button Content="Open Test File" Click="EditorTest_Click" Style="{StaticResource CompactButtonStyle}" />
                  <Button Content="Remove override" IsEnabled="{Binding Editor.CanRemoveOverride}" Click="EditorRemove_Click" Style="{StaticResource CompactButtonStyle}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <TextBlock Text="DIFF TOOL" Style="{StaticResource SectionHeaderTextStyle}" />
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Spacing.S}">
                  <TextBlock Text="Effective" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Column="1" Text="{Binding Diff.EffectiveDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="1" Text="Source" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Diff.SourceDisplay}" Style="{StaticResource BodyTextStyle}" />
                  <TextBlock Grid.Row="2" Text="Origin" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Diff.OriginDisplay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="3" Text="Global" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Diff.GlobalDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="4" Text="Repository" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Diff.RepositoryDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="5" Text="Worktree" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Diff.WorktreeDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="6" Text="System" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Diff.SystemDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="7" Text="Path" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Diff.EffectivePathDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="8" Text="Command" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Diff.EffectiveCommandDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="Edit scope" Style="{StaticResource BodyStrongTextStyle}" />
                <ComboBox ItemsSource="{Binding Diff.Scopes}"
                          SelectedItem="{Binding Diff.SelectedScope, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="220"
                          HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Diff.OverrideNotice}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="Preset / Git tool" Style="{StaticResource BodyStrongTextStyle}" />
                <ComboBox ItemsSource="{Binding Diff.Presets}"
                          SelectedItem="{Binding Diff.SelectedPreset, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="260"
                          HorizontalAlignment="Left" />
                <TextBox Header="Tool name" Text="{Binding Diff.Value, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
                <TextBox Header="Explicit executable path (optional)" Text="{Binding Diff.Path, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
                <TextBox Header="Custom Git command (optional; $LOCAL and $REMOTE)"
                         Text="{Binding Diff.Command, Mode=TwoWay}"
                         Style="{StaticResource TechnicalTextBoxStyle}"
                         AcceptsReturn="False" />
                <CheckBox Content="Trust exit code (unset when indeterminate)"
                          IsThreeState="True"
                          IsChecked="{Binding Diff.TrustExitCode, Mode=TwoWay}"
                          Style="{StaticResource CompactCheckBoxStyle}" />
                <TextBlock Text="Resolved executable" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="{Binding Diff.ResolvedExecutableDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Diff.ValidationDisplay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.M}">
                  <Button Content="Save" Click="DiffSave_Click" Style="{StaticResource CompactButtonStyle}" />
                  <Button Content="Test Diff Tool" Click="DiffTest_Click" Style="{StaticResource CompactButtonStyle}" />
                  <Button Content="Remove override" IsEnabled="{Binding Diff.CanRemoveOverride}" Click="DiffRemove_Click" Style="{StaticResource CompactButtonStyle}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <TextBlock Text="MERGE TOOL" Style="{StaticResource SectionHeaderTextStyle}" />
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Spacing.S}">
                  <TextBlock Text="Effective" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Column="1" Text="{Binding Merge.EffectiveDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="1" Text="Source" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Merge.SourceDisplay}" Style="{StaticResource BodyTextStyle}" />
                  <TextBlock Grid.Row="2" Text="Origin" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Merge.OriginDisplay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="3" Text="Global" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Merge.GlobalDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="4" Text="Repository" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Merge.RepositoryDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="5" Text="Worktree" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Merge.WorktreeDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="6" Text="System" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Merge.SystemDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                  <TextBlock Grid.Row="7" Text="Path" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Merge.EffectivePathDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="8" Text="Command" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Merge.EffectiveCommandDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="Edit scope" Style="{StaticResource BodyStrongTextStyle}" />
                <ComboBox ItemsSource="{Binding Merge.Scopes}"
                          SelectedItem="{Binding Merge.SelectedScope, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="220"
                          HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Merge.OverrideNotice}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="Preset / Git tool" Style="{StaticResource BodyStrongTextStyle}" />
                <ComboBox ItemsSource="{Binding Merge.Presets}"
                          SelectedItem="{Binding Merge.SelectedPreset, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="260"
                          HorizontalAlignment="Left" />
                <TextBox Header="Tool name" Text="{Binding Merge.Value, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
                <TextBox Header="Explicit executable path (optional)" Text="{Binding Merge.Path, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
                <TextBox Header="Custom Git command (optional; $LOCAL, $REMOTE, $MERGED; $BASE optional)"
                         Text="{Binding Merge.Command, Mode=TwoWay}"
                         Style="{StaticResource TechnicalTextBoxStyle}"
                         AcceptsReturn="False" />
                <CheckBox Content="Trust exit code (unset when indeterminate)"
                          IsThreeState="True"
                          IsChecked="{Binding Merge.TrustExitCode, Mode=TwoWay}"
                          Style="{StaticResource CompactCheckBoxStyle}" />
                <CheckBox Content="Keep .orig backup (mergetool.keepBackup; unset when indeterminate)"
                          IsThreeState="True"
                          IsChecked="{Binding Merge.KeepBackup, Mode=TwoWay}"
                          Style="{StaticResource CompactCheckBoxStyle}" />
                <TextBlock Text="Resolved executable" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="{Binding Merge.ResolvedExecutableDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Merge.ValidationDisplay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.M}">
                  <Button Content="Save" Click="MergeSave_Click" Style="{StaticResource CompactButtonStyle}" />
                  <Button Content="Test Merge Tool" Click="MergeTest_Click" Style="{StaticResource CompactButtonStyle}" />
                  <Button Content="Remove override" IsEnabled="{Binding Merge.CanRemoveOverride}" Click="MergeRemove_Click" Style="{StaticResource CompactButtonStyle}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="DiagnosticsSettingsPanel"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="{StaticResource Padding.Page}"
                      Spacing="{StaticResource Spacing.XL}"
                      MaxWidth="760"
                      HorizontalAlignment="Left">
            <TextBlock Text="Diagnostics" Style="{StaticResource TitleTextStyle}" />

            <TextBlock Text="Git Console"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <TextBlock Text="Choose when the Git Console opens automatically. Internal commands never open it by themselves. The command history is session-only and is limited to the latest 100 Git commands."
                       Style="{StaticResource BodySubduedTextStyle}"
                       TextWrapping="Wrap"
                       MaxWidth="680" />
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <TextBlock Text="Auto open" Style="{StaticResource BodyStrongTextStyle}" />
                <ComboBox x:Name="GitConsoleAutoOpenComboBox"
                          ItemsSource="{Binding GitConsoleAutoOpenModes}"
                          SelectedItem="{Binding SelectedGitConsoleAutoOpenMode, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="220"
                          HorizontalAlignment="Left"
                          SelectionChanged="GitConsoleAutoOpenComboBox_SelectionChanged" />
                <TextBlock Text="On errors is the default and opens the console only after a user Git command fails."
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="620" />
              </StackPanel>
            </Border>

            <TextBlock Text="File logging"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <TextBlock Text="Enable diagnostic session logs when troubleshooting CSharpGit. Logging is off by default. Changes apply immediately and are saved for future launches."
                       Style="{StaticResource BodySubduedTextStyle}"
                       TextWrapping="Wrap"
                       MaxWidth="680" />

            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.XL}">
                <ToggleSwitch x:Name="LoggingToggle"
                              Header="Enable file logging"
                              IsOn="{Binding LoggingEnabled}"
                              OnContent="On"
                              OffContent="Off"
                              Toggled="LoggingToggle_Toggled" />

                <StackPanel Spacing="{StaticResource Spacing.M}">
                  <TextBlock Text="Log level" Style="{StaticResource BodyStrongTextStyle}" />
                  <ComboBox x:Name="LogLevelComboBox"
                            ItemsSource="{Binding LogLevels}"
                            SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                            DisplayMemberPath="Label"
                            Style="{StaticResource CompactComboBoxStyle}"
                            MinWidth="220"
                            HorizontalAlignment="Left"
                            SelectionChanged="LogLevelComboBox_SelectionChanged" />
                  <TextBlock Text="Trace is the most verbose. Information is recommended for normal diagnostics; Warning and higher reduce log volume."
                             Style="{StaticResource SecondaryTextStyle}"
                             TextWrapping="Wrap"
                             MaxWidth="620" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <InfoBar x:Name="SettingsMessage"
                 Grid.Row="1"
                 Margin="16,0,16,16"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="True" />
      </Grid>
    </Grid>
  </Grid>
</Page>
