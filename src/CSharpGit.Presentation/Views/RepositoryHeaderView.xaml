<UserControl x:Class="CSharpGit.Presentation.Views.RepositoryHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:CSharpGit.Presentation.Views">
  <Border Style="{StaticResource PaneHeaderSurfaceStyle}"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderThickness="0,0,1,1">
    <StackPanel HorizontalAlignment="Stretch" Spacing="{StaticResource Spacing.XS}">
      <views:RepositorySelectorView x:Name="Selector" />
    </StackPanel>
  </Border>
</UserControl>
