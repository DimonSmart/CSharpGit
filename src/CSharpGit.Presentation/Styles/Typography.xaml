<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
  </Style>

  <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource Font.Caption}" />
    <Setter Property="Opacity" Value="0.68" />
  </Style>

  <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
    <Setter Property="Opacity" Value="0.58" />
  </Style>

  <Style x:Key="PaneHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}" />

  <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource Font.Heading}" />
  </Style>

  <Style x:Key="ToolbarProductTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource Font.Heading}" />
  </Style>

  <Style x:Key="TitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource Font.Title}" />
  </Style>

  <Style x:Key="DiffTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
  </Style>

  <Style x:Key="DiffSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DiffTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource Font.Caption}" />
    <Setter Property="Opacity" Value="0.58" />
  </Style>
</ResourceDictionary>
