<Page x:Class="CSharpGit.Presentation.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="Auto,*">
    <Border Style="{StaticResource FormHeaderSurfaceStyle}">
      <TextBlock Text="Settings" Style="{StaticResource TitleTextStyle}" VerticalAlignment="Center" />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="200,*">
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0"
              Padding="{StaticResource Padding.Form}">
        <ListView x:Name="SettingsNavigation"
                  SelectionMode="Single"
                  SelectedIndex="0"
                  SelectionChanged="SettingsNavigation_SelectionChanged">
          <ListViewItem IsSelected="True" Style="{StaticResource FormNavigationItemStyle}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.L}">
              <FontIcon Glyph="&#xE713;" FontSize="{StaticResource Icon.Normal}" />
              <TextBlock Text="General" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
          <ListViewItem Style="{StaticResource FormNavigationItemStyle}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.L}">
              <FontIcon Glyph="&#xE77B;" FontSize="{StaticResource Icon.Normal}" />
              <TextBlock Text="Identity" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
          <ListViewItem Style="{StaticResource FormNavigationItemStyle}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.L}">
              <FontIcon Glyph="&#xE943;" FontSize="{StaticResource Icon.Normal}" />
              <TextBlock Text="Git Tools" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
          <ListViewItem Style="{StaticResource FormNavigationItemStyle}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.L}">
              <FontIcon Glyph="&#xE9D9;" FontSize="{StaticResource Icon.Normal}" />
              <TextBlock Text="Diagnostics" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
        </ListView>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,Auto">
        <ScrollViewer x:Name="GeneralSettingsPanel" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="{StaticResource Padding.Page}"
                      Spacing="{StaticResource Spacing.XL}"
                      MaxWidth="760"
                      HorizontalAlignment="Left">
            <TextBlock Text="General" Style="{StaticResource TitleTextStyle}" />

            <TextBlock Text="Appearance"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <TextBlock Text="Theme" Style="{StaticResource BodyStrongTextStyle}" />
                <ComboBox x:Name="ThemeModeComboBox"
                          ItemsSource="{Binding ThemeModes}"
                          SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="220"
                          HorizontalAlignment="Left"
                          SelectionChanged="ThemeModeComboBox_SelectionChanged" />
                <ToggleSwitch x:Name="ShowAuthorAvatarsToggle"
                              Header="Show author avatars"
                              IsOn="{Binding ShowAuthorAvatars, Mode=TwoWay}"
                              Toggled="ShowAuthorAvatarsToggle_Toggled" />
                <StackPanel Margin="16,0,0,0" Spacing="{StaticResource Spacing.S}"
                            IsEnabled="{Binding CanConfigureOnlineAvatars}">
                  <ToggleSwitch x:Name="OnlineAvatarLookupToggle"
                                Header="Load avatar images from online services"
                                IsOn="{Binding OnlineAvatarLookupEnabled, Mode=TwoWay}"
                                Toggled="OnlineAvatarLookupToggle_Toggled" />
                  <TextBlock Text="May contact GitHub or Gravatar; Gravatar uses a SHA-256 hash derived from the commit author email."
                             Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="Repositories"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <TextBlock Text="Default repositories folder" Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="Used as the default location for cloned repositories."
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.M}">
                  <TextBox x:Name="DefaultRepositoriesDirectoryTextBox"
                           Text="{Binding DefaultRepositoriesDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource CompactTextBoxStyle}"
                           MinWidth="360"
                           HorizontalAlignment="Stretch"
                           LostFocus="DefaultRepositoriesDirectoryTextBox_LostFocus" />
                  <Button Grid.Column="1"
                          Content="Browse…"
                          Style="{StaticResource CompactButtonStyle}"
                          Click="DefaultRepositoriesDirectoryBrowse_Click" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="Git operations"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <TextBlock Text="CSharpGit preferences only; these do not change persistent Git configuration."
                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxWidth="680" />
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <TextBlock Text="Default Pull strategy" Style="{StaticResource BodyStrongTextStyle}" />
                <ComboBox x:Name="PullStrategyComboBox"
                          ItemsSource="{Binding PullStrategies}"
                          SelectedItem="{Binding SelectedPullStrategy, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="220"
                          HorizontalAlignment="Left"
                          SelectionChanged="PullStrategyComboBox_SelectionChanged" />
                <ToggleSwitch x:Name="ForcePullAutoStashToggle"
                              Header="Force Git autostash"
                              IsOn="{Binding ForcePullAutoStash, Mode=TwoWay}"
                              Toggled="ForcePullAutoStashToggle_Toggled" />
                <ToggleSwitch x:Name="AutoSetupRemoteOnPushToggle"
                              Header="Automatically set upstream on first push"
                              IsOn="{Binding AutoSetupRemoteOnPush, Mode=TwoWay}"
                              Toggled="AutoSetupRemoteOnPushToggle_Toggled" />
                <TextBlock Text="Uses push.autoSetupRemote for this push only; does not change Git configuration."
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <TextBlock Text="Commit time display"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.S}">
                <ComboBox x:Name="CommitTimeModeComboBox"
                          ItemsSource="{Binding CommitTimeModes}"
                          SelectedItem="{Binding SelectedCommitTimeMode, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="220"
                          HorizontalAlignment="Left"
                          SelectionChanged="CommitTimeModeComboBox_SelectionChanged" />
                <TextBlock Text="{Binding SelectedCommitTimeMode.Description}"
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedCommitTimeMode.Example}"
                           Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="Applies everywhere. Hover a commit time for the exact local timestamp and offset."
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="IdentitySettingsPanel"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="{StaticResource Padding.Page}"
                      Spacing="{StaticResource Spacing.XL}"
                      MaxWidth="760"
                      HorizontalAlignment="Left">
            <TextBlock Text="Identity" Style="{StaticResource TitleTextStyle}" />

            <TextBlock Text="Repository"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <TextBlock Text="Open a repository to configure its Git identity."
                           Style="{StaticResource SecondaryTextStyle}"
                           Visibility="{Binding HasNoRepository, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel Spacing="{StaticResource Spacing.S}"
                            Visibility="{Binding HasRepository, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="{Binding RepositoryName}" Style="{StaticResource BodyStrongTextStyle}" />
                  <TextBlock Text="{Binding RepositoryPath}"
                             Style="{StaticResource TechnicalTextStyle}"
                             IsTextSelectionEnabled="True"
                             TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="Commit identity"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <TextBlock Text="Base Git identity for commits in this repository."
                       Style="{StaticResource BodySubduedTextStyle}"
                       TextWrapping="Wrap"
                       MaxWidth="680" />

            <Border Style="{StaticResource FormCardStyle}"
                    MaxWidth="680"
                    Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <TextBlock Text="{Binding StaleWarning}"
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap" />
                <Button Content="Discard changes and reload"
                        Click="IdentityReload_Click"
                        Style="{StaticResource CompactButtonStyle}"
                        HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding RepositoryReloadNotice}"
                       Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap"
                       MaxWidth="680"
                       Visibility="{Binding HasRepositoryReloadNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Text="{Binding HigherPriorityWarning}"
                       Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap"
                       MaxWidth="680"
                       Visibility="{Binding HasHigherPriorityWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <TextBlock Text="Name" Style="{StaticResource BodyStrongTextStyle}" />
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource Spacing.S}">
                  <TextBlock Text="Effective" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Column="1" Text="{Binding NameEffectiveDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Text="Source" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NameSourceDisplay}" Style="{StaticResource BodyTextStyle}" />
                  <TextBlock Grid.Row="2" Text="Origin" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NameOriginDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                </Grid>
                <TextBox Header="Name"
                         Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{Binding NamePlaceholder}"
                         IsEnabled="{Binding CanEdit}"
                         Style="{StaticResource CompactTextBoxStyle}" />
                <TextBlock Text="{Binding NameValidationMessage}"
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasNameValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.M}">
                  <TextBlock Text="{Binding NameOverrideDisplay}"
                             Style="{StaticResource SecondaryTextStyle}"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Content="Remove override"
                          IsEnabled="{Binding CanRemoveNameOverride}"
                          Click="IdentityNameRemove_Click"
                          Style="{StaticResource DestructiveActionButtonStyle}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <TextBlock Text="Email" Style="{StaticResource BodyStrongTextStyle}" />
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource Spacing.S}">
                  <TextBlock Text="Effective" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Column="1" Text="{Binding EmailEffectiveDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Text="Source" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EmailSourceDisplay}" Style="{StaticResource BodyTextStyle}" />
                  <TextBlock Grid.Row="2" Text="Origin" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EmailOriginDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                </Grid>
                <TextBox Header="Email"
                         Text="{Binding EmailText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{Binding EmailPlaceholder}"
                         IsEnabled="{Binding CanEdit}"
                         Style="{StaticResource CompactTextBoxStyle}" />
                <TextBlock Text="{Binding EmailValidationMessage}"
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasEmailValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.M}">
                  <TextBlock Text="{Binding EmailOverrideDisplay}"
                             Style="{StaticResource SecondaryTextStyle}"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Content="Remove override"
                          IsEnabled="{Binding CanRemoveEmailOverride}"
                          Click="IdentityEmailRemove_Click"
                          Style="{StaticResource DestructiveActionButtonStyle}" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="This value is not explicitly configured in Git when Effective shows Not configured."
                       Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap"
                       MaxWidth="680" />

            <Button Content="Save for this repository"
                    IsEnabled="{Binding CanSave}"
                    Click="IdentitySave_Click"
                    Style="{StaticResource CompactButtonStyle}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="GitToolsSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="{StaticResource Padding.Page}" Spacing="{StaticResource Spacing.XL}"
                      MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Git Tools" Style="{StaticResource TitleTextStyle}" />
            <TextBlock Text="Git configuration remains the source of truth. Select a tool and scope, then Save."
                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxWidth="680" />
            <TextBlock Text="{Binding Editor.StaleNotice}" Style="{StaticResource BodyStrongTextStyle}"
                       Visibility="{Binding Editor.IsStale, Converter={StaticResource BooleanToVisibilityConverter}}"
                       TextWrapping="Wrap" MaxWidth="680" />
            <Button Content="Discard changes and reload" Click="GitToolsReload_Click"
                    Style="{StaticResource SecondaryActionButtonStyle}" HorizontalAlignment="Left" />
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
               <StackPanel Spacing="{StaticResource Spacing.M}">
                 <TextBlock Text="EDITOR" Style="{StaticResource SectionHeaderTextStyle}" />
                 <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Spacing.S}">
                   <TextBlock Text="Effective" Style="{StaticResource SecondaryTextStyle}" />
                   <TextBlock Grid.Column="1" Text="{Binding Editor.EffectiveDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                   <TextBlock Grid.Row="1" Text="Source" Style="{StaticResource SecondaryTextStyle}" />
                   <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Editor.SourceDisplay}" Style="{StaticResource SecondaryTextStyle}" />
                 </Grid>
                 <TextBlock Text="Edit scope" Style="{StaticResource BodyStrongTextStyle}" />
                 <ComboBox ItemsSource="{Binding Editor.Scopes}" SelectedItem="{Binding Editor.SelectedScope, Mode=TwoWay}"
                           DisplayMemberPath="Label" Style="{StaticResource CompactComboBoxStyle}" MinWidth="220" HorizontalAlignment="Left" />
                 <TextBlock Text="{Binding Editor.OverrideNotice}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                 <TextBlock Text="Editor" Style="{StaticResource BodyStrongTextStyle}" />
                 <ComboBox ItemsSource="{Binding Editor.Presets}" SelectedItem="{Binding Editor.SelectedPreset, Mode=TwoWay}"
                           DisplayMemberPath="DisplayName" Style="{StaticResource CompactComboBoxStyle}" MinWidth="260" HorizontalAlignment="Left" />
                 <TextBox Header="Command" Text="{Binding Editor.Value, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
                 <TextBlock Text="{Binding Editor.ValidationDisplay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                 <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.M}">
                   <Button Content="Save" IsEnabled="{Binding Editor.CanSave}" Click="EditorSave_Click" Style="{StaticResource PrimaryActionButtonStyle}" />
                   <Button Content="Open Test File" Click="EditorTest_Click" Style="{StaticResource SecondaryActionButtonStyle}" />
                 </StackPanel>
                 <Expander Header="Advanced" HorizontalAlignment="Stretch">
                   <StackPanel Spacing="{StaticResource Spacing.M}" Padding="{StaticResource Padding.Form}">
                     <TextBox Header="Editor command (core.editor)" Text="{Binding Editor.Value, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
                     <TextBlock Text="Effective Git configuration" Style="{StaticResource BodyStrongTextStyle}" />
                     <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Spacing.S}">
                       <TextBlock Text="Effective" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Column="1" Text="{Binding Editor.EffectiveDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                       <TextBlock Grid.Row="1" Text="Origin" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Editor.OriginDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                       <TextBlock Grid.Row="2" Text="Global" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Editor.GlobalDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                       <TextBlock Grid.Row="3" Text="Repository" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Editor.RepositoryDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                       <TextBlock Grid.Row="4" Text="Worktree" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Editor.WorktreeDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                       <TextBlock Grid.Row="5" Text="System" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Editor.SystemDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                       <TextBlock Grid.Row="6" Text="Path" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Editor.EffectivePathDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                       <TextBlock Grid.Row="7" Text="Command" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Editor.EffectiveCommandDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                     </Grid>
                     <TextBlock Text="Resolved executable" Style="{StaticResource SecondaryTextStyle}" />
                     <TextBlock Text="{Binding Editor.ResolvedExecutableDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                     <Button Content="Remove override" IsEnabled="{Binding Editor.CanRemoveOverride}" Click="EditorRemove_Click"
                             Style="{StaticResource DestructiveActionButtonStyle}" HorizontalAlignment="Left" />
                   </StackPanel>
                 </Expander>
               </StackPanel>
             </Border>
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
               <StackPanel Spacing="{StaticResource Spacing.M}">
                 <TextBlock Text="DIFF TOOL" Style="{StaticResource SectionHeaderTextStyle}" />
                 <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Spacing.S}">
                   <TextBlock Text="Effective" Style="{StaticResource SecondaryTextStyle}" />
                   <TextBlock Grid.Column="1" Text="{Binding Diff.EffectiveDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                   <TextBlock Grid.Row="1" Text="Source" Style="{StaticResource SecondaryTextStyle}" />
                   <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Diff.SourceDisplay}" Style="{StaticResource SecondaryTextStyle}" />
                 </Grid>
                 <TextBlock Text="Edit scope" Style="{StaticResource BodyStrongTextStyle}" />
                 <ComboBox ItemsSource="{Binding Diff.Scopes}" SelectedItem="{Binding Diff.SelectedScope, Mode=TwoWay}"
                           DisplayMemberPath="Label" Style="{StaticResource CompactComboBoxStyle}" MinWidth="220" HorizontalAlignment="Left" />
                 <TextBlock Text="{Binding Diff.OverrideNotice}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                 <TextBlock Text="Tool" Style="{StaticResource BodyStrongTextStyle}" />
                 <ComboBox ItemsSource="{Binding Diff.Presets}" SelectedItem="{Binding Diff.SelectedPreset, Mode=TwoWay}"
                           DisplayMemberPath="DisplayName" Style="{StaticResource CompactComboBoxStyle}" MinWidth="260" HorizontalAlignment="Left" />
                 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.M}">
                   <TextBox Header="Executable path (optional)" Text="{Binding Diff.Path, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
                   <Button Grid.Column="1" Content="Browse…" Click="DiffExecutableBrowse_Click" Style="{StaticResource CompactButtonStyle}" VerticalAlignment="Bottom" />
                 </Grid>
                 <TextBlock Text="{Binding Diff.ValidationDisplay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                 <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.M}">
                   <Button Content="Save" IsEnabled="{Binding Diff.CanSave}" Click="DiffSave_Click" Style="{StaticResource PrimaryActionButtonStyle}" />
                   <Button Content="Test Diff Tool" Click="DiffTest_Click" Style="{StaticResource SecondaryActionButtonStyle}" />
                 </StackPanel>
                 <Expander Header="Advanced" HorizontalAlignment="Stretch">
                   <StackPanel Spacing="{StaticResource Spacing.M}" Padding="{StaticResource Padding.Form}">
                     <TextBox Header="Tool name" Text="{Binding Diff.Value, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
               <TextBox Header="Explicit executable path" Text="{Binding Diff.Path, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
               <TextBox Header="Custom Git command" Text="{Binding Diff.Command, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
               <CheckBox Content="Trust exit code (unset when indeterminate)" IsThreeState="True"
                         IsChecked="{Binding Diff.TrustExitCode, Mode=TwoWay}" Style="{StaticResource CompactCheckBoxStyle}" />
               
                     <TextBlock Text="Effective Git configuration" Style="{StaticResource BodyStrongTextStyle}" />
                     <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Spacing.S}">
                       <TextBlock Text="Effective" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Column="1" Text="{Binding Diff.EffectiveDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                       <TextBlock Grid.Row="1" Text="Origin" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Diff.OriginDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                       <TextBlock Grid.Row="2" Text="Global" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Diff.GlobalDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                       <TextBlock Grid.Row="3" Text="Repository" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Diff.RepositoryDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                       <TextBlock Grid.Row="4" Text="Worktree" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Diff.WorktreeDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                       <TextBlock Grid.Row="5" Text="System" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Diff.SystemDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                       <TextBlock Grid.Row="6" Text="Path" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Diff.EffectivePathDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                       <TextBlock Grid.Row="7" Text="Command" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Diff.EffectiveCommandDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                     </Grid>
                     <TextBlock Text="Resolved executable" Style="{StaticResource SecondaryTextStyle}" />
                     <TextBlock Text="{Binding Diff.ResolvedExecutableDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                     <Button Content="Remove override" IsEnabled="{Binding Diff.CanRemoveOverride}" Click="DiffRemove_Click"
                             Style="{StaticResource DestructiveActionButtonStyle}" HorizontalAlignment="Left" />
                   </StackPanel>
                 </Expander>
               </StackPanel>
             </Border>
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
               <StackPanel Spacing="{StaticResource Spacing.M}">
                 <TextBlock Text="MERGE TOOL" Style="{StaticResource SectionHeaderTextStyle}" />
                 <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Spacing.S}">
                   <TextBlock Text="Effective" Style="{StaticResource SecondaryTextStyle}" />
                   <TextBlock Grid.Column="1" Text="{Binding Merge.EffectiveDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                   <TextBlock Grid.Row="1" Text="Source" Style="{StaticResource SecondaryTextStyle}" />
                   <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Merge.SourceDisplay}" Style="{StaticResource SecondaryTextStyle}" />
                 </Grid>
                 <TextBlock Text="Edit scope" Style="{StaticResource BodyStrongTextStyle}" />
                 <ComboBox ItemsSource="{Binding Merge.Scopes}" SelectedItem="{Binding Merge.SelectedScope, Mode=TwoWay}"
                           DisplayMemberPath="Label" Style="{StaticResource CompactComboBoxStyle}" MinWidth="220" HorizontalAlignment="Left" />
                 <TextBlock Text="{Binding Merge.OverrideNotice}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                 <TextBlock Text="Tool" Style="{StaticResource BodyStrongTextStyle}" />
                 <ComboBox ItemsSource="{Binding Merge.Presets}" SelectedItem="{Binding Merge.SelectedPreset, Mode=TwoWay}"
                           DisplayMemberPath="DisplayName" Style="{StaticResource CompactComboBoxStyle}" MinWidth="260" HorizontalAlignment="Left" />
                 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.M}">
                   <TextBox Header="Executable path (optional)" Text="{Binding Merge.Path, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
                   <Button Grid.Column="1" Content="Browse…" Click="MergeExecutableBrowse_Click" Style="{StaticResource CompactButtonStyle}" VerticalAlignment="Bottom" />
                 </Grid>
                 <TextBlock Text="{Binding Merge.ValidationDisplay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                 <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.M}">
                   <Button Content="Save" IsEnabled="{Binding Merge.CanSave}" Click="MergeSave_Click" Style="{StaticResource PrimaryActionButtonStyle}" />
                   <Button Content="Test Merge Tool" Click="MergeTest_Click" Style="{StaticResource SecondaryActionButtonStyle}" />
                 </StackPanel>
                 <Expander Header="Advanced" HorizontalAlignment="Stretch">
                   <StackPanel Spacing="{StaticResource Spacing.M}" Padding="{StaticResource Padding.Form}">
                     <TextBox Header="Tool name" Text="{Binding Merge.Value, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
               <TextBox Header="Explicit executable path" Text="{Binding Merge.Path, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
               <TextBox Header="Custom Git command" Text="{Binding Merge.Command, Mode=TwoWay}" Style="{StaticResource TechnicalTextBoxStyle}" />
               <CheckBox Content="Trust exit code (unset when indeterminate)" IsThreeState="True"
                         IsChecked="{Binding Merge.TrustExitCode, Mode=TwoWay}" Style="{StaticResource CompactCheckBoxStyle}" />
               <CheckBox Content="Keep .orig backup (mergetool.keepBackup; unset when indeterminate)" IsThreeState="True"
                         IsChecked="{Binding Merge.KeepBackup, Mode=TwoWay}" Style="{StaticResource CompactCheckBoxStyle}" />
                     <TextBlock Text="Effective Git configuration" Style="{StaticResource BodyStrongTextStyle}" />
                     <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Spacing.S}">
                       <TextBlock Text="Effective" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Column="1" Text="{Binding Merge.EffectiveDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                       <TextBlock Grid.Row="1" Text="Origin" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Merge.OriginDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                       <TextBlock Grid.Row="2" Text="Global" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Merge.GlobalDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                       <TextBlock Grid.Row="3" Text="Repository" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Merge.RepositoryDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                       <TextBlock Grid.Row="4" Text="Worktree" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Merge.WorktreeDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                       <TextBlock Grid.Row="5" Text="System" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Merge.SystemDisplay}" Style="{StaticResource TechnicalTextStyle}" />
                       <TextBlock Grid.Row="6" Text="Path" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Merge.EffectivePathDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                       <TextBlock Grid.Row="7" Text="Command" Style="{StaticResource SecondaryTextStyle}" />
                       <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Merge.EffectiveCommandDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                     </Grid>
                     <TextBlock Text="Resolved executable" Style="{StaticResource SecondaryTextStyle}" />
                     <TextBlock Text="{Binding Merge.ResolvedExecutableDisplay}" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                     <Button Content="Remove override" IsEnabled="{Binding Merge.CanRemoveOverride}" Click="MergeRemove_Click"
                             Style="{StaticResource DestructiveActionButtonStyle}" HorizontalAlignment="Left" />
                   </StackPanel>
                 </Expander>
               </StackPanel>
             </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="DiagnosticsSettingsPanel"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="{StaticResource Padding.Page}"
                      Spacing="{StaticResource Spacing.XL}"
                      MaxWidth="760"
                      HorizontalAlignment="Left">
            <TextBlock Text="Diagnostics" Style="{StaticResource TitleTextStyle}" />

            <TextBlock Text="Git Console"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.S}">
                <TextBlock Text="Open automatically" Style="{StaticResource BodyStrongTextStyle}" />
                <ComboBox x:Name="GitConsoleAutoOpenComboBox"
                          ItemsSource="{Binding GitConsoleAutoOpenModes}"
                          SelectedItem="{Binding SelectedGitConsoleAutoOpenMode, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="220"
                          HorizontalAlignment="Left"
                          SelectionChanged="GitConsoleAutoOpenComboBox_SelectionChanged" />
                <TextBlock Text="Only user Git commands can open it automatically; the latest 100 Git commands are retained per session."
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <TextBlock Text="Git command feedback"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <ToggleSwitch x:Name="ShowGitCommandProgressDialogToggle"
                              Header="Show Git command progress dialog"
                              IsOn="{Binding ShowGitCommandProgressDialog, Mode=TwoWay}"
                              Toggled="ShowGitCommandProgressDialogToggle_Toggled" />
                <StackPanel Margin="16,0,0,0" Spacing="{StaticResource Spacing.M}">
                  <ToggleSwitch x:Name="AutoCloseSuccessfulGitCommandFeedbackToggle"
                                Header="Automatically close after successful completion"
                                IsEnabled="{Binding CanConfigureGitCommandFeedbackAutoClose}"
                                IsOn="{Binding AutoCloseSuccessfulGitCommandFeedback, Mode=TwoWay}"
                                Toggled="AutoCloseSuccessfulGitCommandFeedbackToggle_Toggled" />
                  <NumberBox x:Name="SuccessfulGitCommandFeedbackDurationNumberBox"
                             Header="Display duration after success (seconds)"
                             Minimum="0"
                             Maximum="30"
                             SmallChange="1"
                             SpinButtonPlacementMode="Compact"
                             Width="240"
                             HorizontalAlignment="Left"
                             IsEnabled="{Binding CanConfigureGitCommandFeedbackDuration}"
                             Value="{Binding SuccessfulGitCommandFeedbackDurationSeconds}"
                             ValueChanged="SuccessfulGitCommandFeedbackDurationNumberBox_ValueChanged" />
                </StackPanel>
                <TextBlock Text="0 closes immediately. Interaction pauses the countdown; errors and cancellations stay visible."
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <TextBlock Text="File logging"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Margin="{StaticResource Margin.Section}" />
            <Border Style="{StaticResource FormCardStyle}" MaxWidth="680">
              <StackPanel Spacing="{StaticResource Spacing.M}">
                <ToggleSwitch x:Name="LoggingToggle"
                              Header="Enable file logging"
                              IsOn="{Binding LoggingEnabled}"
                              Toggled="LoggingToggle_Toggled" />
                <StackPanel Margin="16,0,0,0" Spacing="{StaticResource Spacing.S}"
                            IsEnabled="{Binding CanConfigureLogLevel}">
                  <TextBlock Text="Log level" Style="{StaticResource BodyStrongTextStyle}" />
                  <ComboBox x:Name="LogLevelComboBox"
                            ItemsSource="{Binding LogLevels}"
                            SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                            DisplayMemberPath="Label"
                            Style="{StaticResource CompactComboBoxStyle}"
                            MinWidth="220"
                            HorizontalAlignment="Left"
                            SelectionChanged="LogLevelComboBox_SelectionChanged" />
                </StackPanel>
                <TextBlock Text="Log file" Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock x:Name="LogFilePathText"
                           Style="{StaticResource TechnicalTextStyle}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           MaxWidth="620"
                           HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.M}">
                  <Button Content="Copy path"
                          Click="CopyLogPath_Click"
                          Style="{StaticResource CompactButtonStyle}"
                          AutomationProperties.Name="Copy log file path" />
                  <Button Content="Open folder"
                          Click="OpenLogFolder_Click"
                          Style="{StaticResource CompactButtonStyle}"
                          AutomationProperties.Name="Open log folder" />
                </StackPanel>
              </StackPanel>
            </Border>

            <InfoBar Severity="Warning"
                     IsClosable="False"
                     IsOpen="{Binding IsNonProductionHistoryRenderingMode}"
                     Title="History uses a diagnostic rendering mode"
                     Message="{Binding HistoryRenderingModeNotice}"
                     MaxWidth="680"
                     HorizontalAlignment="Stretch">
              <InfoBar.ActionButton>
                <Button Content="Restore Full production"
                        Click="RestoreFullHistoryRenderingMode_Click" />
              </InfoBar.ActionButton>
            </InfoBar>

            <Expander Header="Advanced diagnostics"
                      IsExpanded="False"
                      HorizontalAlignment="Stretch"
                      MaxWidth="680">
              <StackPanel Padding="{StaticResource Padding.Form}" Spacing="{StaticResource Spacing.M}">
                <TextBlock Text="History performance capture"
                           Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="Capture is independent of normal file logging; excludes repository paths, messages, author identities, refs and Git arguments."
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <ToggleSwitch x:Name="HistoryPerformanceDiagnosticsToggle"
                              Header="Enable history performance diagnostics"
                              IsOn="{Binding HistoryPerformanceDiagnosticsEnabled, Mode=TwoWay}"
                              Toggled="HistoryPerformanceDiagnosticsToggle_Toggled" />
                <TextBlock Text="Enabling exposes Start/Stop capture in History; capture starts only on request."
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="History row rendering mode" Style="{StaticResource BodyStrongTextStyle}" />
                <ComboBox x:Name="HistoryRenderingModeComboBox"
                          ItemsSource="{Binding HistoryRenderingModes}"
                          SelectedItem="{Binding SelectedHistoryRenderingMode, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="300"
                          HorizontalAlignment="Left"
                          SelectionChanged="HistoryRenderingModeComboBox_SelectionChanged" />
                <TextBlock Text="{Binding SelectedHistoryRenderingMode.Description}"
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Text="Modes 1–5 affect the actual History row, including outside captures."
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>

        <InfoBar x:Name="SettingsMessage"
                 Grid.Row="1"
                 Margin="16,0,16,16"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="True" />
      </Grid>
    </Grid>
  </Grid>
</Page>
