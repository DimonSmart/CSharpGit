<Page x:Class="CSharpGit.Presentation.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CSharpGit.Presentation.Controls">
  <Grid x:Name="RootLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20" RequestedTheme="{Binding SelectedTheme, Mode=TwoWay}">
    <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Visibility="{Binding PickerVisibility}">
      <FontIcon Glyph="&#xE8B7;" FontSize="56" HorizontalAlignment="Center" />
      <TextBlock Text="Open a Git repository" Style="{StaticResource TitleTextBlockStyle}" TextAlignment="Center" />
      <TextBlock Text="Select the folder of an existing repository or worktree." TextWrapping="Wrap" TextAlignment="Center" Opacity="0.72" />
      <Button Content="Select folder…" Command="{Binding OpenRepositoryCommand}" HorizontalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Visibility="{Binding BusyVisibility}">
        <ProgressRing IsActive="{Binding IsBusy}" Width="20" Height="20" />
        <TextBlock Text="Opening repository…" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
    <Grid x:Name="RepositoryWorkspace" Visibility="{Binding RepositoryVisibility}" RowDefinitions="Auto,470,*" ColumnDefinitions="3*,6,2*">
      <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
        <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Scopes}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedScope, Mode=TwoWay}" Header="Scope" Width="180" />
        <TextBox Text="{Binding FilterText, Mode=TwoWay}" PlaceholderText="Commit message" Header="Filter" Width="260" />
        <Button Content="Apply" Command="{Binding RefreshHistoryCommand}" VerticalAlignment="Bottom" />
        <Button Content="Refresh all" Command="{Binding RefreshAllCommand}" VerticalAlignment="Bottom" />
        <ComboBox Header="Theme" ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedThemeName, Mode=TwoWay}" Width="120" />
        <ProgressRing x:Name="BusyIndicator" IsActive="{Binding IsBusy}" Width="24" />
        <TextBlock Text="Git operation in progress…" Visibility="{Binding BusyVisibility}" VerticalAlignment="Center" Opacity="0.75" />
      </StackPanel>
      <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="3*,6,2*" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Working tree and index" Style="{StaticResource SubtitleTextBlockStyle}" />
          <ListView ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange, Mode=TwoWay}" MaxHeight="185">
            <ListView.ItemTemplate><DataTemplate>
              <Grid ColumnDefinitions="*,240" Padding="4"><TextBlock Text="{Binding Path}" /><TextBlock Grid.Column="1" Text="{Binding StatusDisplay}" /></Grid>
            </DataTemplate></ListView.ItemTemplate>
          </ListView>
        </StackPanel>
        <controls:GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <StackPanel Grid.Column="2" Spacing="6" Margin="16,0,0,0">
          <TextBlock Text="{Binding HeadDisplay}" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Stage file" Command="{Binding StageCommand}" /><Button Content="Unstage file" Command="{Binding UnstageCommand}" /><Button Content="Discard file…" Command="{Binding RequestDiscardCommand}" /></StackPanel>
          <TextBox x:Name="CommitMessageEditor" Header="Commit message" Text="{Binding CommitMessage, Mode=TwoWay}" />
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Commit index" Command="{Binding CommitCommand}" /><Button Content="Intentional empty commit" Command="{Binding EmptyCommitCommand}" /><Button Content="Amend" Command="{Binding AmendCommand}" /></StackPanel>
          <InfoBar IsOpen="True" Severity="Warning" Title="The index is empty" Message="Choose whether to stage all working-tree changes, create an intentional empty commit, or cancel. Nothing has been staged yet." Visibility="{Binding EmptyIndexChoiceVisibility}" IsClosable="False">
            <InfoBar.ActionButton><Button Content="Stage all and commit" Command="{Binding StageAllAndCommitCommand}" /></InfoBar.ActionButton>
          </InfoBar>
          <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding EmptyIndexChoiceVisibility}"><Button Content="Create empty commit" Command="{Binding ConfirmEmptyCommitCommand}" /><Button Content="Cancel" Command="{Binding CancelCommitCommand}" /></StackPanel>
          <InfoBar IsOpen="True" Severity="Warning" Title="Confirm discarding all changes to the file" Message="This action irreversibly replaces the selected file with its HEAD version (or deletes an untracked file)." Visibility="{Binding DiscardConfirmationVisibility}" IsClosable="False">
            <InfoBar.ActionButton><Button Content="Confirm discard" Command="{Binding ConfirmDiscardCommand}" /></InfoBar.ActionButton>
          </InfoBar>
          <Button Content="Cancel" Command="{Binding CancelDiscardCommand}" Visibility="{Binding DiscardConfirmationVisibility}" HorizontalAlignment="Left" />
        </StackPanel>
        <Grid Grid.ColumnSpan="3" Margin="0,205,0,0" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Local branches" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding LocalBranches}" SelectedItem="{Binding SelectedLocalBranch, Mode=TwoWay}" DisplayMemberPath="Name" />
            <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="Switch" Command="{Binding SwitchBranchCommand}" /><Button Content="Delete (-d)" Command="{Binding DeleteBranchCommand}" /></StackPanel>
            <TextBox Header="New local branch" Text="{Binding NewBranchName, Mode=TwoWay}" />
            <Button Content="Create and switch" Command="{Binding CreateBranchCommand}" HorizontalAlignment="Left" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="Remote branches and tags" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding RemoteBranches}" SelectedItem="{Binding SelectedRemoteBranch, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Remote branch" />
            <Button Content="Check out to a new tracking branch" Command="{Binding CheckoutRemoteCommand}" HorizontalAlignment="Left" />
            <ComboBox ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Tag" />
            <Button Content="Checkout tag (detached)" Command="{Binding CheckoutTagCommand}" HorizontalAlignment="Left" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="Remotes" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Remotes}" SelectedItem="{Binding SelectedRemote, Mode=TwoWay}" DisplayMemberPath="Name" />
            <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="Fetch" Command="{Binding FetchCommand}" /><Button Content="Fetch All" Command="{Binding FetchAllCommand}" /><Button Content="Pull" Command="{Binding PullCommand}" /></StackPanel>
            <TextBox Header="Remote branch for explicit push" Text="{Binding PushBranchName, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Push" Command="{Binding PushCommand}" /><CheckBox Content="Set upstream" IsChecked="{Binding SetUpstream, Mode=TwoWay}" /></StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="4">
            <TextBlock Text="Stash and merge" FontWeight="SemiBold" />
            <TextBox Header="Stash message" Text="{Binding StashMessage, Mode=TwoWay}" />
            <Button Content="Create stash" Command="{Binding CreateStashCommand}" HorizontalAlignment="Left" />
            <ComboBox ItemsSource="{Binding Stashes}" SelectedItem="{Binding SelectedStash, Mode=TwoWay}" DisplayMemberPath="Display" PlaceholderText="stash entry" />
            <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="Apply" Command="{Binding ApplyStashCommand}" /><Button Content="Pop" Command="{Binding PopStashCommand}" /></StackPanel>
            <ComboBox ItemsSource="{Binding LocalBranches}" SelectedItem="{Binding SelectedMergeBranch, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Branch to merge" />
            <Button Content="Merge into current branch" Command="{Binding MergeCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding OperationDisplay}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="Interactive rebase" FontWeight="SemiBold" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="6"><TextBox Width="125" PlaceholderText="onto (HEAD~3)" Text="{Binding RebaseOnto, Mode=TwoWay}" /><Button Content="Build plan" Command="{Binding LoadRebasePlanCommand}" /></StackPanel>
            <ListView ItemsSource="{Binding RebasePlan}" SelectedItem="{Binding SelectedRebaseItem, Mode=TwoWay}" DisplayMemberPath="Display" Height="90" />
            <StackPanel Orientation="Horizontal" Spacing="4"><Button Content="↑" Command="{Binding MoveRebaseUpCommand}" /><Button Content="↓" Command="{Binding MoveRebaseDownCommand}" /><ComboBox Width="100" ItemsSource="{Binding RebaseActions}" SelectedItem="{Binding RebaseAction, Mode=TwoWay}" /><Button Content="Apply" Command="{Binding ApplyRebaseItemCommand}" /></StackPanel>
            <TextBox Header="New message for reword" Text="{Binding RebaseMessage, Mode=TwoWay}" />
            <Button Content="Start rebase" Command="{Binding StartRebaseCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Grid>
      </Grid>
      <controls:GridSplitter Grid.Row="1" Grid.ColumnSpan="3" ResizeDirection="Rows" ResizeBehavior="CurrentAndNext" VerticalAlignment="Bottom" Height="6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
      <Border Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="10" Visibility="{Binding OperationVisibility}" CornerRadius="6" Margin="0,0,0,8" MaxHeight="300">
        <StackPanel Spacing="6">
          <TextBlock Text="Conflicts and Git operation in progress" FontWeight="SemiBold" />
          <TextBlock Text="{Binding OperationDisplay}" />
          <TextBlock Text="{Binding ConfiguredMergeToolDisplay}" FontSize="12" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ComboBox Width="120" Header="Preset/name" ItemsSource="{Binding MergeToolNames}" IsEditable="True" Text="{Binding MergeToolName, Mode=TwoWay}" />
            <ComboBox Width="150" Header="Type" ItemsSource="{Binding MergeToolKinds}" SelectedItem="{Binding MergeToolKind, Mode=TwoWay}" />
            <ComboBox Width="150" Header="Git config" ItemsSource="{Binding MergeToolScopes}" SelectedItem="{Binding MergeToolScope, Mode=TwoWay}" />
            <TextBox Width="200" Header="Executable/path or command" Text="{Binding MergeToolExecutable, Mode=TwoWay}" />
            <TextBox Width="260" Header="Arguments: $BASE $LOCAL $REMOTE $MERGED" Text="{Binding MergeToolArguments, Mode=TwoWay}" />
            <Button Content="Save configuration" Command="{Binding ConfigureMergeToolCommand}" VerticalAlignment="Bottom" />
          </StackPanel>
          <ListView ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict, Mode=TwoWay}" DisplayMemberPath="Display" MaxHeight="100" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Open manually" Command="{Binding OpenConflictCommand}" />
            <Button Content="{Binding CurrentSideLabel}" Command="{Binding ChooseCurrentCommand}" />
            <Button Content="{Binding IncomingSideLabel}" Command="{Binding ChooseIncomingCommand}" />
            <Button Content="Keep deletion" Command="{Binding KeepDeletionCommand}" />
            <Button Content="Stage resolved" Command="{Binding StageConflictCommand}" />
            <Button Content="Merge tool for file" Command="{Binding MergeToolCommand}" />
            <Button Content="Merge tool: all conflicts" Command="{Binding MergeToolWorkflowCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Continue" Command="{Binding ContinueOperationCommand}" />
            <Button Content="Abort" Command="{Binding AbortOperationCommand}" />
            <Button Content="Skip" Command="{Binding SkipOperationCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Grid Grid.Row="2" RowDefinitions="*,Auto" Margin="0,0,8,0">
        <ListView x:Name="HistoryList" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistoryRow, Mode=TwoWay}">
          <ListView.ItemTemplate><DataTemplate>
            <Grid ColumnDefinitions="70,*,130,145,95" Padding="4">
              <TextBlock Text="{Binding Topology.Display}" FontFamily="Consolas" />
              <StackPanel Grid.Column="1"><TextBlock Text="{Binding Commit.Subject}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Commit.ReferencesDisplay}" FontSize="11" Opacity="0.65" /></StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding Commit.Author}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding Commit.AuthoredAt}" />
              <TextBlock Grid.Column="4" Text="{Binding Commit.ShortHash}" FontFamily="Consolas" />
            </Grid>
          </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <Button Grid.Row="1" Content="Load more" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Center" Margin="0,8" />
      </Grid>
      <controls:GridSplitter Grid.Row="2" Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
      <ScrollViewer x:Name="DetailsScroller" Grid.Row="2" Grid.Column="2" Visibility="{Binding DetailsVisibility}" Margin="8,0,0,0" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">
          <TextBlock Text="Commit details" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="{Binding SelectedCommit.Commit.Message}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedCommit.Commit.Author}" />
          <TextBlock Text="{Binding SelectedCommit.Commit.AuthoredAt}" />
          <TextBlock Text="{Binding SelectedCommit.Commit.Hash}" FontFamily="Consolas" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedCommit.Commit.ParentsDisplay}" FontFamily="Consolas" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedCommit.Commit.ReferencesDisplay}" TextWrapping="Wrap" />
          <TextBlock Text="Changed files" FontWeight="SemiBold" Margin="0,8,0,0" />
          <ListView ItemsSource="{Binding SelectedCommit.Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" MaxHeight="180">
            <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}" /></DataTemplate></ListView.ItemTemplate>
          </ListView>
          <InfoBar IsOpen="True" Severity="Informational" Title="Binary data" Message="A text diff is not available for a binary file." Visibility="{Binding BinaryVisibility}" IsClosable="False" />
          <ListView ItemsSource="{Binding SelectedDiff.Lines}" Visibility="{Binding DiffVisibility}" FontFamily="Consolas">
            <ListView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="80,*"><TextBlock Text="{Binding Kind}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Text}" /></Grid></DataTemplate></ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <InfoBar IsOpen="{Binding HasError}" Severity="Error" Title="Error" Message="{Binding ErrorMessage}" IsClosable="False" VerticalAlignment="Bottom" />
  </Grid>
</Page>
