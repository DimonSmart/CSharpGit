<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CSharpGit.Presentation.Controls">

  <!--
    Keep the stock TreeViewItem template so its indentation, expander slot,
    row metrics, hover/selection states, and platform behavior stay intact.

    Uno rewrites GlyphOpacity at runtime for nodes with children, so opacity
    cannot reliably hide the built-in chevrons. Empty glyphs hide only the
    arrows while preserving the stock expander slot used by the layout.
  -->
  <Style x:Key="DenseTreeItemStyle" TargetType="TreeViewItem">
    <Setter Property="MinHeight" Value="{StaticResource Height.DataRow}" />
    <Setter Property="Padding" Value="1,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="CollapsedGlyph" Value="" />
    <Setter Property="ExpandedGlyph" Value="" />
  </Style>

  <Style x:Key="RepositoryTreeItemStyle"
         TargetType="TreeViewItem"
         BasedOn="{StaticResource DenseTreeItemStyle}" />

  <!-- Repository tree styles and templates are canonically owned by this dictionary. -->
  <DataTemplate x:Key="RepositoryTreeItemTemplate">
    <TreeViewItem x:Name="RepositoryTreeItem"
                  ItemsSource="{Binding Children}"
                  IsExpanded="{Binding IsExpanded, Mode=OneWay}"
                  Style="{StaticResource RepositoryTreeItemStyle}"
                  ToolTipService.ToolTip="{Binding ToolTipText}"
                  controls:WorktreeContextMenuBehavior.IsEnabled="True">
      <TreeViewItem.Content>
        <Grid ColumnDefinitions="2,*" MinHeight="{StaticResource Height.DataRow}">
          <Border Grid.ColumnSpan="2"
                  Background="{ThemeResource AccentFillColorDefaultBrush}"
                  Opacity="0.12"
                  Visibility="{Binding CurrentBranchAccentVisibility}"
                  IsHitTestVisible="False" />
          <controls:RepositoryTreeGuides Grid.Column="1"
                                         Segments="{Binding HierarchyGuideSegments}"
                                         TotalIndentation="{Binding TemplateSettings.Indentation.Left, ElementName=RepositoryTreeItem}"
                                         RowHeight="{StaticResource Height.DataRow}"
                                         ExpandTarget="{Binding ElementName=RepositoryTreeItem}"
                                         IsExpanded="{Binding IsExpanded, ElementName=RepositoryTreeItem}"
                                         HasChildren="{Binding HasChildren}"
                                         LineBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                         NodeFillBrush="{ThemeResource ControlFillColorDefaultBrush}"
                                         GlyphBrush="{ThemeResource TextFillColorPrimaryBrush}" />
          <Grid Grid.Column="1"
                ColumnDefinitions="Auto,Auto,*"
                VerticalAlignment="Center">
            <Grid Grid.Column="0" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE80F;"
                        FontSize="{StaticResource Icon.Normal}"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding CurrentLocalBranchIconVisibility}" />
              <FontIcon Glyph="&#xE80F;"
                        FontSize="{StaticResource Icon.Normal}"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding LocalDefaultBranchIconVisibility}" />
              <FontIcon Glyph="&#xE80F;"
                        FontSize="{StaticResource Icon.Normal}"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding RemoteDefaultBranchIconVisibility}" />
              <FontIcon Glyph="{Binding IconGlyph}"
                        FontSize="{StaticResource Icon.Normal}"
                        Visibility="{Binding IconVisibility}" />
            </Grid>
            <Border Grid.Column="1"
                    Width="{StaticResource Spacing.S}"
                    Visibility="{Binding LeadingIconVisibility}"
                    IsHitTestVisible="False" />
            <Grid Grid.Column="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
              <controls:MiddleEllipsisTextBlock Grid.Column="0"
                                                Text="{Binding DisplayName}"
                                                UseMiddleEllipsis="{Binding UseMiddleEllipsis}"
                                                TextStyle="{StaticResource BodyTextStyle}"
                                                TextFontWeight="{Binding NameFontWeight}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center" />
              <Border Grid.Column="1"
                      Width="{StaticResource Spacing.S}"
                      Visibility="{Binding PrimaryWorktreeBadgeVisibility}"
                      IsHitTestVisible="False" />
              <Border Grid.Column="2"
                      Padding="{StaticResource Padding.DenseRow}"
                      CornerRadius="2"
                      Background="{ThemeResource ControlFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      Visibility="{Binding PrimaryWorktreeBadgeVisibility}"
                      IsHitTestVisible="False"
                      VerticalAlignment="Center">
                <TextBlock Text="PRIMARY"
                           Style="{StaticResource SecondaryTextStyle}"
                           VerticalAlignment="Center" />
              </Border>
              <Border Grid.Column="3"
                      Width="{StaticResource Spacing.S}"
                      Visibility="{Binding WorktreeStateVisibility}"
                      IsHitTestVisible="False" />
              <TextBlock Grid.Column="4"
                         Text="{Binding WorktreeStateText}"
                         Style="{StaticResource SecondaryTextStyle}"
                         Visibility="{Binding WorktreeStateVisibility}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </Grid>
      </TreeViewItem.Content>
    </TreeViewItem>
  </DataTemplate>

  <DataTemplate x:Key="RepositoryFilesTreeItemTemplate">
    <TreeViewItem x:Name="RepositoryFilesTreeItem"
                  ItemsSource="{Binding Children}"
                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                  Style="{StaticResource RepositoryTreeItemStyle}">
      <TreeViewItem.Content>
        <Grid ColumnDefinitions="2,*" MinHeight="{StaticResource Height.DataRow}">
          <controls:RepositoryTreeGuides Grid.Column="1"
                                         Segments="{Binding HierarchyGuideSegments}"
                                         TotalIndentation="{Binding TemplateSettings.Indentation.Left, ElementName=RepositoryFilesTreeItem}"
                                         RowHeight="{StaticResource Height.DataRow}"
                                         ExpandTarget="{Binding ElementName=RepositoryFilesTreeItem}"
                                         IsExpanded="{Binding IsExpanded, ElementName=RepositoryFilesTreeItem}"
                                         HasChildren="{Binding HasChildren}"
                                         LineBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                         NodeFillBrush="{ThemeResource ControlFillColorDefaultBrush}"
                                         GlyphBrush="{ThemeResource TextFillColorPrimaryBrush}" />
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="{StaticResource Spacing.S}"
                      VerticalAlignment="Center">
            <FontIcon Glyph="{Binding IconGlyph}"
                      FontSize="{StaticResource Icon.Normal}" />
            <TextBlock Text="{Binding DisplayLabel}"
                       Style="{StaticResource BodyTextStyle}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </TreeViewItem.Content>
    </TreeViewItem>
  </DataTemplate>

  <DataTemplate x:Key="WorkingTreeTreeItemTemplate">
    <TreeViewItem x:Name="WorkingTreeTreeItem"
                  ItemsSource="{Binding Children}"
                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                  Style="{StaticResource RepositoryTreeItemStyle}"
                  ToolTipService.ToolTip="{Binding ToolTipText}">
      <TreeViewItem.Content>
        <Grid ColumnDefinitions="2,*" MinHeight="{StaticResource Height.DataRow}">
          <Border Grid.ColumnSpan="2"
                  Background="{ThemeResource AccentFillColorDefaultBrush}"
                  Opacity="0.14"
                  Visibility="{Binding IsBatchSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                  IsHitTestVisible="False" />
          <controls:RepositoryTreeGuides Grid.Column="1"
                                         Segments="{Binding HierarchyGuideSegments}"
                                         TotalIndentation="{Binding TemplateSettings.Indentation.Left, ElementName=WorkingTreeTreeItem}"
                                         RowHeight="{StaticResource Height.DataRow}"
                                         ExpandTarget="{Binding ElementName=WorkingTreeTreeItem}"
                                         IsExpanded="{Binding IsExpanded, ElementName=WorkingTreeTreeItem}"
                                         HasChildren="{Binding HasChildren}"
                                         LineBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                         NodeFillBrush="{ThemeResource ControlFillColorDefaultBrush}"
                                         GlyphBrush="{ThemeResource TextFillColorPrimaryBrush}" />
          <Grid Grid.Column="1"
                ColumnDefinitions="24,*"
                Padding="2,0"
                VerticalAlignment="Center">
            <TextBlock Text="{Binding Status}"
                       Style="{StaticResource DiffSecondaryTextStyle}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding DisplayName}"
                       Style="{StaticResource BodyTextStyle}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </TreeViewItem.Content>
    </TreeViewItem>
  </DataTemplate>

</ResourceDictionary>