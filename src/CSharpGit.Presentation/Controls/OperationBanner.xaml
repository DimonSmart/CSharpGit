<UserControl x:Class="CSharpGit.Presentation.Controls.OperationBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
          BorderThickness="0,0,0,1"
          Padding="{StaticResource Padding.Workspace}">
    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.L}">
        <FontIcon Glyph="&#xE7BA;" FontSize="{StaticResource Icon.Normal}" />
        <TextBlock Text="{Binding OperationDisplay}"
                   Style="{StaticResource BodyStrongTextStyle}"
                   VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Spacing.M}"
                  Visibility="{Binding HasActiveOperation, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Button Content="Continue" Command="{Binding ContinueOperationCommand}" Style="{StaticResource PrimaryActionButtonStyle}" />
        <Button Content="Abort" Command="{Binding AbortOperationCommand}" Style="{StaticResource DestructiveActionButtonStyle}" />
        <Button Content="Skip" Command="{Binding SkipOperationCommand}" Style="{StaticResource SecondaryActionButtonStyle}" />
      </StackPanel>
      <Grid Grid.Row="1"
            Grid.ColumnSpan="2"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="{StaticResource Spacing.XL}"
            Margin="{StaticResource Margin.Section}">
        <ListView ItemsSource="{Binding Conflicts}"
                  SelectedItem="{Binding SelectedConflict, Mode=TwoWay}"
                  DisplayMemberPath="Display"
                  MaxHeight="90"
                  ItemContainerStyle="{StaticResource DenseListItemStyle}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal"
                    Spacing="{StaticResource Spacing.M}" VerticalAlignment="Center">
          <Button Content="Open in merge tool" Command="{Binding MergeToolCommand}" Style="{StaticResource PrimaryActionButtonStyle}" />
          <Button Content="Stage resolution" Command="{Binding StageConflictCommand}" Style="{StaticResource CompactButtonStyle}" />
          <Button Content="More…" Style="{StaticResource CompactButtonStyle}">
            <Button.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="Open in editor" Command="{Binding OpenConflictCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="{Binding CurrentSideLabel}" Command="{Binding ChooseCurrentCommand}" />
                <MenuFlyoutItem Text="{Binding IncomingSideLabel}" Command="{Binding ChooseIncomingCommand}" />
                <MenuFlyoutItem Text="Keep deletion" Command="{Binding KeepDeletionCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Resolve all conflicts using merge tool" Command="{Binding MergeToolWorkflowCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
