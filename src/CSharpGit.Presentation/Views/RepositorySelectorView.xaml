<UserControl x:Class="CSharpGit.Presentation.Views.RepositorySelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CSharpGit.Presentation.Controls">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <DropDownButton x:Name="RepositorySelectorButton"
                          Style="{StaticResource ToolbarButtonStyle}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding CanChangeRepository}"
                          AutomationProperties.Name="Current repository"
                          AutomationProperties.HelpText="{Binding Repository.WorkingDirectory}">
            <TextBlock x:Name="RepositorySelectorName"
                       Style="{StaticResource BodyStrongTextStyle}"
                       HorizontalAlignment="Stretch"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
            <DropDownButton.Flyout>
              <Flyout x:Name="RepositorySelectorFlyout"
                      Opening="RepositorySelectorFlyout_Opening"
                      Placement="BottomEdgeAlignedLeft">
                <Flyout.FlyoutPresenterStyle>
                  <Style TargetType="FlyoutPresenter">
                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                  </Style>
                </Flyout.FlyoutPresenterStyle>
                <StackPanel MaxWidth="520" Spacing="0">
                  <ListView x:Name="RepositorySelectorList"
                            ItemContainerStyle="{StaticResource DenseListItemStyle}"
                            MaxHeight="320"
                            IsItemClickEnabled="True"
                            ItemClick="RepositorySelectorList_ItemClick"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="20,*,160"
                              MinHeight="{StaticResource Height.DataRow}"
                              HorizontalAlignment="Stretch"
                              ToolTipService.ToolTip="{Binding ToolTip}"
                              AutomationProperties.Name="{Binding AccessibleName}">
                          <FontIcon Grid.Column="0"
                                    Glyph="{Binding CurrentGlyph}"
                                    Visibility="{Binding RepositoryVisibility}"
                                    FontSize="{StaticResource Icon.Small}"
                                    VerticalAlignment="Center" />
                          <controls:MiddleEllipsisTextBlock Grid.Column="1"
                                                            HorizontalAlignment="Stretch"
                                                            Visibility="{Binding RepositoryVisibility}"
                                                            Text="{Binding DisplayPath}"
                                                            UseMiddleEllipsis="True"
                                                            TextStyle="{StaticResource BodyTextStyle}" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Branch}"
                                     Visibility="{Binding RepositoryVisibility}"
                                     Margin="16,0,4,0"
                                     Style="{StaticResource CaptionTextStyle}"
                                     TextAlignment="Right"
                                     TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <Grid Grid.ColumnSpan="3"
                                ColumnDefinitions="*,Auto,*"
                                Margin="4,0"
                                Visibility="{Binding HeaderVisibility}"
                                VerticalAlignment="Center">
                            <Border Grid.Column="0"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayPath}"
                                       MaxWidth="390"
                                       Margin="10,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>

                  <Border Height="1"
                          Margin="{StaticResource Margin.MenuSeparator}"
                          Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                  <Button x:Name="RepositorySelectorOpenFolderButton"
                          Style="{StaticResource RepositorySelectorActionButtonStyle}"
                          Click="RepositorySelectorOpenFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                      <FontIcon Glyph="{StaticResource Icon.Glyph.Reveal}" FontSize="{StaticResource Icon.Small}" />
                      <TextBlock x:Name="RepositorySelectorOpenFolderText" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="RepositorySelectorOpenTerminalButton"
                          Click="RepositorySelectorOpenTerminal_Click"
                          Style="{StaticResource RepositorySelectorActionButtonStyle}"
                          AutomationProperties.Name="Open Terminal Here">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                      <FontIcon Glyph="&#xE756;" FontSize="{StaticResource Icon.Small}" />
                      <TextBlock Text="Open Terminal Here" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="RepositorySelectorCopyPathButton" Click="RepositorySelectorCopyPath_Click" Style="{StaticResource RepositorySelectorActionButtonStyle}" AutomationProperties.Name="Copy repository path">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                        <FontIcon Glyph="{StaticResource Icon.Glyph.Copy}" FontSize="{StaticResource Icon.Small}" />
                        <TextBlock Text="Copy repository path" Style="{StaticResource BodyTextStyle}" />
                      </StackPanel>
                    </Button>

                  <Border Height="1"
                          Margin="{StaticResource Margin.MenuSeparator}"
                          Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                  <Button x:Name="RepositorySelectorOpenButton" Click="RepositorySelectorOpenRepository_Click" Style="{StaticResource RepositorySelectorActionButtonStyle}" AutomationProperties.Name="Open repository…">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                        <FontIcon Glyph="{StaticResource Icon.Glyph.Open}" FontSize="{StaticResource Icon.Small}" />
                        <TextBlock Text="Open repository…" Style="{StaticResource BodyTextStyle}" />
                      </StackPanel>
                    </Button>
                  <Button x:Name="RepositorySelectorCloneButton" Click="RepositorySelectorCloneRepository_Click" Style="{StaticResource RepositorySelectorActionButtonStyle}" AutomationProperties.Name="Clone repository…">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                        <FontIcon Glyph="{StaticResource Icon.Glyph.Clone}" FontSize="{StaticResource Icon.Small}" />
                        <TextBlock Text="Clone repository…" Style="{StaticResource BodyTextStyle}" />
                      </StackPanel>
                    </Button>
                  <Button x:Name="RepositorySelectorCreateButton" Click="RepositorySelectorCreateRepository_Click" Style="{StaticResource RepositorySelectorActionButtonStyle}" AutomationProperties.Name="Create repository…">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                        <FontIcon Glyph="{StaticResource Icon.Glyph.Create}" FontSize="{StaticResource Icon.Small}" />
                        <TextBlock Text="Create repository…" Style="{StaticResource BodyTextStyle}" />
                      </StackPanel>
                    </Button>
                  <Button x:Name="RepositorySelectorRepositoriesButton"
                          Content="Repositories…"
                          Style="{StaticResource RepositorySelectorActionButtonStyle}"
                          Click="RepositorySelectorRepositories_Click" />

                  <Border Height="1"
                          Margin="{StaticResource Margin.MenuSeparator}"
                          Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                  <Button x:Name="RepositorySelectorCloseButton"
                          Content="Close repository"
                          Style="{StaticResource RepositorySelectorActionButtonStyle}"
                          Click="RepositorySelectorCloseRepository_Click" />
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
</UserControl>
