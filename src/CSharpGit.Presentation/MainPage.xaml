<Page x:Class="CSharpGit.Presentation.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CSharpGit.Presentation.Controls" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives" Loaded="MainPage_Loaded">
  <Page.Resources>
    <controls:BranchTrackingActionTextConverter x:Key="BranchTrackingActionTextConverter" />
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <ContentDialog x:Key="InteractiveRebaseDialog"
                   Title="Interactive rebase"
                   PrimaryButtonText="Start rebase"
                   CloseButtonText="Cancel"
                   DefaultButton="Primary"
                   MaxWidth="1200">
      <Grid RowDefinitions="Auto,*"
            RowSpacing="{StaticResource Spacing.L}"
            MaxWidth="1200"
            HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
            <TextBlock Text="onto:" Style="{StaticResource BodySubduedTextStyle}" />
            <TextBlock Text="{Binding InteractiveRebase.RebaseOnto}" Style="{StaticResource BodyStrongTextStyle}" IsTextSelectionEnabled="True" />
          </StackPanel>
          <Button x:Name="ChangeInteractiveRebaseAuthorButton"
                  Grid.Column="1"
                  Content="Change author…"
                  Click="ChangeInteractiveRebaseAuthor_Click"
                  Style="{StaticResource CompactButtonStyle}" />
        </Grid>
        <controls:InteractiveRebaseTodoEditor x:Name="InteractiveRebaseTodoEditor"
                                              Grid.Row="1"
                                              Text="{Binding InteractiveRebase.RebaseTodoText, Mode=TwoWay}"
                                              MinHeight="350"
                                              MaxHeight="650"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
      </Grid>
    </ContentDialog>
  </Page.Resources>

  <Grid x:Name="RootLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyDown="Page_KeyDown">
    <Grid x:Name="StartScreenHost"
          Visibility="{Binding HasRepository, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
      <StackPanel x:Name="EmptyStartScreen"
                  Width="520"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="{StaticResource Spacing.XXL}">
        <FontIcon Glyph="&#xE8B7;" FontSize="56" HorizontalAlignment="Center" />
        <TextBlock Text="Open a Git repository" Style="{StaticResource TitleTextStyle}" TextAlignment="Center" />
        <TextBlock Text="Select the folder of an existing repository or worktree."
                   Style="{StaticResource BodySubduedTextStyle}"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="{StaticResource Spacing.M}">
          <Button Content="Select folder…"
                  Click="OpenRepository_Click"
                  Style="{StaticResource CompactButtonStyle}" />
          <Button Content="Clone repository…"
                  Click="CloneRepository_Click"
                  Style="{StaticResource CompactButtonStyle}" />
          <Button Content="Create repository…"
                  Click="CreateRepository_Click"
                  Style="{StaticResource CompactButtonStyle}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="{StaticResource Spacing.L}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ProgressRing IsActive="{Binding IsBusy}" Width="20" Height="20" />
          <TextBlock Text="Opening repository…" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <ContentControl x:Name="RecentRepositoriesHost"
                      Visibility="Collapsed"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />

      <Button x:Name="StartScreenOverflowButton"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="12"
              Style="{StaticResource IconButtonStyle}"
              AutomationProperties.Name="Application menu">
        <FontIcon Glyph="&#xE712;" FontSize="{StaticResource Icon.Normal}" />
        <Button.Flyout>
          <MenuFlyout>
            <MenuFlyoutItem Text="Settings…" Click="Settings_Click" />
            <MenuFlyoutItem Text="About CSharpGit…" Click="About_Click" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <Grid x:Name="RepositoryWorkspace" Visibility="{Binding HasRepository, Converter={StaticResource BooleanToVisibilityConverter}}" RowDefinitions="Auto,Auto,*,Auto">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" MinWidth="180" MaxWidth="430" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="520" />
      </Grid.ColumnDefinitions>

      <Border x:Name="RepositoryHeader"
              Grid.Row="0"
              Grid.Column="0"
              Style="{StaticResource PaneHeaderSurfaceStyle}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderThickness="0,0,1,1">
        <StackPanel HorizontalAlignment="Stretch" Spacing="{StaticResource Spacing.XS}">
          <TextBlock Text="Repository"
                     Style="{StaticResource PaneHeaderTextStyle}"
                     VerticalAlignment="Center" />
          <DropDownButton x:Name="RepositorySelectorButton"
                          Style="{StaticResource ToolbarButtonStyle}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding CanChangeRepository}"
                          AutomationProperties.Name="Current repository"
                          AutomationProperties.HelpText="{Binding Repository.WorkingDirectory}">
            <TextBlock x:Name="RepositorySelectorName"
                       Style="{StaticResource BodyStrongTextStyle}"
                       HorizontalAlignment="Stretch"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
            <DropDownButton.Flyout>
              <Flyout x:Name="RepositorySelectorFlyout"
                      Opening="RepositorySelectorFlyout_Opening"
                      Placement="BottomEdgeAlignedLeft">
                <StackPanel Width="520" Spacing="2">
                  <ListView x:Name="RepositorySelectorList"
                            MaxHeight="320"
                            IsItemClickEnabled="True"
                            ItemClick="RepositorySelectorList_ItemClick"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                      <Style TargetType="ListViewItem"
                             BasedOn="{StaticResource FormNavigationItemStyle}">
                        <Setter Property="MinHeight" Value="{StaticResource Height.Control}" />
                        <Setter Property="Padding" Value="8,2" />
                      </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="20,*,Auto"
                              MinHeight="{StaticResource Height.Control}"
                              ToolTipService.ToolTip="{Binding ToolTip}"
                              AutomationProperties.Name="{Binding AccessibleName}">
                          <FontIcon Grid.Column="0"
                                    Glyph="{Binding CurrentGlyph}"
                                    FontSize="{StaticResource Icon.Small}"
                                    VerticalAlignment="Center" />
                          <controls:MiddleEllipsisTextBlock Grid.Column="1"
                                                            Text="{Binding Path}"
                                                            UseMiddleEllipsis="True"
                                                            TextStyle="{StaticResource BodyTextStyle}" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Branch}"
                                     Margin="16,0,4,0"
                                     MaxWidth="160"
                                     Style="{StaticResource CaptionTextStyle}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>

                  <Border Height="1"
                          Margin="0,4"
                          Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                  <Button x:Name="RepositorySelectorOpenFolderButton"
                          Style="{StaticResource RepositorySelectorActionButtonStyle}"
                          Click="RepositorySelectorOpenFolder_Click" />
                  <Button x:Name="RepositorySelectorCopyPathButton"
                          Content="Copy repository path"
                          Style="{StaticResource RepositorySelectorActionButtonStyle}"
                          Click="RepositorySelectorCopyPath_Click" />

                  <Border Height="1"
                          Margin="0,4"
                          Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                  <Button x:Name="RepositorySelectorOpenButton"
                          Content="Open repository…"
                          Style="{StaticResource RepositorySelectorActionButtonStyle}"
                          Click="RepositorySelectorOpenRepository_Click" />
                  <Button x:Name="RepositorySelectorCloneButton"
                          Content="Clone repository…"
                          Style="{StaticResource RepositorySelectorActionButtonStyle}"
                          Click="RepositorySelectorCloneRepository_Click" />
                  <Button x:Name="RepositorySelectorCreateButton"
                          Content="Create repository…"
                          Style="{StaticResource RepositorySelectorActionButtonStyle}"
                          Click="RepositorySelectorCreateRepository_Click" />
                  <Button x:Name="RepositorySelectorRepositoriesButton"
                          Content="Repositories…"
                          Style="{StaticResource RepositorySelectorActionButtonStyle}"
                          Click="RepositorySelectorRepositories_Click" />

                  <Border Height="1"
                          Margin="0,4"
                          Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                  <Button x:Name="RepositorySelectorCloseButton"
                          Content="Close repository"
                          Style="{StaticResource RepositorySelectorActionButtonStyle}"
                          Click="RepositorySelectorCloseRepository_Click" />
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </StackPanel>
      </Border>

      <Border Grid.Row="0"
              Grid.Column="1"
              Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

      <Border x:Name="MainToolbar"
              Grid.Row="0"
              Grid.Column="2"
              Style="{StaticResource ToolbarSurfaceStyle}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.M}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.XS}" VerticalAlignment="Center">
            <Button x:Name="CommitNavigationButton"
                    Click="CommitNavigation_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    AutomationProperties.Name="Commit changes">
              <TextBlock x:Name="CommitNavigationText" Text="Commit (0)" Style="{StaticResource BodyTextStyle}" />
            </Button>
            <Button Click="Fetch_Click" Style="{StaticResource ToolbarButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                <FontIcon Glyph="&#xE896;" FontSize="{StaticResource Icon.Small}" />
                <TextBlock Text="Fetch" Style="{StaticResource BodyTextStyle}" />
              </StackPanel>
            </Button>
            <Button Click="Pull_Click" Style="{StaticResource ToolbarButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                <FontIcon Glyph="&#xE896;" FontSize="{StaticResource Icon.Small}" />
                <TextBlock Text="{Binding Branches.SelectedLocalBranch, Converter={StaticResource BranchTrackingActionTextConverter}, ConverterParameter=Pull}"
                           Style="{StaticResource BodyTextStyle}" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                <FontIcon Glyph="&#xE898;" FontSize="{StaticResource Icon.Small}" />
                <TextBlock Text="{Binding Branches.SelectedLocalBranch, Converter={StaticResource BranchTrackingActionTextConverter}, ConverterParameter=Push}"
                           Style="{StaticResource BodyTextStyle}" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="{Binding Branches.SelectedLocalBranch, Converter={StaticResource BranchTrackingActionTextConverter}, ConverterParameter=PushMenu}" Click="Push_Click" />
                  <MenuFlyoutItem Text="Push to…" Click="PushTo_Click" IsEnabled="{Binding RepositorySync.CanPushTo}" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Force push with lease…" Click="ForcePushWithLease_Click" IsEnabled="{Binding RepositorySync.CanForcePushWithLease}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="RefreshButton"
                    Click="RefreshIndicator_Click"
                    Style="{StaticResource IconButtonStyle}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Refresh repository."
                    AutomationProperties.Name="Refresh repository">
              <Grid Width="16" Height="16">
                <FontIcon x:Name="RefreshIcon"
                          Glyph="&#xE72C;"
                          FontSize="{StaticResource Icon.Normal}"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <FontIcon x:Name="RefreshRequiredIcon"
                          Glyph="&#xE72C;"
                          FontSize="{StaticResource Icon.Normal}"
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed" />
                <ProgressRing x:Name="RefreshProgressRing"
                              IsActive="False"
                              Visibility="Collapsed"
                              Width="16"
                              Height="16" />
              </Grid>
            </Button>
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Application menu">
            <FontIcon Glyph="&#xE712;" FontSize="{StaticResource Icon.Normal}" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="Open repository…"
                                Click="OpenRepository_Click"
                                IsEnabled="{Binding CanChangeRepository}" />
                <MenuFlyoutItem Text="Clone repository…"
                                Click="CloneRepository_Click"
                                IsEnabled="{Binding CanChangeRepository}" />
                <MenuFlyoutItem Text="Create repository…" Click="CreateRepository_Click" />
                <MenuFlyoutItem Text="Repositories…"
                                Click="Repositories_Click"
                                IsEnabled="{Binding CanChangeRepository}" />
                <MenuFlyoutItem Text="Close repository"
                                Click="CloseRepository_Click"
                                IsEnabled="{Binding CanChangeRepository}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Repository settings…"
                                Click="RepositorySettings_Click" />
                <MenuFlyoutItem x:Name="OptimizeRepositoryMenuItem"
                                Text="Optimize repository…"
                                Click="OptimizeRepository_Click"
                                IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Settings…" Click="Settings_Click" />
                <MenuFlyoutItem Text="About CSharpGit…" Click="About_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>

        </Grid>
      </Border>
      <controls:OperationBanner Grid.Row="1"
                                Grid.ColumnSpan="3"
                                DataContext="{Binding RepositoryOperations}"
                                Visibility="{Binding HasActiveOperation, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <Border Grid.Row="2"
              Grid.Column="0"
              MinHeight="300"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
        <TreeView x:Name="RepositoryTree"
                  Style="{StaticResource DenseTreeViewStyle}"
                  ItemContainerStyle="{StaticResource DenseTreeItemStyle}"
                  ItemTemplate="{StaticResource RepositoryTreeItemTemplate}"
                  SelectionMode="Single"
                  ItemInvoked="RepositoryTree_ItemInvoked"
                  RightTapped="RepositoryTreeBranchDeletion_RightTapped"
                  DoubleTapped="RepositoryTree_DoubleTapped" />
      </Border>

      <controls:GridSplitter Grid.Row="2"
                             Grid.Column="1"
                             ResizeDirection="Columns"
                             ResizeBehavior="PreviousAndNext"
                             MinimumFirst="180"
                             MaximumFirst="430"
                             MinimumSecond="520"
                             HorizontalAlignment="Stretch"
                             Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

      <Grid Grid.Row="2" Grid.Column="2" MinHeight="300">
          <Grid x:Name="HistoryPane">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="160" />
              <RowDefinition Height="4" />
              <RowDefinition Height="220" MinHeight="120" />
            </Grid.RowDefinitions>

            <Border x:Name="HistoryFilterToolbar" Grid.Row="0" Style="{StaticResource ToolbarSurfaceStyle}">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Spacing.M}">
                <TextBox x:Name="HistoryFilter"
                         Text="{Binding History.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Filter commits…"
                         Style="{StaticResource CompactTextBoxStyle}"
                         KeyDown="HistoryFilter_KeyDown" />
                <SelectorBar x:Name="ScopeCombo"
                             Grid.Column="1"
                             VerticalAlignment="Center"
                             SelectionChanged="HistoryDisplayModeSelector_SelectionChanged"
                             Loaded="HistoryDisplayModeSelector_Loaded"
                             Unloaded="HistoryDisplayModeSelector_Unloaded"
                             AutomationProperties.Name="History scope">
                  <SelectorBarItem x:Name="CurrentScopeItem"
                                   Text="Current"
                                   ToolTipService.ToolTip="Show commits reachable from the current branch." />
                  <SelectorBarItem x:Name="AllScopeItem"
                                   Text="All"
                                   ToolTipService.ToolTip="Show commits reachable from all references." />
                  <SelectorBarItem x:Name="ShowReflogToggle"
                                   Text="+ Reflog"
                                   ToolTipService.ToolTip="Include commits reachable through Git reflog." />
                </SelectorBar>
                <StackPanel x:Name="ReferenceScopePanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="{StaticResource Spacing.M}"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                  <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="4"
                          Padding="6,2">
                    <TextBlock x:Name="ActiveReferenceText" Style="{StaticResource BodyTextStyle}" />
                  </Border>
                  <Button Content="All refs" Click="ClearReference_Click" Style="{StaticResource CompactButtonStyle}" />
                </StackPanel>
                <StackPanel x:Name="HistoryPerformanceControls"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="{StaticResource Spacing.S}"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                  <TextBlock x:Name="HistoryPerformanceCaptureStatus"
                             Text="PERF CAPTURE"
                             Style="{StaticResource TechnicalTextStyle}"
                             Visibility="Collapsed"
                             VerticalAlignment="Center" />
                  <Button x:Name="HistoryPerformanceButton"
                          Content="Perf"
                          Style="{StaticResource CompactButtonStyle}"
                          AutomationProperties.Name="History performance diagnostics">
                    <Button.Flyout>
                      <MenuFlyout>
                        <MenuFlyoutItem x:Name="StartHistoryPerformanceCaptureMenuItem"
                                        Text="Start performance capture"
                                        Click="StartHistoryPerformanceCapture_Click" />
                        <MenuFlyoutItem x:Name="StopHistoryPerformanceCaptureMenuItem"
                                        Text="Stop performance capture"
                                        IsEnabled="False"
                                        Click="StopHistoryPerformanceCapture_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="OpenHistoryPerformanceDiagnosticsFolderMenuItem"
                                        Text="Open diagnostics folder"
                                        Click="OpenHistoryPerformanceDiagnosticsFolder_Click" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="1" RowDefinitions="Auto,*">
              <Border x:Name="HistoryColumnHeader"
                      Style="{StaticResource DenseColumnHeaderSurfaceStyle}"
                      Loaded="HistoryColumnHeader_Loaded">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HistoryGraphHeaderColumn" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="GRAPH" Style="{StaticResource CaptionStrongTextStyle}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="MESSAGE" Style="{StaticResource CaptionStrongTextStyle}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="AUTHOR" Style="{StaticResource CaptionStrongTextStyle}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="DATE" Style="{StaticResource CaptionStrongTextStyle}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="HASH" Style="{StaticResource CaptionStrongTextStyle}" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ListView x:Name="HistoryList"
                        Grid.Row="1"
                        ItemsSource="{Binding History.Rows}"
                        SelectedItem="{Binding History.SelectedRow, Mode=TwoWay}"
                        IsItemClickEnabled="False"
                        ItemContainerStyle="{StaticResource HistoryRowStyle}"
                        ItemTemplate="{StaticResource HistoryItemTemplate}" />
              <Button x:Name="LoadMoreHistoryButton"
                      Grid.Row="1"
                      Content="↓"
                      Click="LoadMoreHistory_Click"
                      Style="{StaticResource IconButtonStyle}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,8,8"
                      ToolTipService.ToolTip="Load more commits"
                      AutomationProperties.Name="Load more commits" />
            </Grid>

            <controls:GridSplitter Grid.Row="2"
                                   ResizeDirection="Rows"
                                   ResizeBehavior="PreviousAndNext"
                                   MinimumFirst="160"
                                   MinimumSecond="120"
                                   VerticalAlignment="Stretch"
                                   Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Pivot x:Name="DetailsTabs"
                   Grid.Row="3"
                   HeaderTemplate="{StaticResource PivotHeaderTemplate}"
                   SelectionChanged="DetailsTabs_SelectionChanged"
                   Visibility="{Binding CommitDetails.HasSelectedDetailsObject, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Pivot.Resources>
                <Style TargetType="primitives:PivotHeaderItem" BasedOn="{StaticResource CompactPivotHeaderItemStyle}" />
              </Pivot.Resources>
              <PivotItem x:Name="SummaryTab" Header="{Binding CommitDetails.SelectedDetailsTitle}">
                <Grid>
                  <ScrollViewer x:Name="DetailsScroller"
                                Visibility="{Binding HasSelectedCommit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Left"
                                HorizontalScrollMode="Disabled"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Auto"
                                VerticalScrollBarVisibility="Auto"
                                MinHeight="120">
                    <controls:CommitDetailsView x:Name="CommitDetailsContent" />
                  </ScrollViewer>

                  <ScrollViewer Visibility="{Binding Stashes.HasSelectedStash, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalScrollMode="Disabled"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Auto"
                                VerticalScrollBarVisibility="Auto"
                                MinHeight="120">
                    <StackPanel Margin="12" Spacing="8">
                      <TextBlock Text="{Binding CommitDetails.SelectedStashDisplay}"
                                 Style="{StaticResource BodyStrongTextStyle}"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding CommitDetails.SelectedStashBaseDisplay}"
                                 Style="{StaticResource SecondaryTextStyle}" />
                      <TextBlock Text="{Binding CommitDetails.SelectedStashHashDisplay}"
                                 Style="{StaticResource SecondaryTextStyle}" />
                      <TextBlock Text="{Binding CommitDetails.SelectedStashStatsDisplay}"
                                 Style="{StaticResource SecondaryTextStyle}" />
                      <TextBlock Text="{Binding CommitDetails.SelectedStashDetailsStatus}"
                                 Style="{StaticResource SecondaryTextStyle}"
                                 TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                        <Button Content="Apply"
                                Command="{Binding Stashes.ApplyCommand}"
                                Style="{StaticResource CompactButtonStyle}" />
                        <Button Content="Pop"
                                Command="{Binding Stashes.PopCommand}"
                                Style="{StaticResource CompactButtonStyle}" />
                        <Button Content="Drop…"
                                Click="DropSelectedStash_Click"
                                IsEnabled="{Binding Stashes.CanMutateSelectedStash}"
                                Style="{StaticResource CompactButtonStyle}" />
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </PivotItem>

              <PivotItem x:Name="ChangesTab" Header="Changes">
                <Grid MinHeight="120" Loaded="ChangesSurface_Loaded">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38*" MinWidth="210" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="62*" MinWidth="270" />
                  </Grid.ColumnDefinitions>

                  <Grid RowDefinitions="Auto,*">
                    <Border x:Name="ChangedFilesHeader" Style="{StaticResource PaneHeaderSurfaceStyle}">
                      <Grid ColumnDefinitions="*,132,46,46">
                        <TextBlock Text="Changed files" Style="{StaticResource PaneHeaderTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="State" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="+" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="−" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <TreeView x:Name="ChangedFilesTree"
                              Grid.Row="1"
                              Style="{StaticResource DenseTreeViewStyle}"
                              ItemContainerStyle="{StaticResource DenseTreeItemStyle}"
                              ItemTemplate="{StaticResource ChangedFileTreeItemTemplate}"
                              SelectionMode="Single"
                              ItemInvoked="ChangedFilesTree_ItemInvoked" />

                    <ListView x:Name="CommitFilesList"
                              Grid.Row="1"
                              Visibility="Collapsed"
                              SelectionChanged="CommitFilesList_SelectionChanged"
                              DoubleTapped="CommitFilesList_DoubleTapped"
                              KeyDown="CommitFilesList_KeyDown" />
                  </Grid>

                  <controls:GridSplitter Grid.Column="1"
                                         ResizeDirection="Columns"
                                         ResizeBehavior="PreviousAndNext"
                                         MinimumFirst="210"
                                         MinimumSecond="270"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                  <Grid Grid.Column="2" RowDefinitions="Auto,*">
                    <Border x:Name="CommitDiffHeader"
                            Visibility="Collapsed"
                            Style="{StaticResource DiffHeaderSurfaceStyle}">
                      <Grid x:Name="CommitTextDiffHeader"
                            Visibility="Collapsed"
                            ColumnDefinitions="38,38,*">
                        <TextBlock Text="OLD"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,5,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="NEW"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,5,0"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                      <StackPanel x:Name="CommitLargeDiffInfo"
                                  Visibility="Collapsed"
                                  Margin="12"
                                  Spacing="8"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top">
                        <TextBlock Text="Large diff"
                                   Style="{StaticResource BodyStrongTextStyle}" />
                        <TextBlock x:Name="CommitLargeDiffMessage"
                                   TextWrapping="Wrap" />
                        <Button x:Name="CommitLargeDiffButton"
                                Content="Load diff"
                                HorizontalAlignment="Left"
                                Click="CommitLargeDiffButton_Click" />
                      </StackPanel>
                      <InfoBar x:Name="CommitBinaryInfo"
                               IsOpen="True"
                               Severity="Informational"
                               Title="Binary file"
                               Message="Binary file — text diff is not available."
                               Visibility="Collapsed"
                               IsClosable="False"
                               VerticalAlignment="Top" />
                      <StackPanel x:Name="CommitImageLoading"
                                  Visibility="Collapsed"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                        <ProgressRing Width="18" Height="18" IsActive="True" />
                        <TextBlock Text="Loading image comparison…" VerticalAlignment="Center" />
                      </StackPanel>
                      <controls:ImageDiffPreviewHost x:Name="CommitImageDiffHost"
                                                     Visibility="Collapsed"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch" />
                      <controls:SelectableDiffViewer x:Name="CompactDiffViewer"
                                                     Visibility="Collapsed"
                                                     MinHeight="96"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch" />
                    </Grid>
                  </Grid>
                </Grid>
              </PivotItem>
            </Pivot>
          </Grid>

          <Grid x:Name="WorkingTreePane"
                Visibility="Collapsed"
                RowDefinitions="Auto,*,Auto"
                Padding="{StaticResource Padding.WorkspaceCompact}">
            <Grid x:Name="WorkingTreeHeader"
                  MinHeight="{StaticResource Height.Control}"
                  Margin="0,0,0,4">
              <TextBlock Text="Working tree"
                         Style="{StaticResource PaneHeaderTextStyle}"
                         VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="330,4,*" MinHeight="180">
              <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="{StaticResource Spacing.S}" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" RowDefinitions="Auto,*">
                  <Grid MinHeight="{StaticResource Height.Control}" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.XS}">
                    <TextBlock x:Name="UnstagedHeader"
                               Text="Unstaged changes"
                               Style="{StaticResource BodyStrongTextStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Spacing.XS}">
                      <Button Command="{Binding WorkingTree.StageSelectedCommand}"
                              Style="{StaticResource IconButtonStyle}"
                              ToolTipService.ToolTip="Stage selected"
                              AutomationProperties.Name="Stage selected">
                        <FontIcon Glyph="&#xE710;" FontSize="{StaticResource Icon.Small}" />
                      </Button>
                      <Button Command="{Binding WorkingTree.StageAllCommand}"
                              Style="{StaticResource IconButtonStyle}"
                              ToolTipService.ToolTip="Stage all"
                              AutomationProperties.Name="Stage all">
                        <TextBlock Text="++" Style="{StaticResource CaptionStrongTextStyle}" />
                      </Button>
                      <Border Width="1"
                              Height="18"
                              Margin="3,0"
                              Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                              VerticalAlignment="Center" />
                      <Button Command="{Binding WorkingTree.RequestDiscardSelectedCommand}"
                              Style="{StaticResource IconButtonStyle}"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                              ToolTipService.ToolTip="Discard selected"
                              AutomationProperties.Name="Discard selected">
                        <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource Icon.Small}" />
                      </Button>
                      <Button Command="{Binding WorkingTree.RequestDiscardAllCommand}"
                              Style="{StaticResource IconButtonStyle}"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                              ToolTipService.ToolTip="Discard all…"
                              AutomationProperties.Name="Discard all">
                        <TextBlock Text="All…" Style="{StaticResource CaptionStrongTextStyle}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                  <TreeView x:Name="UnstagedChangesTree"
                            Grid.Row="1"
                            Style="{StaticResource DenseTreeViewStyle}"
                            ItemContainerStyle="{StaticResource DenseTreeItemStyle}"
                            ItemTemplate="{StaticResource WorkingTreeTreeItemTemplate}"
                            SelectionMode="None"
                            ItemInvoked="UnstagedChangesTree_ItemInvoked"
                            RightTapped="UnstagedChangesTree_RightTapped" />
                </Grid>

                <controls:GridSplitter x:Name="WorkingTreeStagingSplitter"
                                       Grid.Row="1"
                                       ResizeDirection="Rows"
                                       ResizeBehavior="PreviousAndNext"
                                       MinimumFirst="80"
                                       MinimumSecond="80"
                                       VerticalAlignment="Stretch"
                                       Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                  <Grid MinHeight="{StaticResource Height.Control}" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.XS}">
                    <TextBlock x:Name="StagedHeader"
                               Text="Staged changes"
                               Style="{StaticResource BodyStrongTextStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Spacing.XS}">
                      <Button Command="{Binding WorkingTree.UnstageSelectedCommand}"
                              Style="{StaticResource IconButtonStyle}"
                              ToolTipService.ToolTip="Unstage selected"
                              AutomationProperties.Name="Unstage selected">
                        <TextBlock Text="−" Style="{StaticResource BodyStrongTextStyle}" />
                      </Button>
                      <Button Command="{Binding WorkingTree.UnstageAllCommand}"
                              Style="{StaticResource IconButtonStyle}"
                              ToolTipService.ToolTip="Unstage all"
                              AutomationProperties.Name="Unstage all">
                        <TextBlock Text="−−" Style="{StaticResource CaptionStrongTextStyle}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                  <TreeView x:Name="StagedChangesTree"
                            Grid.Row="1"
                            Style="{StaticResource DenseTreeViewStyle}"
                            ItemContainerStyle="{StaticResource DenseTreeItemStyle}"
                            ItemTemplate="{StaticResource WorkingTreeTreeItemTemplate}"
                            SelectionMode="None"
                            ItemInvoked="StagedChangesTree_ItemInvoked"
                            RightTapped="StagedChangesTree_RightTapped" />
                </Grid>
              </Grid>

              <controls:GridSplitter Grid.Column="1"
                                     ResizeDirection="Columns"
                                     ResizeBehavior="PreviousAndNext"
                                     MinimumFirst="220"
                                     MinimumSecond="280"
                                     HorizontalAlignment="Stretch"
                                     Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

              <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" Margin="8,0,0,0">
                <Border Style="{StaticResource PaneHeaderSurfaceStyle}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.L}">
                    <TextBlock x:Name="WorkingTreeDiffHeader"
                               Style="{StaticResource BodyStrongTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="WorkingTreeDiffKindText"
                               Grid.Column="1"
                               Style="{StaticResource CaptionStrongTextStyle}"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border x:Name="WorkingTreeTextDiffHeader"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Style="{StaticResource DiffHeaderSurfaceStyle}">
                  <Grid ColumnDefinitions="38,38,*">
                    <TextBlock Text="OLD"
                               Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="NEW"
                               Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Grid Grid.Row="2">
                  <StackPanel x:Name="WorkingTreeLargeDiffInfo"
                              Visibility="Collapsed"
                              Margin="12"
                              Spacing="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top">
                    <TextBlock Text="Large diff"
                               Style="{StaticResource BodyStrongTextStyle}" />
                    <TextBlock x:Name="WorkingTreeLargeDiffMessage"
                               TextWrapping="Wrap" />
                    <Button x:Name="WorkingTreeLargeDiffButton"
                            Content="Load diff"
                            HorizontalAlignment="Left"
                            Click="WorkingTreeLargeDiffButton_Click" />
                  </StackPanel>
                  <StackPanel x:Name="WorkingTreeDiffLoading"
                              Visibility="Collapsed"
                              Orientation="Horizontal"
                              Spacing="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <ProgressRing Width="18" Height="18" IsActive="True" />
                    <TextBlock Text="Loading diff…" VerticalAlignment="Center" />
                  </StackPanel>
                  <InfoBar x:Name="WorkingTreeBinaryInfo"
                           IsOpen="True"
                           Severity="Informational"
                           Title="Binary file"
                           Message="Binary file — text diff is not available."
                           Visibility="Collapsed"
                           IsClosable="False"
                           VerticalAlignment="Top" />
                  <InfoBar x:Name="WorkingTreeNoChangesInfo"
                           IsOpen="True"
                           Severity="Informational"
                           Title="No changes"
                           Message="The selected delta no longer exists."
                           Visibility="Collapsed"
                           IsClosable="False"
                           VerticalAlignment="Top" />
                  <StackPanel x:Name="WorkingTreeImageLoading"
                              Visibility="Collapsed"
                              Orientation="Horizontal"
                              Spacing="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <ProgressRing Width="18" Height="18" IsActive="True" />
                    <TextBlock Text="Loading image comparison…" VerticalAlignment="Center" />
                  </StackPanel>
                  <controls:ImageDiffPreviewHost x:Name="WorkingTreeImageDiffHost"
                                                 Visibility="Collapsed"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch" />
                  <controls:SelectableDiffViewer x:Name="WorkingTreeDiffViewer"
                                                 Visibility="Collapsed"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch" />
                </Grid>
              </Grid>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,4,0,0">
              <StackPanel Spacing="{StaticResource Spacing.S}">
                <TextBlock Text="Commit message"
                           Style="{StaticResource BodyStrongTextStyle}" />
                <TextBox x:Name="CommitMessageEditor"
                         Text="{Binding CommitCreation.CommitMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Style="{StaticResource CompactMultilineTextBoxStyle}"
                         MinHeight="{StaticResource Height.CommitEditor}"
                         AutomationProperties.Name="Commit message" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                  <Button Content="Commit" Command="{Binding CommitCreation.CommitCommand}" Style="{StaticResource CompactButtonStyle}" />
                  <Button Content="Amend" Command="{Binding CommitCreation.AmendCommand}" Style="{StaticResource CompactButtonStyle}" />
                  <Button Content="Stash…"
                          Click="CreateStash_Click"
                          IsEnabled="{Binding Stashes.CanCreateStash}"
                          Style="{StaticResource CompactButtonStyle}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

      <Border x:Name="StatusBar" Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource StatusBarSurfaceStyle}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="{StaticResource Spacing.XL}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.M}" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE8F0;" FontSize="{StaticResource Icon.Small}" />
            <TextBlock x:Name="StatusBranchText" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="StatusTrackingText" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusChangesText" Grid.Column="2" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
          <Border x:Name="StatusOperationContainer"
                  Grid.Column="4"
                  Padding="8,2"
                  CornerRadius="6">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Spacing.S}"
                        VerticalAlignment="Center">
              <FontIcon x:Name="StatusOperationIdleIcon"
                        Glyph="&#xE73E;"
                        FontSize="{StaticResource Icon.Small}"
                        Opacity="0.66" />
              <Ellipse x:Name="BusyPulseDot"
                       Width="8"
                       Height="8"
                       Fill="#22C55E"
                       Opacity="1"
                       Visibility="Collapsed" />
              <TextBlock x:Name="StatusOperationText"
                         Style="{StaticResource BodyStrongTextStyle}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <InfoBar IsOpen="{Binding HasError}"
             Severity="Error"
             Title="Error"
             Message="{Binding ErrorMessage}"
             IsClosable="True"
             CloseButtonCommand="{Binding DismissErrorCommand}"
             VerticalAlignment="Bottom"
             Margin="16,0,16,26" />
  </Grid>
</Page>
