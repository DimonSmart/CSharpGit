<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CSharpGit.Presentation.Controls"
    xmlns:domain="using:CSharpGit.Domain">

  <Style x:Key="HistoryReferenceDefaultBranchIconStyle" TargetType="FontIcon">
    <Setter Property="Glyph" Value="&#xE80F;" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <DataTemplate x:Key="HistoryItemTemplate" x:DataType="domain:HistoryRow">
    <Grid x:Name="HistoryRowRoot"
          MinHeight="{StaticResource Height.DataRow}"
          Padding="{StaticResource Padding.DenseRow}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="90" />
      </Grid.ColumnDefinitions>
      <Border Grid.ColumnSpan="5"
              Background="{ThemeResource AccentFillColorDefaultBrush}"
              Opacity="0.06"
              Visibility="{x:Bind IsReflogOnly, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
              IsHitTestVisible="False" />
      <controls:CommitGraphControl Graph="{x:Bind Topology, Mode=OneWay, Converter={StaticResource CommitTopologyToGraphVisualConverter}}"
                                   VerticalAlignment="Stretch" />
      <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*" MinWidth="120">
        <TextBlock Text="{x:Bind Commit.Subject, Mode=OneWay}"
                   Style="{StaticResource BodyStrongTextStyle}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <Border Grid.Column="1"
                Style="{StaticResource ReferenceBadgeStyle}"
                Margin="{StaticResource Margin.ReferenceList}"
                Visibility="{x:Bind IsReflogOnly, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                ToolTipService.ToolTip="This commit is not reachable from normal repository refs and is currently reachable through Git reflog.">
          <TextBlock Text="reflog" Style="{StaticResource ReferenceBadgeTextStyle}" />
        </Border>
        <controls:HistoryReferencesPresenter Grid.Column="2"
                                             References="{x:Bind Commit.References, Mode=OneWay}"
                                             Margin="{StaticResource Margin.ReferenceList}"
                                             VerticalAlignment="Center" />
      </Grid>
      <Grid Grid.Column="2"
            ColumnDefinitions="Auto,*"
            Margin="{StaticResource Margin.HistoryColumnGap}"
            VerticalAlignment="Center">
        <controls:AuthorAvatar AuthorName="{x:Bind Commit.Author, Mode=OneWay}"
                               AuthorEmail="{x:Bind Commit.AuthorEmail, Mode=OneWay}"
                               AvatarSize="18"
                               Margin="0,0,6,0" />
        <TextBlock Grid.Column="1"
                   Text="{x:Bind Commit.Author, Mode=OneWay}"
                   Style="{StaticResource BodyTextStyle}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </Grid>
      <controls:CommitTimeText Grid.Column="3"
                               Value="{x:Bind Commit.AuthoredAt, Mode=OneWay}"
                               Margin="{StaticResource Margin.HistoryColumnGap}"
                               FontSize="{StaticResource Font.Caption}"
                               VerticalAlignment="Center" />
      <TextBlock Grid.Column="4"
                 Text="{x:Bind Commit.ShortHash, Mode=OneWay}"
                 Style="{StaticResource TechnicalSecondaryTextStyle}"
                 Margin="{StaticResource Margin.HistoryColumnGap}"
                 VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="SimplifiedHistoryItemTemplate" x:DataType="domain:HistoryRow">
    <Grid MinHeight="{StaticResource Height.DataRow}"
          Padding="{StaticResource Padding.DenseRow}">
      <TextBlock Text="{x:Bind Commit.Subject, Mode=OneWay}"
                 Style="{StaticResource BodyStrongTextStyle}"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="HistoryTextColumnsItemTemplate" x:DataType="domain:HistoryRow">
    <Grid MinHeight="{StaticResource Height.DataRow}"
          Padding="{StaticResource Padding.DenseRow}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="90" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Text="{x:Bind Commit.Subject, Mode=OneWay}" Style="{StaticResource BodyStrongTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{x:Bind Commit.Author, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Margin="{StaticResource Margin.HistoryColumnGap}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="3" Text="{Binding Commit.AuthoredAt}" Style="{StaticResource SecondaryTextStyle}" Margin="{StaticResource Margin.HistoryColumnGap}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="4" Text="{x:Bind Commit.ShortHash, Mode=OneWay}" Style="{StaticResource TechnicalSecondaryTextStyle}" Margin="{StaticResource Margin.HistoryColumnGap}" VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="HistoryTextGraphItemTemplate" x:DataType="domain:HistoryRow">
    <Grid MinHeight="{StaticResource Height.DataRow}"
          Padding="{StaticResource Padding.DenseRow}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="90" />
      </Grid.ColumnDefinitions>
      <controls:CommitGraphControl Graph="{x:Bind Topology, Mode=OneWay, Converter={StaticResource CommitTopologyToGraphVisualConverter}}" VerticalAlignment="Stretch" />
      <TextBlock Grid.Column="1" Text="{x:Bind Commit.Subject, Mode=OneWay}" Style="{StaticResource BodyStrongTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{x:Bind Commit.Author, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Margin="{StaticResource Margin.HistoryColumnGap}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="3" Text="{Binding Commit.AuthoredAt}" Style="{StaticResource SecondaryTextStyle}" Margin="{StaticResource Margin.HistoryColumnGap}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="4" Text="{x:Bind Commit.ShortHash, Mode=OneWay}" Style="{StaticResource TechnicalSecondaryTextStyle}" Margin="{StaticResource Margin.HistoryColumnGap}" VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="HistoryTextGraphReferencesItemTemplate" x:DataType="domain:HistoryRow">
    <Grid MinHeight="{StaticResource Height.DataRow}"
          Padding="{StaticResource Padding.DenseRow}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="90" />
      </Grid.ColumnDefinitions>
      <Border Grid.ColumnSpan="5" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.06"
              Visibility="{x:Bind IsReflogOnly, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" IsHitTestVisible="False" />
      <controls:CommitGraphControl Graph="{x:Bind Topology, Mode=OneWay, Converter={StaticResource CommitTopologyToGraphVisualConverter}}" VerticalAlignment="Stretch" />
      <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*" MinWidth="120">
        <TextBlock Text="{x:Bind Commit.Subject, Mode=OneWay}" Style="{StaticResource BodyStrongTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Border Grid.Column="1" Style="{StaticResource ReferenceBadgeStyle}" Margin="{StaticResource Margin.ReferenceList}"
                Visibility="{x:Bind IsReflogOnly, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                ToolTipService.ToolTip="This commit is not reachable from normal repository refs and is currently reachable through Git reflog.">
          <TextBlock Text="reflog" Style="{StaticResource ReferenceBadgeTextStyle}" />
        </Border>
        <controls:HistoryReferencesPresenter Grid.Column="2"
                                             References="{x:Bind Commit.References, Mode=OneWay}"
                                             Margin="{StaticResource Margin.ReferenceList}"
                                             VerticalAlignment="Center" />
      </Grid>
      <TextBlock Grid.Column="2" Text="{x:Bind Commit.Author, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Margin="{StaticResource Margin.HistoryColumnGap}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="3" Text="{Binding Commit.AuthoredAt}" Style="{StaticResource SecondaryTextStyle}" Margin="{StaticResource Margin.HistoryColumnGap}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="4" Text="{x:Bind Commit.ShortHash, Mode=OneWay}" Style="{StaticResource TechnicalSecondaryTextStyle}" Margin="{StaticResource Margin.HistoryColumnGap}" VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
