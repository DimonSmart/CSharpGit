<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CSharpGit.Presentation.Controls">

  <controls:CommitTopologyToGraphVisualConverter x:Key="CompactCommitTopologyToGraphVisualConverter" />
  <controls:DiffLineKindToBrushConverter x:Key="CompactDiffLineKindToBrushConverter" />

  <DataTemplate x:Key="CompactPivotHeaderTemplate">
    <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Margin="2,0" />
  </DataTemplate>

  <Style x:Key="CompactHistoryItemContainerStyle" TargetType="ListViewItem">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <DataTemplate x:Key="CompactHistoryItemTemplate">
    <Grid ColumnDefinitions="120,*,160,150,90" Height="30" Padding="6,0">
      <controls:CommitGraphControl Graph="{Binding Topology, Converter={StaticResource CompactCommitTopologyToGraphVisualConverter}}" VerticalAlignment="Stretch" />
      <Grid Grid.Column="1" ColumnDefinitions="Auto,*" MinWidth="120">
        <TextBlock Text="{Binding Commit.Subject}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Commit.References}" Margin="7,0,0,0" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,3,0">
                <TextBlock Text="{Binding}" FontSize="10" Opacity="0.82" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      <TextBlock Grid.Column="2" Text="{Binding Commit.Author}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <controls:CommitTimeText Grid.Column="3" Value="{Binding Commit.AuthoredAt}" VerticalAlignment="Center" FontSize="11" />
      <TextBlock Grid.Column="4" Text="{Binding Commit.ShortHash}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="CompactRepositoryTreeItemTemplate">
    <TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=OneWay}" MinHeight="30" Padding="1,0" HorizontalContentAlignment="Stretch">
      <TreeViewItem.Content>
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <FontIcon Glyph="{Binding IconGlyph}" FontSize="15" Visibility="{Binding IconVisibility}" />
          <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
      </TreeViewItem.Content>
    </TreeViewItem>
  </DataTemplate>

  <DataTemplate x:Key="CompactChangedFileTreeItemTemplate">
    <TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" MinHeight="24" Padding="1,0" HorizontalContentAlignment="Stretch">
      <TreeViewItem.Content>
        <Grid ColumnDefinitions="*,26,46,46" Padding="2,0" ColumnSpacing="3">
          <TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Path}" />
          <TextBlock Grid.Column="1" Text="{Binding Status}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding AddedDisplay}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="{Binding RemovedDisplay}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </TreeViewItem.Content>
    </TreeViewItem>
  </DataTemplate>

  <Style x:Key="CompactDiffItemContainerStyle" TargetType="ListViewItem">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <DataTemplate x:Key="CompactDiffItemTemplate">
    <Border Background="{Binding Kind, Converter={StaticResource CompactDiffLineKindToBrushConverter}}">
      <Grid ColumnDefinitions="38,38,*" Height="20">
        <TextBlock Text="{Binding OldLineNumber}" FontFamily="Consolas" FontSize="10" Opacity="0.58"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" />
        <TextBlock Grid.Column="1" Text="{Binding NewLineNumber}" FontFamily="Consolas" FontSize="10" Opacity="0.58"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" />
        <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="Consolas" FontSize="11"
                   TextWrapping="NoWrap" VerticalAlignment="Center" Padding="5,0" />
      </Grid>
    </Border>
  </DataTemplate>
</ResourceDictionary>
