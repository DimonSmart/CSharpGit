<UserControl x:Class="CSharpGit.Presentation.Controls.GitConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CSharpGit.Presentation.Controls">
  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0">
    <Grid RowDefinitions="Auto,*">
      <Border Style="{StaticResource PaneHeaderSurfaceStyle}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Spacing.M}">
          <TextBlock Text="Git Console"
                     Style="{StaticResource PaneHeaderTextStyle}"
                     VerticalAlignment="Center" />
          <ComboBox x:Name="FilterComboBox"
                    Grid.Column="1"
                    MinWidth="150"
                    Style="{StaticResource CompactComboBoxStyle}"
                    SelectionChanged="FilterComboBox_SelectionChanged" />
          <Button Grid.Column="2"
                  Style="{StaticResource IconButtonStyle}"
                  Click="Close_Click"
                  ToolTipService.ToolTip="Close Git Console"
                  AutomationProperties.Name="Close Git Console">
            <FontIcon Glyph="&#xE711;" FontSize="{StaticResource Icon.Small}" />
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="2*,4,3*" MinHeight="120">
        <Grid Grid.Column="0">
          <ListView x:Name="CommandList"
                    SelectionMode="Single"
                    SelectionChanged="CommandList_SelectionChanged"
                    ItemContainerStyle="{StaticResource DenseListItemStyle}"
                    HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="72,24,*,92" ColumnSpacing="{StaticResource Spacing.S}">
                  <TextBlock Text="{Binding StartedText}"
                             Style="{StaticResource SecondaryTextStyle}"
                             FontFamily="Consolas"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding StatusGlyph}"
                             Style="{StaticResource BodyTextStyle}"
                             FontFamily="Consolas"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding CommandText}"
                             Style="{StaticResource BodyTextStyle}"
                             FontFamily="Consolas"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"
                             ToolTipService.ToolTip="{Binding CommandText}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3"
                             Text="{Binding DurationText}"
                             Style="{StaticResource SecondaryTextStyle}"
                             FontFamily="Consolas"
                             TextAlignment="Right"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock x:Name="EmptyText"
                     Text="No Git commands recorded in this session."
                     Style="{StaticResource SecondaryTextStyle}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Visibility="Collapsed" />
        </Grid>

        <controls:GridSplitter Grid.Column="1"
                               ResizeDirection="Columns"
                               ResizeBehavior="PreviousAndNext"
                               MinimumFirst="220"
                               MinimumSecond="300"
                               HorizontalAlignment="Stretch"
                               Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Padding="12,8" Spacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="Command details"
                         Style="{StaticResource BodyStrongTextStyle}"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Copy command" Click="CopyCommand_Click" Style="{StaticResource CompactButtonStyle}" />
              <Button Grid.Column="2" Content="Copy all" Click="CopyAll_Click" Style="{StaticResource CompactButtonStyle}" />
            </Grid>

            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="5" ColumnSpacing="10">
              <TextBlock Text="Command" Style="{StaticResource SecondaryTextStyle}" />
              <TextBlock x:Name="CommandText" Grid.Column="1" FontFamily="Consolas" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="Working directory" Style="{StaticResource SecondaryTextStyle}" />
              <TextBlock x:Name="WorkingDirectoryText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Text="Started" Style="{StaticResource SecondaryTextStyle}" />
              <TextBlock x:Name="StartedText" Grid.Row="2" Grid.Column="1" />
              <TextBlock Grid.Row="3" Text="Duration" Style="{StaticResource SecondaryTextStyle}" />
              <TextBlock x:Name="DurationText" Grid.Row="3" Grid.Column="1" />
              <TextBlock Grid.Row="4" Text="Exit code" Style="{StaticResource SecondaryTextStyle}" />
              <TextBlock x:Name="ExitCodeText" Grid.Row="4" Grid.Column="1" FontFamily="Consolas" />
            </Grid>

            <TextBlock Text="stdout" Style="{StaticResource BodyStrongTextStyle}" Margin="0,4,0,0" />
            <TextBox x:Name="StandardOutputText"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     MinHeight="72"
                     MaxHeight="180"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <TextBlock Text="stderr" Style="{StaticResource BodyStrongTextStyle}" Margin="0,4,0,0" Opacity="0.82" />
            <TextBox x:Name="StandardErrorText"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     MinHeight="72"
                     MaxHeight="180"
                     Opacity="0.88"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</UserControl>
