<Page x:Class="CSharpGit.Presentation.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CSharpGit.Presentation.Controls" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
  <Page.Resources>
    <ContentDialog x:Key="GitOperationsDialog" Title="Git operations" CloseButtonText="Close" DefaultButton="Close">
      <ScrollViewer MaxHeight="650" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="620" Spacing="12">
          <TextBlock Text="Branches" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding NewBranchName, Mode=TwoWay}" PlaceholderText="New local branch" />
            <Button Grid.Column="1" Content="Create and switch" Command="{Binding CreateBranchCommand}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding LocalBranches}" SelectedItem="{Binding SelectedMergeBranch, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Branch to merge" />
            <Button Grid.Column="1" Content="Merge into current" Command="{Binding MergeCommand}" />
          </Grid>

          <TextBlock Text="Tracking branch" FontWeight="SemiBold" Margin="0,4,0,0" />
          <Grid ColumnDefinitions="200,*,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding RemoteBranches}" SelectedItem="{Binding SelectedRemoteBranch, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Remote branch" />
            <TextBox Grid.Column="1" Text="{Binding NewBranchName, Mode=TwoWay}" PlaceholderText="Local branch name" />
            <Button Grid.Column="2" Content="Checkout tracking" Command="{Binding CheckoutRemoteCommand}" />
          </Grid>

          <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
          <TextBlock Text="Stash" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding StashMessage, Mode=TwoWay}" PlaceholderText="Optional stash message" />
            <Button Grid.Column="1" Content="Create stash" Command="{Binding CreateStashCommand}" />
          </Grid>

          <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
          <TextBlock Text="Remote / explicit push" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding Remotes}" SelectedItem="{Binding SelectedRemote, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Remote" />
            <TextBox Grid.Column="1" Text="{Binding PushBranchName, Mode=TwoWay}" PlaceholderText="Remote branch name" />
            <CheckBox Grid.Column="2" Content="Set upstream" IsChecked="{Binding SetUpstream, Mode=TwoWay}" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Push" Click="Push_Click" />
            <Button Content="Force push with lease…" Click="ForcePushWithLease_Click" IsEnabled="{Binding CanForcePushWithLease}" />
            <Button Content="Fetch all" Command="{Binding FetchAllCommand}" />
          </StackPanel>

          <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
          <TextBlock Text="Interactive rebase" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding RebaseOnto, Mode=TwoWay}" PlaceholderText="onto (for example HEAD~3)" />
            <Button Grid.Column="1" Content="Build plan" Command="{Binding LoadRebasePlanCommand}" />
          </Grid>
          <ListView ItemsSource="{Binding RebasePlan}" SelectedItem="{Binding SelectedRebaseItem, Mode=TwoWay}" DisplayMemberPath="Display" Height="130" />
          <Grid ColumnDefinitions="Auto,Auto,140,*,Auto" ColumnSpacing="6">
            <Button Content="↑" Command="{Binding MoveRebaseUpCommand}" />
            <Button Grid.Column="1" Content="↓" Command="{Binding MoveRebaseDownCommand}" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding RebaseActions}" SelectedItem="{Binding RebaseAction, Mode=TwoWay}" />
            <TextBox Grid.Column="3" Text="{Binding RebaseMessage, Mode=TwoWay}" PlaceholderText="New message for reword" />
            <Button Grid.Column="4" Content="Apply" Command="{Binding ApplyRebaseItemCommand}" />
          </Grid>
          <Button Content="Start rebase" Command="{Binding StartRebaseCommand}" HorizontalAlignment="Left" />

          <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
          <TextBlock Text="Merge tool settings" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="140,160,160" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding MergeToolNames}" IsEditable="True" Text="{Binding MergeToolName, Mode=TwoWay}" Header="Preset/name" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding MergeToolKinds}" SelectedItem="{Binding MergeToolKind, Mode=TwoWay}" Header="Type" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding MergeToolScopes}" SelectedItem="{Binding MergeToolScope, Mode=TwoWay}" Header="Git config" />
          </Grid>
          <TextBox Header="Executable/path or command" Text="{Binding MergeToolExecutable, Mode=TwoWay}" />
          <TextBox Header="Arguments: $BASE $LOCAL $REMOTE $MERGED" Text="{Binding MergeToolArguments, Mode=TwoWay}" />
          <Button Content="Save merge tool configuration" Command="{Binding ConfigureMergeToolCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </ScrollViewer>
    </ContentDialog>
  </Page.Resources>

  <Grid x:Name="RootLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyDown="Page_KeyDown">
    <StackPanel Width="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{StaticResource Spacing.XXL}"
                Visibility="{Binding PickerVisibility}">
      <FontIcon Glyph="&#xE8B7;" FontSize="56" HorizontalAlignment="Center" />
      <TextBlock Text="Open a Git repository" Style="{StaticResource TitleTextStyle}" TextAlignment="Center" />
      <TextBlock Text="Select the folder of an existing repository or worktree."
                 Style="{StaticResource BodyTextStyle}"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 Opacity="0.72" />
      <Button Content="Select folder…"
              Command="{Binding OpenRepositoryCommand}"
              Style="{StaticResource CompactButtonStyle}"
              HorizontalAlignment="Center" />
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Spacing="{StaticResource Spacing.L}"
                  Visibility="{Binding BusyVisibility}">
        <ProgressRing IsActive="{Binding IsBusy}" Width="20" Height="20" />
        <TextBlock Text="Opening repository…" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <Grid x:Name="RepositoryWorkspace" Visibility="{Binding RepositoryVisibility}" RowDefinitions="Auto,Auto,*,Auto">
      <Border x:Name="MainToolbar" Grid.Row="0" Style="{StaticResource ToolbarSurfaceStyle}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="{StaticResource Spacing.M}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.M}" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource Icon.Normal}" />
            <TextBlock Text="CSharpGit" Style="{StaticResource ToolbarProductTextStyle}" VerticalAlignment="Center" />
          </StackPanel>
          <Border Grid.Column="1" Width="1" Height="{StaticResource Height.DiffRow}" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Text="{Binding Repository.WorkingDirectory}"
                     Style="{StaticResource BodyTextStyle}"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="430"
                     VerticalAlignment="Center"
                     ToolTipService.ToolTip="{Binding Repository.WorkingDirectory}" />
          <Border Grid.Column="3" Width="1" Height="{StaticResource Height.DiffRow}" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="4"
                      Orientation="Horizontal"
                      Spacing="{StaticResource Spacing.S}"
                      VerticalAlignment="Center"
                      Margin="2,0,4,0">
            <FontIcon Glyph="&#xE8F0;" FontSize="{StaticResource Icon.Small}" />
            <TextBlock x:Name="ToolbarBranchText" Style="{StaticResource BodyStrongTextStyle}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="{StaticResource Spacing.XS}" VerticalAlignment="Center">
            <Button Click="Fetch_Click" Style="{StaticResource ToolbarButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                <FontIcon Glyph="&#xE896;" FontSize="{StaticResource Icon.Small}" />
                <TextBlock Text="Fetch" Style="{StaticResource BodyTextStyle}" />
              </StackPanel>
            </Button>
            <Button Click="Pull_Click" Style="{StaticResource ToolbarButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                <FontIcon Glyph="&#xE896;" FontSize="{StaticResource Icon.Small}" />
                <TextBlock Text="Pull" Style="{StaticResource BodyTextStyle}" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                <FontIcon Glyph="&#xE898;" FontSize="{StaticResource Icon.Small}" />
                <TextBlock Text="Push ▼" Style="{StaticResource BodyTextStyle}" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="Push" Click="Push_Click" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Force push with lease…" Click="ForcePushWithLease_Click" IsEnabled="{Binding CanForcePushWithLease}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="RefreshButton"
                    Click="RefreshIndicator_Click"
                    Style="{StaticResource IconButtonStyle}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Refresh repository."
                    AutomationProperties.Name="Refresh repository">
              <Grid Width="16" Height="16">
                <FontIcon x:Name="RefreshIcon"
                          Glyph="&#xE72C;"
                          FontSize="{StaticResource Icon.Normal}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <ProgressRing x:Name="RefreshProgressRing"
                              IsActive="False"
                              Visibility="Collapsed"
                              Width="16"
                              Height="16" />
              </Grid>
            </Button>
          </StackPanel>
          <Button Grid.Column="6" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE712;" FontSize="{StaticResource Icon.Normal}" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="More Git operations…" Click="MoreOperations_Click" />
                <MenuFlyoutItem Text="Settings…" Click="Settings_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>

      <controls:OperationBanner Grid.Row="1" Visibility="{Binding OperationVisibility}" />

      <Grid Grid.Row="2" MinHeight="300">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="270" MinWidth="180" MaxWidth="430" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="*" MinWidth="520" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
          <Grid RowDefinitions="Auto,*">
            <Border Style="{StaticResource PaneHeaderSurfaceStyle}">
              <TextBlock Text="Repository" Style="{StaticResource PaneHeaderTextStyle}" VerticalAlignment="Center" />
            </Border>
            <TreeView x:Name="RepositoryTree"
                      Grid.Row="1"
                      Style="{StaticResource DenseTreeViewStyle}"
                      ItemContainerStyle="{StaticResource DenseTreeItemStyle}"
                      ItemTemplate="{StaticResource RepositoryTreeItemTemplate}"
                      SelectionMode="Single"
                      ItemInvoked="RepositoryTree_ItemInvoked"
                      RightTapped="RepositoryTreeBranchDeletion_RightTapped"
                      DoubleTapped="RepositoryTree_DoubleTapped" />
          </Grid>
        </Border>

        <controls:GridSplitter Grid.Column="1"
                               ResizeDirection="Columns"
                               ResizeBehavior="PreviousAndNext"
                               MinimumFirst="180"
                               MaximumFirst="430"
                               MinimumSecond="520"
                               HorizontalAlignment="Stretch"
                               Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Column="2">
          <Grid x:Name="HistoryPane">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="160" />
              <RowDefinition Height="4" />
              <RowDefinition Height="220" MinHeight="120" />
            </Grid.RowDefinitions>

            <Border x:Name="HistoryFilterToolbar" Grid.Row="0" Style="{StaticResource ToolbarSurfaceStyle}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.M}">
                <TextBox x:Name="HistoryFilter"
                         Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Filter commits…"
                         Style="{StaticResource CompactTextBoxStyle}"
                         KeyDown="HistoryFilter_KeyDown" />
                <ComboBox x:Name="ScopeCombo"
                          Grid.Column="1"
                          ItemsSource="{Binding Scopes}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedScope, Mode=TwoWay}"
                          Style="{StaticResource CompactComboBoxStyle}"
                          MinWidth="145" />
                <StackPanel x:Name="ReferenceScopePanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="{StaticResource Spacing.M}"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                  <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="4"
                          Padding="6,2">
                    <TextBlock x:Name="ActiveReferenceText" Style="{StaticResource BodyTextStyle}" />
                  </Border>
                  <Button Content="All refs" Click="ClearReference_Click" Style="{StaticResource CompactButtonStyle}" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="1" RowDefinitions="Auto,*">
              <Border x:Name="HistoryColumnHeader" Style="{StaticResource DenseColumnHeaderSurfaceStyle}">
                <Grid ColumnDefinitions="120,*,160,150,90">
                  <TextBlock Text="GRAPH" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="MESSAGE" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="AUTHOR" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="DATE" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="HASH" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ListView x:Name="HistoryList"
                        Grid.Row="1"
                        SelectedItem="{Binding SelectedHistoryRow, Mode=TwoWay}"
                        IsItemClickEnabled="False"
                        ItemContainerStyle="{StaticResource HistoryRowStyle}"
                        ItemTemplate="{StaticResource HistoryItemTemplate}" />
              <Button x:Name="LoadMoreHistoryButton"
                      Grid.Row="1"
                      Content="↓"
                      Click="LoadMoreHistory_Click"
                      Style="{StaticResource IconButtonStyle}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,8,8"
                      ToolTipService.ToolTip="Load more commits"
                      AutomationProperties.Name="Load more commits" />
            </Grid>

            <controls:GridSplitter Grid.Row="2"
                                   ResizeDirection="Rows"
                                   ResizeBehavior="PreviousAndNext"
                                   MinimumFirst="160"
                                   MinimumSecond="120"
                                   VerticalAlignment="Stretch"
                                   Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Pivot x:Name="DetailsTabs"
                   Grid.Row="3"
                   HeaderTemplate="{StaticResource PivotHeaderTemplate}"
                   Visibility="{Binding DetailsVisibility}">
              <Pivot.Resources>
                <Style TargetType="primitives:PivotHeaderItem" BasedOn="{StaticResource CompactPivotHeaderItemStyle}" />
              </Pivot.Resources>
              <PivotItem Header="Commit">
                <ScrollViewer x:Name="DetailsScroller"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto"
                              VerticalScrollBarVisibility="Auto"
                              MinHeight="120">
                  <StackPanel Padding="{StaticResource Padding.Form}" Spacing="{StaticResource Spacing.M}">
                    <TextBlock Text="{Binding SelectedCommit.Commit.Message}"
                               Style="{StaticResource SectionHeaderTextStyle}"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding SelectedCommit.Commit.References}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource ReferenceBadgeStyle}">
                            <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextStyle}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnDefinitions="74,*"
                          RowSpacing="{StaticResource Spacing.M}"
                          ColumnSpacing="{StaticResource Spacing.L}">
                      <TextBlock Text="Author" Style="{StaticResource SecondaryTextStyle}" />
                      <TextBlock Grid.Column="1" Text="{Binding SelectedCommit.Commit.Author}" Style="{StaticResource BodyTextStyle}" />
                      <TextBlock Grid.Row="1" Text="Date" Style="{StaticResource SecondaryTextStyle}" />
                      <controls:CommitTimeText Grid.Row="1" Grid.Column="1" Value="{Binding SelectedCommit.Commit.AuthoredAt}" FontSize="{StaticResource Font.Body}" />
                      <TextBlock Grid.Row="2" Text="Hash" Style="{StaticResource SecondaryTextStyle}" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCommit.Commit.Hash}" Style="{StaticResource DiffTextStyle}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="3" Text="Parents" Style="{StaticResource SecondaryTextStyle}" />
                      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCommit.Commit.ParentsDisplay}" Style="{StaticResource DiffTextStyle}" TextWrapping="Wrap" />
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </PivotItem>

              <PivotItem x:Name="FilesTab" Header="Changes">
                <Grid MinHeight="120" Loaded="ChangesSurface_Loaded">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38*" MinWidth="210" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="62*" MinWidth="270" />
                  </Grid.ColumnDefinitions>

                  <Grid RowDefinitions="Auto,*">
                    <Border x:Name="ChangedFilesHeader" Style="{StaticResource PaneHeaderSurfaceStyle}">
                      <Grid ColumnDefinitions="*,26,46,46">
                        <TextBlock Text="Changed files" Style="{StaticResource PaneHeaderTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="S" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="+" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="−" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <TreeView x:Name="ChangedFilesTree"
                              Grid.Row="1"
                              Style="{StaticResource DenseTreeViewStyle}"
                              ItemContainerStyle="{StaticResource ChangedFileRowStyle}"
                              ItemTemplate="{StaticResource ChangedFileTreeItemTemplate}"
                              SelectionMode="Single"
                              ItemInvoked="ChangedFilesTree_ItemInvoked" />

                    <ListView x:Name="CommitFilesList"
                              Grid.Row="1"
                              Visibility="Collapsed"
                              SelectionChanged="CommitFilesList_SelectionChanged"
                              DoubleTapped="CommitFilesList_DoubleTapped"
                              KeyDown="CommitFilesList_KeyDown" />
                  </Grid>

                  <controls:GridSplitter Grid.Column="1"
                                         ResizeDirection="Columns"
                                         ResizeBehavior="PreviousAndNext"
                                         MinimumFirst="210"
                                         MinimumSecond="270"
                                         HorizontalAlignment="Stretch"
                                         Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                  <Grid Grid.Column="2" RowDefinitions="Auto,*">
                    <Border Visibility="{Binding DiffVisibility}" Style="{StaticResource DiffHeaderSurfaceStyle}">
                      <Grid ColumnDefinitions="38,38,*">
                        <TextBlock Text="OLD"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,5,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="NEW"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,5,0"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                      <InfoBar IsOpen="True"
                               Severity="Informational"
                               Title="Binary file"
                               Message="Binary file — text diff is not available."
                               Visibility="{Binding BinaryVisibility}"
                               IsClosable="False"
                               VerticalAlignment="Top" />
                      <ListView x:Name="CompactDiffList"
                                Visibility="{Binding DiffVisibility}"
                                SelectionMode="None"
                                MinHeight="96"
                                ItemContainerStyle="{StaticResource DiffRowStyle}"
                                ItemTemplate="{StaticResource DiffItemTemplate}"
                                HorizontalContentAlignment="Stretch"
                                ScrollViewer.HorizontalScrollMode="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollMode="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                  </Grid>
                </Grid>
              </PivotItem>
            </Pivot>
          </Grid>

          <Grid x:Name="WorkingTreePane"
                Visibility="Collapsed"
                RowDefinitions="Auto,*,Auto"
                Padding="{StaticResource Padding.WorkspaceCompact}">
            <Grid x:Name="WorkingTreeHeader"
                  ColumnDefinitions="*,Auto"
                  MinHeight="{StaticResource Height.Control}"
                  Margin="0,0,0,4">
              <TextBlock Text="Working tree"
                         Style="{StaticResource PaneHeaderTextStyle}"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="Back to history"
                      Click="ShowHistory_Click"
                      Style="{StaticResource CompactButtonStyle}"
                      VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="330,4,*" MinHeight="180">
              <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="{StaticResource Spacing.S}" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" RowDefinitions="Auto,*">
                  <Grid MinHeight="{StaticResource Height.Control}" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.XS}">
                    <TextBlock x:Name="UnstagedHeader"
                               Text="Unstaged changes"
                               Style="{StaticResource BodyStrongTextStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Spacing.XS}">
                      <Button Command="{Binding StageSelectedCommand}"
                              Style="{StaticResource IconButtonStyle}"
                              ToolTipService.ToolTip="Stage selected"
                              AutomationProperties.Name="Stage selected">
                        <FontIcon Glyph="&#xE710;" FontSize="{StaticResource Icon.Small}" />
                      </Button>
                      <Button Command="{Binding StageAllCommand}"
                              Style="{StaticResource IconButtonStyle}"
                              ToolTipService.ToolTip="Stage all"
                              AutomationProperties.Name="Stage all">
                        <TextBlock Text="++" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                      </Button>
                      <Button Command="{Binding RequestDiscardCommand}"
                              Style="{StaticResource IconButtonStyle}"
                              ToolTipService.ToolTip="Discard selected changes"
                              AutomationProperties.Name="Discard selected changes">
                        <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource Icon.Small}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                  <ListView x:Name="UnstagedChangesList"
                            Grid.Row="1"
                            SelectionMode="Extended"
                            ItemContainerStyle="{StaticResource WorkingTreeRowStyle}"
                            ItemTemplate="{StaticResource UnstagedWorkingTreeItemTemplate}" />
                </Grid>

                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                  <Grid MinHeight="{StaticResource Height.Control}" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.XS}">
                    <TextBlock x:Name="StagedHeader"
                               Text="Staged changes"
                               Style="{StaticResource BodyStrongTextStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Spacing.XS}">
                      <Button Command="{Binding UnstageSelectedCommand}"
                              Style="{StaticResource IconButtonStyle}"
                              ToolTipService.ToolTip="Unstage selected"
                              AutomationProperties.Name="Unstage selected">
                        <TextBlock Text="−" Style="{StaticResource BodyStrongTextStyle}" />
                      </Button>
                      <Button Command="{Binding UnstageAllCommand}"
                              Style="{StaticResource IconButtonStyle}"
                              ToolTipService.ToolTip="Unstage all"
                              AutomationProperties.Name="Unstage all">
                        <TextBlock Text="−−" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                      </Button>
                    </StackPanel>
                  </Grid>
                  <ListView x:Name="StagedChangesList"
                            Grid.Row="1"
                            SelectionMode="Extended"
                            ItemContainerStyle="{StaticResource WorkingTreeRowStyle}"
                            ItemTemplate="{StaticResource StagedWorkingTreeItemTemplate}" />
                </Grid>
              </Grid>

              <controls:GridSplitter Grid.Column="1"
                                     ResizeDirection="Columns"
                                     ResizeBehavior="PreviousAndNext"
                                     MinimumFirst="220"
                                     MinimumSecond="280"
                                     HorizontalAlignment="Stretch"
                                     Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

              <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" Margin="8,0,0,0">
                <Border Style="{StaticResource PaneHeaderSurfaceStyle}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.L}">
                    <TextBlock x:Name="WorkingTreeDiffHeader"
                               Style="{StaticResource BodyStrongTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="WorkingTreeDiffKindText"
                               Grid.Column="1"
                               Style="{StaticResource SecondaryTextStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource DiffHeaderSurfaceStyle}">
                  <Grid ColumnDefinitions="38,38,*">
                    <TextBlock Text="OLD"
                               Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="NEW"
                               Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Grid Grid.Row="2">
                  <InfoBar x:Name="WorkingTreeBinaryInfo"
                           IsOpen="True"
                           Severity="Informational"
                           Title="Binary file"
                           Message="Binary file — text diff is not available."
                           Visibility="Collapsed"
                           IsClosable="False"
                           VerticalAlignment="Top" />
                  <InfoBar x:Name="WorkingTreeNoChangesInfo"
                           IsOpen="True"
                           Severity="Informational"
                           Title="No changes"
                           Message="The selected delta no longer exists."
                           Visibility="Collapsed"
                           IsClosable="False"
                           VerticalAlignment="Top" />
                  <ListView x:Name="WorkingTreeCompactDiffList"
                            Visibility="Collapsed"
                            SelectionMode="None"
                            ItemContainerStyle="{StaticResource DiffRowStyle}"
                            ItemTemplate="{StaticResource DiffItemTemplate}"
                            HorizontalContentAlignment="Stretch"
                            ScrollViewer.HorizontalScrollMode="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollMode="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
              </Grid>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,4,0,0">
              <StackPanel Spacing="{StaticResource Spacing.S}">
                <TextBlock Text="Commit message"
                           Style="{StaticResource BodyStrongTextStyle}" />
                <TextBox x:Name="CommitMessageEditor"
                         Text="{Binding CommitMessage, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontSize="{StaticResource Font.Body}"
                         MinHeight="{StaticResource Height.CommitEditor}"
                         AutomationProperties.Name="Commit message" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                  <Button Content="Commit" Command="{Binding CommitCommand}" Style="{StaticResource CompactButtonStyle}" />
                  <Button Content="Amend" Command="{Binding AmendCommand}" Style="{StaticResource CompactButtonStyle}" />
                </StackPanel>
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="The index is empty"
                         Message="Choose whether to stage all working-tree changes, create an intentional empty commit, or cancel. Nothing has been staged implicitly."
                         Visibility="{Binding EmptyIndexChoiceVisibility}"
                         IsClosable="False">
                  <InfoBar.ActionButton>
                    <Button Content="Stage all and commit" Command="{Binding StageAllAndCommitCommand}" Style="{StaticResource CompactButtonStyle}" />
                  </InfoBar.ActionButton>
                </InfoBar>
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource Spacing.S}"
                            Visibility="{Binding EmptyIndexChoiceVisibility}">
                  <Button Content="Create empty commit" Command="{Binding ConfirmEmptyCommitCommand}" Style="{StaticResource CompactButtonStyle}" />
                  <Button Content="Cancel" Command="{Binding CancelCommitCommand}" Style="{StaticResource CompactButtonStyle}" />
                </StackPanel>
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="Confirm discarding unstaged changes"
                         Message="{Binding DiscardConfirmationMessage}"
                         Visibility="{Binding DiscardConfirmationVisibility}"
                         IsClosable="False">
                  <InfoBar.ActionButton>
                    <Button Content="Confirm discard" Command="{Binding ConfirmDiscardCommand}" Style="{StaticResource CompactButtonStyle}" />
                  </InfoBar.ActionButton>
                </InfoBar>
                <Button Content="Cancel discard"
                        Command="{Binding CancelDiscardCommand}"
                        Visibility="{Binding DiscardConfirmationVisibility}"
                        Style="{StaticResource CompactButtonStyle}"
                        HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <Border x:Name="StatusBar" Grid.Row="3" Style="{StaticResource StatusBarSurfaceStyle}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="{StaticResource Spacing.XL}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.M}" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE8F0;" FontSize="{StaticResource Icon.Small}" />
            <TextBlock x:Name="StatusBranchText" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="StatusTrackingText" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusChangesText" Grid.Column="2" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="{StaticResource Spacing.M}" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource Icon.Small}" Opacity="0.66" />
            <TextBlock x:Name="StatusOperationText" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <InfoBar IsOpen="{Binding HasError}"
             Severity="Error"
             Title="Error"
             Message="{Binding ErrorMessage}"
             IsClosable="False"
             VerticalAlignment="Bottom"
             Margin="16,0,16,26" />
  </Grid>
</Page>