<UserControl
    x:Class="CSharpGit.Presentation.RecentRepositoriesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CSharpGit.Presentation.Controls">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <ItemsPanelTemplate x:Key="RecentRepositoriesItemsPanelTemplate">
      <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="268" ItemHeight="120" />
    </ItemsPanelTemplate>

    <Style x:Key="RepositoryTileOpenButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="UseSystemFocusVisuals" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CardSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="CardSurface.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="CardSurface.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                  <VisualState x:Name="Unfocused" />
                  <VisualState x:Name="PointerFocused" />
                  <VisualState x:Name="Focused">
                    <VisualState.Setters>
                      <Setter Target="CardSurface.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RecentRepositoryGridItemStyle" TargetType="GridViewItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewItem">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="RecentRepositoryTileTemplate">
      <!-- Right/bottom margins are the 8 DIP inter-card gutters, included in ItemsWrapGrid cells. -->
      <Grid Margin="0,0,8,8" Opacity="{Binding TileOpacity}">
        <Grid.ContextFlyout>
          <MenuFlyout Opening="RepositoryContextFlyout_Opening" />
        </Grid.ContextFlyout>

        <!-- The open target sits behind non-hit-testable text/media; Pin/Remove are siblings,
             not nested buttons, and have their own keyboard and pointer hit targets. -->
        <Button Command="{Binding OpenCommand}"
                Style="{StaticResource RepositoryTileOpenButtonStyle}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ToolTipService.ToolTip="{Binding TileDescription}"
                AutomationProperties.Name="{Binding DisplayName}"
                AutomationProperties.HelpText="{Binding TileDescription}" />

        <Grid x:Name="RepositoryTileLayout"
              Padding="8"
              ColumnDefinitions="72,*"
              ColumnSpacing="8"
              Loaded="RepositoryTileLayout_Loaded"
              Unloaded="RepositoryTileLayout_Unloaded"
              DataContextChanged="RepositoryTileLayout_DataContextChanged"
              SizeChanged="RepositoryTileLayout_SizeChanged">
          <!-- Wide Preview is drawn flush against the card's left edge, without
               a framed media slot or padding. Compact icons retain their backdrop. -->
          <Border x:Name="RepositoryTileMedia"
                  Grid.Column="0"
                  Width="72" Height="72"
                  CornerRadius="8"
                  Background="Transparent"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False">
            <Grid>
              <Border x:Name="RepositoryTileCompactMediaBackground"
                      CornerRadius="8"
                      Background="{ThemeResource ControlFillColorSecondaryBrush}" />
              <FontIcon Glyph="{StaticResource Icon.Glyph.Open}"
                        FontSize="26"
                        Opacity="{Binding RepositoryGlyphOpacity}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
              <Image Source="{Binding RepositoryImage}"
                     Width="56" Height="56"
                     Stretch="Uniform"
                     Opacity="{Binding RepositoryImageOpacity}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
              <Image Source="{Binding RepositoryPreview}"
                     Stretch="Uniform"
                     Opacity="{Binding RepositoryPreviewOpacity}"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch" />
              <!-- Keep the bitmap candidate in the live visual tree until decode
                   finishes. Never use Collapsed for the decoder. -->
              <Image Source="{Binding RepositoryCandidate}"
                     Width="1" Height="1"
                     Opacity="0.001"
                     IsHitTestVisible="False" />
            </Grid>
          </Border>
          <Grid x:Name="RepositoryTileText"
                Grid.Column="1"
                ColumnDefinitions="*,Auto"
                RowDefinitions="32,Auto,*">
            <TextBlock Text="{Binding DisplayName}"
                       Style="{StaticResource BodyStrongTextStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="{StaticResource Spacing.XS}">
              <Button Click="RepositoryPin_Click"
                      Style="{StaticResource RepositoryTileActionButtonStyle}"
                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                      ToolTipService.ToolTip="{Binding PinActionLabel}"
                      AutomationProperties.Name="{Binding PinActionLabel}">
                <FontIcon Glyph="{Binding PinGlyph}"
                          FontSize="{StaticResource Icon.Small}"
                          Opacity="{Binding PinIndicatorOpacity}" />
              </Button>
              <Button Click="RepositoryRemove_Click"
                      Style="{StaticResource RepositoryTileActionButtonStyle}"
                      ToolTipService.ToolTip="Remove from recent"
                      AutomationProperties.Name="Remove from recent">
                <FontIcon Glyph="&#xE711;" FontSize="{StaticResource Icon.Small}" />
              </Button>
            </StackPanel>
            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Text="{Binding Path}"
                       Style="{StaticResource TechnicalSecondaryTextStyle}"
                       Margin="0,2,0,0"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />
            <TextBlock Grid.Row="2"
                       Grid.ColumnSpan="2"
                       Text="{Binding Metadata}"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False" />
          </Grid>
        </Grid>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="{StaticResource Padding.Page}"
                  Spacing="{StaticResource Spacing.XL}"
                  HorizontalAlignment="Stretch">
        <TextBlock Text="Repositories" Style="{StaticResource TitleTextStyle}" />

        <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="RepositorySearch_KeyDown"
                 PlaceholderText="Search by name or path…"
                 Style="{StaticResource CompactTextBoxStyle}"
                 AutomationProperties.Name="Search repositories by name or path" />

        <ItemsControl ItemsSource="{Binding Groups}"
                      HorizontalAlignment="Stretch">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="{StaticResource Spacing.S}"
                          HorizontalAlignment="Stretch"
                          Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="{StaticResource Spacing.S}">
                  <ToggleButton Click="GroupExpand_Click"
                          IsChecked="{Binding EffectiveIsExpanded, Mode=OneWay}"
                          IsEnabled="{Binding CanToggleExpanded}"
                          HorizontalAlignment="Left"
                          Background="Transparent"
                          BorderThickness="0"
                          UseSystemFocusVisuals="True"
                          AutomationProperties.Name="{Binding ExpansionActionLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                      <FontIcon Glyph="{Binding ExpandGlyph}"
                                FontSize="{StaticResource Icon.Small}" />
                      <TextBlock Text="{Binding Heading}"
                                 Style="{StaticResource BodyStrongTextStyle}"
                                 MaxWidth="600"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </ToggleButton>
                  <Button Grid.Column="1"
                          Content="&#x2026;"
                          Click="GroupActions_Click"
                          Style="{StaticResource IconButtonStyle}"
                          AutomationProperties.Name="{Binding ActionsLabel}"
                          ToolTipService.ToolTip="{Binding ActionsLabel}"
                          VerticalAlignment="Center" />
                </Grid>
                <controls:RepositoryTileGridView ItemsSource="{Binding Repositories}"
                          Visibility="{Binding EffectiveIsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          CanDragItems="True"
                          CanReorderItems="False"
                          AllowDrop="True"
                          DragItemsStarting="PinnedRepositoriesGridView_DragItemsStarting"
                          DragOver="PinnedRepositoriesGridView_DragOver"
                          DragLeave="PinnedRepositoriesGridView_DragLeave"
                          Drop="PinnedRepositoriesGridView_Drop"
                          DragItemsCompleted="PinnedRepositoriesGridView_DragItemsCompleted"
                          HorizontalAlignment="Stretch"
                          Padding="0"
                          ItemsPanel="{StaticResource RecentRepositoriesItemsPanelTemplate}"
                          ItemContainerStyle="{StaticResource RecentRepositoryGridItemStyle}"
                          ItemTemplate="{StaticResource RecentRepositoryTileTemplate}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="{StaticResource Spacing.S}"
                    Visibility="{Binding HasRecentRepositories, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ToggleButton Click="RecentExpand_Click"
                        IsChecked="{Binding EffectiveIsRecentExpanded, Mode=OneWay}"
                        IsEnabled="{Binding CanToggleRecentExpanded}"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        UseSystemFocusVisuals="True"
                        AutomationProperties.Name="{Binding RecentExpansionActionLabel}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
              <FontIcon Glyph="{Binding RecentExpandGlyph}" FontSize="{StaticResource Icon.Small}" />
              <TextBlock Text="{Binding RecentHeading}"
                         Style="{StaticResource BodyStrongTextStyle}" />
            </StackPanel>
          </ToggleButton>
          <controls:RepositoryTileGridView x:Name="RecentRepositoriesGridView"
                                               Visibility="{Binding EffectiveIsRecentExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               ItemsSource="{Binding RecentRepositories}"
                                               SelectionMode="None"
                                               IsItemClickEnabled="False"
                                               CanDragItems="False"
                                               HorizontalAlignment="Stretch"
                                               Padding="0"
                                               ItemsPanel="{StaticResource RecentRepositoriesItemsPanelTemplate}"
                                               ItemContainerStyle="{StaticResource RecentRepositoryGridItemStyle}"
                                               ItemTemplate="{StaticResource RecentRepositoryTileTemplate}" />
        </StackPanel>

        <TextBlock Text="No repositories match your search."
                   Style="{StaticResource BodySubduedTextStyle}"
                   Visibility="{Binding ShowNoSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <ItemsControl HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="252" ItemHeight="94" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <Button Command="{Binding OpenRepositoryCommand}"
                  Width="240" Height="82"
                  Margin="0,0,12,12"
                  Padding="{StaticResource Padding.Form}"
                  Style="{StaticResource PrimaryActionButtonStyle}"
                  HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="42,*" ColumnSpacing="{StaticResource Spacing.XL}">
              <FontIcon Glyph="{StaticResource Icon.Glyph.Open}" FontSize="24" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="{StaticResource Spacing.XS}" VerticalAlignment="Center">
                <TextBlock Text="Open repository" Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="Choose a folder…" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </Grid>
          </Button>

          <Button Command="{Binding CloneRepositoryCommand}"
                  Width="240" Height="82"
                  Margin="0,0,12,12"
                  Padding="{StaticResource Padding.Form}"
                  Style="{StaticResource SecondaryActionButtonStyle}"
                  HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="42,*" ColumnSpacing="{StaticResource Spacing.XL}">
              <FontIcon Glyph="{StaticResource Icon.Glyph.Clone}" FontSize="24" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="{StaticResource Spacing.XS}" VerticalAlignment="Center">
                <TextBlock Text="Clone repository" Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="Clone from a remote URL…" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </Grid>
          </Button>

          <Button Command="{Binding CreateRepositoryCommand}"
                  Width="240" Height="82"
                  Margin="0,0,12,12"
                  Padding="{StaticResource Padding.Form}"
                  Style="{StaticResource SecondaryActionButtonStyle}"
                  HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="42,*" ColumnSpacing="{StaticResource Spacing.XL}">
              <FontIcon Glyph="{StaticResource Icon.Glyph.Create}" FontSize="24" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="{StaticResource Spacing.XS}" VerticalAlignment="Center">
                <TextBlock Text="Create repository" Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="Create a new local repository…" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </Grid>
          </Button>

          <Button Command="{Binding RemoveUnavailableRepositoriesCommand}"
                  IsEnabled="{Binding HasUnavailableRepositories}"
                  Width="240" Height="82"
                  Margin="0,0,12,12"
                  Padding="{StaticResource Padding.Form}"
                  Style="{StaticResource DestructiveActionButtonStyle}"
                  HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="42,*" ColumnSpacing="{StaticResource Spacing.XL}">
              <FontIcon Glyph="{StaticResource Icon.Glyph.Discard}" FontSize="24" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="{StaticResource Spacing.XS}" VerticalAlignment="Center">
                <TextBlock Text="Remove missing" Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="Clean up recent list" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </Grid>
          </Button>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
