<UserControl x:Class="CSharpGit.Presentation.Controls.InteractiveRebaseTodoEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="GutterColumn" Width="48" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,1">
      <TextBox x:Name="LineNumberGutter"
               Style="{StaticResource TechnicalMultilineTextBoxStyle}"
               IsReadOnly="True"
               IsHitTestVisible="False"
               IsTabStop="False"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               TextAlignment="Right"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               Background="Transparent"
               BorderThickness="0"
               Padding="6,4"
               ScrollViewer.HorizontalScrollMode="Disabled"
               ScrollViewer.VerticalScrollMode="Enabled"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Hidden" />
    </Border>

    <Border Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">
      <Grid>
        <TextBox x:Name="Editor"
                 Style="{StaticResource TechnicalMultilineTextBoxStyle}"
                 TextChanged="Editor_TextChanged"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 BorderThickness="0"
                 Padding="8,4"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 ScrollViewer.HorizontalScrollMode="Enabled"
                 ScrollViewer.VerticalScrollMode="Enabled"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Interactive rebase todo" />

        <TextBox x:Name="ExecutableTextOverlay"
                 Style="{StaticResource TechnicalMultilineTextBoxStyle}"
                 IsReadOnly="True"
                 IsHitTestVisible="False"
                 IsTabStop="False"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="8,4"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 ScrollViewer.HorizontalScrollMode="Enabled"
                 ScrollViewer.VerticalScrollMode="Enabled"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
