<UserControl x:Class="CSharpGit.Presentation.Controls.GitCommandFeedbackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="FeedbackSurface"
          Style="{StaticResource FeedbackSurfaceStyle}"
          PointerEntered="Surface_PointerEntered"
          PointerExited="Surface_PointerExited"
          GotFocus="Surface_GotFocus"
          LostFocus="Surface_LostFocus">
    <StackPanel Spacing="{StaticResource Spacing.L}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.L}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.L}">
          <ProgressRing x:Name="RunningRing" Width="16" Height="16" IsActive="False" />
          <TextBlock Text="Git command" Style="{StaticResource BodyStrongTextStyle}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Column="1"
                   Style="{StaticResource BodyTextStyle}"
                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </Grid>
      <TextBox x:Name="CommandText"
               IsReadOnly="True"
               TextWrapping="Wrap"
               MaxHeight="56"
               Style="{StaticResource TechnicalMultilineTextBoxStyle}"
               AutomationProperties.Name="Git command" />
      <TextBox x:Name="OutputText"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               MinHeight="70"
               MaxHeight="110"
               Style="{StaticResource TechnicalMultilineTextBoxStyle}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               AutomationProperties.Name="Git output preview" />
      <TextBlock x:Name="ResultDetails" Style="{StaticResource SecondaryTextStyle}" />
      <TextBlock x:Name="HintText" TextWrapping="Wrap"
                 Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
      <StackPanel Style="{StaticResource FormActionRowStyle}">
        <Button Content="Copy command" AutomationProperties.Name="Copy command"
                Style="{StaticResource SecondaryActionButtonStyle}" Click="Copy_Click" />
        <Button Content="Open Git Console" AutomationProperties.Name="Open Git Console"
                Style="{StaticResource SecondaryActionButtonStyle}" Click="OpenConsole_Click" />
        <Button x:Name="DismissButton" AutomationProperties.Name="Hide"
                Style="{StaticResource SecondaryActionButtonStyle}" Click="Dismiss_Click">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.L}">
            <TextBlock x:Name="DismissButtonLabel" Text="Hide" VerticalAlignment="Center" />
            <Grid x:Name="AutoCloseIndicator" Width="28" Height="28" Visibility="Collapsed"
                  ToolTipService.ToolTip="Press Esc to cancel auto-close. Countdown pauses during interaction.">
              <Ellipse Width="22" Height="22" StrokeThickness="3"
                       Stroke="{ThemeResource SystemFillColorSuccessBrush}" Opacity="0.25" />
              <Path x:Name="AutoCloseCountdownArc" StrokeThickness="3"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Stroke="{ThemeResource SystemFillColorSuccessBrush}" />
              <TextBlock x:Name="AutoCloseTimeText" Text="5s" Style="{StaticResource BodyTextStyle}"
                         FontSize="{StaticResource Font.Caption}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
            </Grid>
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
