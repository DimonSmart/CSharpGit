<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="CompactButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Control}" />
    <Setter Property="Padding" Value="{StaticResource Padding.Control}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
    <Setter Property="Padding" Value="{StaticResource Padding.Control}" />
  </Style>

  <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
    <Setter Property="Width" Value="{StaticResource Height.Control}" />
    <Setter Property="Height" Value="{StaticResource Height.Control}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="CompactTextBoxStyle" TargetType="TextBox">
    <Setter Property="MinHeight" Value="{StaticResource Height.Control}" />
    <Setter Property="Padding" Value="{StaticResource Padding.Control}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
  </Style>

  <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox">
    <Setter Property="MinHeight" Value="{StaticResource Height.Control}" />
    <Setter Property="Padding" Value="{StaticResource Padding.Control}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
  </Style>

  <Style x:Key="FormHeaderSurfaceStyle" TargetType="Border">
    <Setter Property="MinHeight" Value="{StaticResource Height.Toolbar}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style x:Key="FormNavigationItemStyle" TargetType="ListViewItem">
    <Setter Property="MinHeight" Value="{StaticResource Height.Control}" />
    <Setter Property="Padding" Value="{StaticResource Padding.DenseRow}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="FormListItemStyle" TargetType="ListViewItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="{StaticResource Margin.ListItem}" />
  </Style>

  <Style x:Key="FormCardStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="{StaticResource Padding.Form}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
</ResourceDictionary>
