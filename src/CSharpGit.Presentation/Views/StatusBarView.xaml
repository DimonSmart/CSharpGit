<UserControl x:Class="CSharpGit.Presentation.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
      <Border Style="{StaticResource StatusBarSurfaceStyle}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,420" ColumnSpacing="{StaticResource Spacing.XL}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.M}" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE8F0;" FontSize="{StaticResource Icon.Small}" />
            <TextBlock x:Name="StatusBranchText" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="StatusTrackingText" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusChangesText" Grid.Column="2" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
          <Border x:Name="StatusOperationContainer"
                  Grid.Column="4"
                  Padding="8,2"
                  CornerRadius="6">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Spacing.S}"
                        VerticalAlignment="Center">
              <FontIcon x:Name="StatusOperationIdleIcon"
                        Glyph="&#xE73E;"
                        FontSize="{StaticResource Icon.Small}"
                        Opacity="0.66" />
              <Ellipse x:Name="BusyPulseDot"
                       Width="8"
                       Height="8"
                       Fill="#22C55E"
                       Opacity="1"
                       Visibility="Collapsed" />
              <TextBlock x:Name="StatusOperationText"
                         Style="{StaticResource BodyStrongTextStyle}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button x:Name="GitCommandStatusButton" Grid.Column="5"
                  Padding="6,1,6,1"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Background="Transparent" BorderThickness="0"
                  Click="GitCommandStatusButton_Click"
                  ToolTipService.ToolTip="No Git commands recorded in this session."
                  AutomationProperties.Name="Git command status">
            <TextBlock x:Name="GitCommandStatusText"
                       Text="No Git commands"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       MaxWidth="410"
                       Opacity="0.82" />
          </Button>
        </Grid>
      </Border>
</UserControl>
