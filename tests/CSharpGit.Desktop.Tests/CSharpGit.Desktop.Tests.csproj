<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CSharpGit.Application/CSharpGit.Application.csproj" />
    <ProjectReference Include="../../src/CSharpGit.Domain/CSharpGit.Domain.csproj" />
    <Compile Include="../../src/CSharpGit.Presentation/RepositoryChangeMonitor.cs" Link="RepositoryChangeMonitor.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/Controls/CommitTimeFormatter.cs" Link="CommitTime/CommitTimeFormatter.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/Controls/CommitGraph/CommitGraphRowVisual.cs" Link="CommitGraph/CommitGraphRowVisual.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/Controls/CommitGraph/CommitGraphMetrics.cs" Link="CommitGraph/CommitGraphMetrics.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/Controls/CommitGraph/CommitGraphGeometryBuilder.cs" Link="CommitGraph/CommitGraphGeometryBuilder.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/ChangedFileTreeNode.cs" Link="Changes/ChangedFileTreeNode.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/CompactDiffLine.cs" Link="Changes/CompactDiffLine.cs" />
  </ItemGroup>
  <!-- The test launches the binary, so build it without creating a TFM-incompatible assembly reference. -->
  <Target Name="BuildDesktopApplication" BeforeTargets="Build">
    <MSBuild Projects="../../src/CSharpGit.Presentation/CSharpGit.Presentation.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained"
             BuildInParallel="false" />
  </Target>
</Project>
