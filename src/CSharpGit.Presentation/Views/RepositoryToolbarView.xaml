<UserControl x:Class="CSharpGit.Presentation.Views.RepositoryToolbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CSharpGit.Presentation.Controls">
  <UserControl.Resources>
    <controls:BranchTrackingActionTextConverter x:Key="BranchTrackingActionTextConverter" />
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
      <Border Style="{StaticResource ToolbarSurfaceStyle}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Spacing.M}">
          <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.XS}" VerticalAlignment="Center">
            <Button x:Name="CommitNavigationButton"
                    Click="CommitNavigation_Click"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    AutomationProperties.Name="Commit changes">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                <FontIcon Glyph="{StaticResource Icon.Glyph.Commit}" FontSize="{StaticResource Icon.Small}" />
                <TextBlock x:Name="CommitNavigationText" Text="Commit (0)" Style="{StaticResource BodyTextStyle}" />
              </StackPanel>
            </Button>
            <Button Click="Fetch_Click"
                    IsEnabled="{Binding RepositorySync.CanFetch}"
                    Style="{StaticResource SecondaryActionButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                <FontIcon Glyph="{StaticResource Icon.Glyph.Fetch}" FontSize="{StaticResource Icon.Small}" />
                <TextBlock Text="Fetch" Style="{StaticResource BodyTextStyle}" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal"
                        Spacing="0"
                        ToolTipService.ToolTip="{Binding RepositorySync.PullTooltip}">
              <Button x:Name="PullPrimaryButton"
                      Click="Pull_Click"
                      IsEnabled="{Binding RepositorySync.CanPull}"
                      Style="{StaticResource SecondaryActionButtonStyle}"
                      AutomationProperties.Name="{Binding RepositorySync.PullAccessibleName}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                  <FontIcon Glyph="{StaticResource Icon.Glyph.Pull}" FontSize="{StaticResource Icon.Small}" />
                  <TextBlock Text="{Binding RepositorySync.PullButtonText}"
                             Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
              </Button>
              <Button x:Name="PullMenuButton"
                      Style="{StaticResource ToolbarButtonStyle}"
                      Padding="6,0"
                      AutomationProperties.Name="Pull strategies and settings">
                <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource Icon.Small}" />
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Text="Fast-forward only"
                                    Click="PullFastForwardOnly_Click"
                                    IsEnabled="{Binding RepositorySync.CanPull}"
                                    AutomationProperties.Name="{Binding RepositorySync.FastForwardPullAccessibleName}">
                      <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE73E;"
                                  Visibility="{Binding RepositorySync.IsFastForwardOnlyDefault, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Merge"
                                    Click="PullMerge_Click"
                                    IsEnabled="{Binding RepositorySync.CanPull}"
                                    AutomationProperties.Name="{Binding RepositorySync.MergePullAccessibleName}">
                      <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE73E;"
                                  Visibility="{Binding RepositorySync.IsMergeDefault, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Rebase"
                                    Click="PullRebase_Click"
                                    IsEnabled="{Binding RepositorySync.CanPull}"
                                    AutomationProperties.Name="{Binding RepositorySync.RebasePullAccessibleName}">
                      <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE73E;"
                                  Visibility="{Binding RepositorySync.IsRebaseDefault, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Pull settings…"
                                    Click="PullSettings_Click"
                                    AutomationProperties.Name="Open Pull settings" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Spacing="0"
                        ToolTipService.ToolTip="{Binding RepositorySync.PushTooltip}">
              <Button x:Name="PushPrimaryButton"
                      Click="PushPrimary_Click"
                      IsEnabled="{Binding RepositorySync.CanPrimaryPush}"
                      Style="{StaticResource SecondaryActionButtonStyle}"
                      AutomationProperties.Name="{Binding RepositorySync.PushAccessibleName}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.S}">
                  <FontIcon Glyph="{StaticResource Icon.Glyph.Push}" FontSize="{StaticResource Icon.Small}" />
                  <TextBlock Text="{Binding RepositorySync.PushButtonText}"
                             Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
              </Button>
              <Button x:Name="PushMenuButton"
                      Style="{StaticResource ToolbarButtonStyle}"
                      Padding="6,0"
                      AutomationProperties.Name="Push actions and default action">
                <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource Icon.Small}" />
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Text="{Binding Branches.SelectedLocalBranch, Converter={StaticResource BranchTrackingActionTextConverter}, ConverterParameter=PushMenu}"
                                    Click="Push_Click"
                                    IsEnabled="{Binding RepositorySync.CanPush}" />
                    <MenuFlyoutItem Text="Push to…"
                                    Click="PushTo_Click"
                                    IsEnabled="{Binding RepositorySync.CanPushTo}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Force push with lease…"
                                    Click="ForcePushWithLease_Click"
                                    IsEnabled="{Binding RepositorySync.CanForcePushWithLease}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="Default action">
                      <MenuFlyoutItem Text="Push" Click="PushSetDefault_Click">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xE73E;"
                                    Visibility="{Binding RepositorySync.IsPushDefault, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem Text="Push to…" Click="PushToSetDefault_Click">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xE73E;"
                                    Visibility="{Binding RepositorySync.IsPushToDefault, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem Text="Force push with lease…" Click="ForcePushWithLeaseSetDefault_Click">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xE73E;"
                                    Visibility="{Binding RepositorySync.IsForcePushWithLeaseDefault, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyoutSubItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
            <Button x:Name="RefreshButton"
                    Click="RefreshIndicator_Click"
                    IsEnabled="{Binding CanChangeRepository}"
                    Style="{StaticResource IconButtonStyle}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Refresh repository."
                    AutomationProperties.Name="Refresh repository">
              <Grid Width="16" Height="16">
                <FontIcon x:Name="RefreshIcon"
                          Glyph="{StaticResource Icon.Glyph.Refresh}"
                          FontSize="{StaticResource Icon.Normal}"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <FontIcon x:Name="RefreshRequiredIcon"
                          Glyph="{StaticResource Icon.Glyph.Refresh}"
                          FontSize="{StaticResource Icon.Normal}"
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed" />
                <ProgressRing x:Name="RefreshProgressRing"
                              IsActive="False"
                              Visibility="Collapsed"
                              Width="16"
                              Height="16" />
              </Grid>
            </Button>
          </StackPanel>
          </ScrollViewer>
          <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Application menu">
            <FontIcon Glyph="&#xE712;" FontSize="{StaticResource Icon.Normal}" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="Open repository…"
                                Click="OpenRepository_Click"
                                IsEnabled="{Binding CanChangeRepository}" />
                <MenuFlyoutItem Text="Clone repository…"
                                Click="CloneRepository_Click"
                                IsEnabled="{Binding CanChangeRepository}" />
                <MenuFlyoutItem Text="Create repository…"
                                Click="CreateRepository_Click"
                                IsEnabled="{Binding CanChangeRepository}" />
                <MenuFlyoutItem Text="Repositories…"
                                Click="Repositories_Click"
                                IsEnabled="{Binding CanChangeRepository}" />
                <MenuFlyoutItem Text="Close repository"
                                Click="CloseRepository_Click"
                                IsEnabled="{Binding CanChangeRepository}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Repository settings…"
                                Click="RepositorySettings_Click" />
                <MenuFlyoutItem x:Name="OptimizeRepositoryMenuItem"
                                Text="Optimize repository…"
                                Click="OptimizeRepository_Click"
                                IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Settings…" Click="Settings_Click" />
                <MenuFlyoutItem Text="About CSharpGit…" Click="About_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>

        </Grid>
      </Border>
</UserControl>
