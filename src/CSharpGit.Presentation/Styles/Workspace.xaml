<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CSharpGit.Presentation.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

  <controls:CommitTopologyToGraphVisualConverter x:Key="CommitTopologyToGraphVisualConverter" />
  <controls:DiffLineKindToBrushConverter x:Key="DiffLineKindToBrushConverter" />

  <Thickness x:Key="Margin.ReferenceList">6,0,0,0</Thickness>
  <Thickness x:Key="Margin.ReferenceBadge">0,0,3,0</Thickness>
  <Thickness x:Key="Padding.ReferenceBadge">4,1</Thickness>
  <Thickness x:Key="Margin.WorkspaceSection">0,0,0,2</Thickness>
  <Thickness x:Key="Margin.WorkspaceActions">0,2,0,0</Thickness>
  <Thickness x:Key="Margin.DiffNumber">0,0,5,0</Thickness>
  <Thickness x:Key="Margin.HistoryColumnGap">4,0,0,0</Thickness>
  <Thickness x:Key="Padding.DiffText">5,0</Thickness>
  <Thickness x:Key="Padding.CompactPivotHeader">8,0</Thickness>

  <Style x:Key="ReferenceBadgeStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="{StaticResource Padding.ReferenceBadge}" />
    <Setter Property="Margin" Value="{StaticResource Margin.ReferenceBadge}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="ToolbarSurfaceStyle" TargetType="Border">
    <Setter Property="MinHeight" Value="{StaticResource Height.Toolbar}" />
    <Setter Property="Padding" Value="{StaticResource Padding.Toolbar}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style x:Key="PaneHeaderSurfaceStyle" TargetType="Border">
    <Setter Property="MinHeight" Value="{StaticResource Height.Header}" />
    <Setter Property="Padding" Value="{StaticResource Padding.PaneHeader}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style x:Key="DenseColumnHeaderSurfaceStyle" TargetType="Border">
    <Setter Property="MinHeight" Value="{StaticResource Height.ColumnHeader}" />
    <Setter Property="Padding" Value="{StaticResource Padding.PaneHeader}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style x:Key="DiffHeaderSurfaceStyle" TargetType="Border">
    <Setter Property="MinHeight" Value="{StaticResource Height.DiffRow}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style x:Key="StatusBarSurfaceStyle" TargetType="Border">
    <Setter Property="MinHeight" Value="{StaticResource Height.StatusBar}" />
    <Setter Property="Padding" Value="{StaticResource Padding.Toolbar}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style x:Key="DenseListItemStyle"
         TargetType="ListViewItem"
         BasedOn="{StaticResource ListViewItemExpanded}">
    <Setter Property="MinHeight" Value="{StaticResource Height.DataRow}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Padding.DenseRow}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="WorkingTreeRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DenseListItemStyle}" />

  <Style x:Key="HistoryRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DenseListItemStyle}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="DenseTreeViewStyle" TargetType="TreeView">
    <Setter Property="Padding" Value="2,0,2,2" />
  </Style>

  <Style x:Key="DenseTreeItemStyle" TargetType="TreeViewItem">
    <Setter Property="MinHeight" Value="{StaticResource Height.DataRow}" />
    <Setter Property="Padding" Value="1,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="GlyphOpacity" Value="0" />
  </Style>

  <Style x:Key="RepositoryTreeItemStyle"
         TargetType="TreeViewItem"
         BasedOn="{StaticResource DenseTreeItemStyle}">
    <Setter Property="GlyphOpacity" Value="0" />
  </Style>

  <Style x:Key="ChangedFileRowStyle" TargetType="TreeViewItem" BasedOn="{StaticResource DenseTreeItemStyle}">
    <Setter Property="GlyphOpacity" Value="1" />
  </Style>

  <Style x:Key="DiffRowStyle" TargetType="ListViewItem">
    <Setter Property="MinHeight" Value="{StaticResource Height.DiffRow}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CompactPivotHeaderItemStyle" TargetType="primitives:PivotHeaderItem">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Padding.CompactPivotHeader}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <DataTemplate x:Key="PivotHeaderTemplate">
    <Grid MinHeight="{StaticResource Height.TabHeader}">
      <TextBlock Text="{Binding}"
                 Style="{StaticResource BodyStrongTextStyle}"
                 Margin="2,0"
                 VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="HistoryItemTemplate">
    <Grid ColumnDefinitions="120,*,160,150,90"
          MinHeight="{StaticResource Height.DataRow}"
          Padding="{StaticResource Padding.DenseRow}">
      <controls:CommitGraphControl Graph="{Binding Topology, Converter={StaticResource CommitTopologyToGraphVisualConverter}}"
                                   VerticalAlignment="Stretch" />
      <Grid Grid.Column="1" ColumnDefinitions="Auto,*" MinWidth="120">
        <TextBlock Text="{Binding Commit.Subject}"
                   Style="{StaticResource BodyStrongTextStyle}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <ItemsControl Grid.Column="1"
                      ItemsSource="{Binding Commit.References}"
                      Margin="{StaticResource Margin.ReferenceList}"
                      VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource ReferenceBadgeStyle}">
                <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextStyle}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      <TextBlock Grid.Column="2"
                 Text="{Binding Commit.Author}"
                 Style="{StaticResource BodyTextStyle}"
                 Margin="{StaticResource Margin.HistoryColumnGap}"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
      <controls:CommitTimeText Grid.Column="3"
                               Value="{Binding Commit.AuthoredAt}"
                               Margin="{StaticResource Margin.HistoryColumnGap}"
                               FontSize="{StaticResource Font.Caption}"
                               VerticalAlignment="Center" />
      <TextBlock Grid.Column="4"
                 Text="{Binding Commit.ShortHash}"
                 Style="{StaticResource DiffSecondaryTextStyle}"
                 Margin="{StaticResource Margin.HistoryColumnGap}"
                 VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="RepositoryTreeItemTemplate">
    <TreeViewItem x:Name="RepositoryTreeItem"
                  ItemsSource="{Binding Children}"
                  IsExpanded="{Binding IsExpanded, Mode=OneWay}"
                  Style="{StaticResource RepositoryTreeItemStyle}">
      <TreeViewItem.Content>
        <Grid ColumnDefinitions="2,*" MinHeight="{StaticResource Height.DataRow}">
          <Border Grid.ColumnSpan="2"
                  Background="{ThemeResource AccentFillColorDefaultBrush}"
                  Opacity="0.12"
                  Visibility="{Binding CurrentBranchAccentVisibility}"
                  IsHitTestVisible="False" />
          <Border Width="2"
                  Background="{ThemeResource AccentFillColorDefaultBrush}"
                  HorizontalAlignment="Left"
                  Visibility="{Binding CurrentBranchAccentVisibility}"
                  IsHitTestVisible="False" />
          <controls:RepositoryTreeGuides Grid.Column="1"
                                         Segments="{Binding HierarchyGuideSegments}"
                                         TotalIndentation="{Binding TemplateSettings.Indentation.Left, ElementName=RepositoryTreeItem}"
                                         RowHeight="{StaticResource Height.DataRow}"
                                         ExpandTarget="{Binding ElementName=RepositoryTreeItem}"
                                         IsExpanded="{Binding IsExpanded, ElementName=RepositoryTreeItem}"
                                         LineBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                         NodeFillBrush="{ThemeResource ControlFillColorDefaultBrush}"
                                         GlyphBrush="{ThemeResource TextFillColorPrimaryBrush}" />
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="{StaticResource Spacing.S}"
                      VerticalAlignment="Center">
            <FontIcon Glyph="&#xE80F;"
                      FontSize="{StaticResource Icon.Normal}"
                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                      Visibility="{Binding CurrentLocalBranchIconVisibility}" />
            <FontIcon Glyph="&#xE80F;"
                      FontSize="{StaticResource Icon.Normal}"
                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                      Visibility="{Binding LocalDefaultBranchIconVisibility}" />
            <FontIcon Glyph="&#xE80F;"
                      FontSize="{StaticResource Icon.Normal}"
                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                      Visibility="{Binding RemoteDefaultBranchIconVisibility}" />
            <FontIcon Glyph="{Binding IconGlyph}"
                      FontSize="{StaticResource Icon.Normal}"
                      Visibility="{Binding IconVisibility}" />
            <TextBlock Text="{Binding DisplayName}"
                       Style="{StaticResource BodyTextStyle}"
                       FontWeight="{Binding NameFontWeight}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </TreeViewItem.Content>
    </TreeViewItem>
  </DataTemplate>

  <DataTemplate x:Key="ChangedFileTreeItemTemplate">
    <TreeViewItem ItemsSource="{Binding Children}"
                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                  Style="{StaticResource ChangedFileRowStyle}">
      <TreeViewItem.Content>
        <Grid ColumnDefinitions="*,26,46,46" Padding="2,0" ColumnSpacing="{StaticResource Spacing.XS}">
          <TextBlock Text="{Binding DisplayName}"
                     Style="{StaticResource BodyTextStyle}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     ToolTipService.ToolTip="{Binding Path}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding Status}"
                     Style="{StaticResource DiffSecondaryTextStyle}"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Text="{Binding AddedDisplay}"
                     Style="{StaticResource DiffSecondaryTextStyle}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="3"
                     Text="{Binding RemovedDisplay}"
                     Style="{StaticResource DiffSecondaryTextStyle}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center" />
        </Grid>
      </TreeViewItem.Content>
    </TreeViewItem>
  </DataTemplate>

  <DataTemplate x:Key="UnstagedWorkingTreeItemTemplate">
    <Grid ColumnDefinitions="24,*">
      <TextBlock Text="{Binding WorkingTreeStatus}"
                 Style="{StaticResource DiffSecondaryTextStyle}"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="1"
                 Text="{Binding Path}"
                 Style="{StaticResource BodyTextStyle}"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="StagedWorkingTreeItemTemplate">
    <Grid ColumnDefinitions="24,*">
      <TextBlock Text="{Binding IndexStatus}"
                 Style="{StaticResource DiffSecondaryTextStyle}"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="1"
                 Text="{Binding Path}"
                 Style="{StaticResource BodyTextStyle}"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="DiffItemTemplate">
    <Border Background="{Binding Kind, Converter={StaticResource DiffLineKindToBrushConverter}}">
      <Grid ColumnDefinitions="38,38,*" MinHeight="{StaticResource Height.DiffRow}">
        <TextBlock Text="{Binding OldLineNumber}"
                   Style="{StaticResource DiffSecondaryTextStyle}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="{StaticResource Margin.DiffNumber}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding NewLineNumber}"
                   Style="{StaticResource DiffSecondaryTextStyle}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="{StaticResource Margin.DiffNumber}" />
        <TextBlock Grid.Column="2"
                   Text="{Binding Text}"
                   Style="{StaticResource DiffTextStyle}"
                   TextWrapping="NoWrap"
                   VerticalAlignment="Center"
                   Padding="{StaticResource Padding.DiffText}" />
      </Grid>
    </Border>
  </DataTemplate>
</ResourceDictionary>
