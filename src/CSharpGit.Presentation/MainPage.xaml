<Page x:Class="CSharpGit.Presentation.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CSharpGit.Presentation.Controls">
  <Page.Resources>
    <controls:CommitTopologyToGraphVisualConverter x:Key="CommitTopologyToGraphVisualConverter" />
    <controls:DiffLineKindToBrushConverter x:Key="DiffLineKindToBrushConverter" />
    <ContentDialog x:Key="GitOperationsDialog" Title="Git operations" CloseButtonText="Close" DefaultButton="Close">
      <ScrollViewer MaxHeight="650" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="620" Spacing="12">
          <TextBlock Text="Branches" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding NewBranchName, Mode=TwoWay}" PlaceholderText="New local branch" />
            <Button Grid.Column="1" Content="Create and switch" Command="{Binding CreateBranchCommand}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding LocalBranches}" SelectedItem="{Binding SelectedMergeBranch, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Branch to merge" />
            <Button Grid.Column="1" Content="Merge into current" Command="{Binding MergeCommand}" />
          </Grid>

          <TextBlock Text="Tracking branch" FontWeight="SemiBold" Margin="0,4,0,0" />
          <Grid ColumnDefinitions="200,*,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding RemoteBranches}" SelectedItem="{Binding SelectedRemoteBranch, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Remote branch" />
            <TextBox Grid.Column="1" Text="{Binding NewBranchName, Mode=TwoWay}" PlaceholderText="Local branch name" />
            <Button Grid.Column="2" Content="Checkout tracking" Command="{Binding CheckoutRemoteCommand}" />
          </Grid>

          <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
          <TextBlock Text="Stash" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding StashMessage, Mode=TwoWay}" PlaceholderText="Optional stash message" />
            <Button Grid.Column="1" Content="Create stash" Command="{Binding CreateStashCommand}" />
          </Grid>

          <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
          <TextBlock Text="Remote / explicit push" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding Remotes}" SelectedItem="{Binding SelectedRemote, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Remote" />
            <TextBox Grid.Column="1" Text="{Binding PushBranchName, Mode=TwoWay}" PlaceholderText="Remote branch name" />
            <CheckBox Grid.Column="2" Content="Set upstream" IsChecked="{Binding SetUpstream, Mode=TwoWay}" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Push" Click="Push_Click" />
            <Button Content="Force push with lease…" Click="ForcePushWithLease_Click" IsEnabled="{Binding CanForcePushWithLease}" />
            <Button Content="Fetch all" Command="{Binding FetchAllCommand}" />
          </StackPanel>

          <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
          <TextBlock Text="Interactive rebase" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding RebaseOnto, Mode=TwoWay}" PlaceholderText="onto (for example HEAD~3)" />
            <Button Grid.Column="1" Content="Build plan" Command="{Binding LoadRebasePlanCommand}" />
          </Grid>
          <ListView ItemsSource="{Binding RebasePlan}" SelectedItem="{Binding SelectedRebaseItem, Mode=TwoWay}" DisplayMemberPath="Display" Height="130" />
          <Grid ColumnDefinitions="Auto,Auto,140,*,Auto" ColumnSpacing="6">
            <Button Content="↑" Command="{Binding MoveRebaseUpCommand}" />
            <Button Grid.Column="1" Content="↓" Command="{Binding MoveRebaseDownCommand}" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding RebaseActions}" SelectedItem="{Binding RebaseAction, Mode=TwoWay}" />
            <TextBox Grid.Column="3" Text="{Binding RebaseMessage, Mode=TwoWay}" PlaceholderText="New message for reword" />
            <Button Grid.Column="4" Content="Apply" Command="{Binding ApplyRebaseItemCommand}" />
          </Grid>
          <Button Content="Start rebase" Command="{Binding StartRebaseCommand}" HorizontalAlignment="Left" />

          <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
          <TextBlock Text="Merge tool settings" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="140,160,160" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding MergeToolNames}" IsEditable="True" Text="{Binding MergeToolName, Mode=TwoWay}" Header="Preset/name" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding MergeToolKinds}" SelectedItem="{Binding MergeToolKind, Mode=TwoWay}" Header="Type" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding MergeToolScopes}" SelectedItem="{Binding MergeToolScope, Mode=TwoWay}" Header="Git config" />
          </Grid>
          <TextBox Header="Executable/path or command" Text="{Binding MergeToolExecutable, Mode=TwoWay}" />
          <TextBox Header="Arguments: $BASE $LOCAL $REMOTE $MERGED" Text="{Binding MergeToolArguments, Mode=TwoWay}" />
          <Button Content="Save merge tool configuration" Command="{Binding ConfigureMergeToolCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </ScrollViewer>
    </ContentDialog>

    <ContentDialog x:Key="AppearanceDialog" Title="Appearance" CloseButtonText="Close" DefaultButton="Close">
      <StackPanel Width="320" Spacing="8">
        <TextBlock Text="Theme" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedThemeName, Mode=TwoWay}" />
        <TextBlock Text="System follows the operating system appearance." TextWrapping="Wrap" Opacity="0.66" />
      </StackPanel>
    </ContentDialog>
  </Page.Resources>

  <Grid x:Name="RootLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RequestedTheme="{Binding SelectedTheme, Mode=TwoWay}" KeyDown="Page_KeyDown">
    <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Visibility="{Binding PickerVisibility}">
      <FontIcon Glyph="&#xE8B7;" FontSize="56" HorizontalAlignment="Center" />
      <TextBlock Text="Open a Git repository" Style="{StaticResource TitleTextBlockStyle}" TextAlignment="Center" />
      <TextBlock Text="Select the folder of an existing repository or worktree." TextWrapping="Wrap" TextAlignment="Center" Opacity="0.72" />
      <Button Content="Select folder…" Command="{Binding OpenRepositoryCommand}" HorizontalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Visibility="{Binding BusyVisibility}">
        <ProgressRing IsActive="{Binding IsBusy}" Width="20" Height="20" />
        <TextBlock Text="Opening repository…" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <Grid x:Name="RepositoryWorkspace" Visibility="{Binding RepositoryVisibility}" RowDefinitions="54,Auto,*,30">
      <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="10,0">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE8B7;" FontSize="18" />
            <TextBlock Text="CSharpGit" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
          <Border Grid.Column="1" Width="1" Height="24" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding Repository.WorkingDirectory}" TextTrimming="CharacterEllipsis" MaxWidth="430" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Repository.WorkingDirectory}" />
          <Border Grid.Column="3" Width="1" Height="24" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="2,0,4,0">
            <FontIcon Glyph="&#xE8F0;" FontSize="14" />
            <TextBlock x:Name="ToolbarBranchText" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Click="Fetch_Click" Padding="8,5">
              <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE896;" FontSize="13" /><TextBlock Text="Fetch" /></StackPanel>
            </Button>
            <Button Click="Pull_Click" Padding="8,5">
              <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE896;" FontSize="13" /><TextBlock Text="Pull" /></StackPanel>
            </Button>
            <Button Padding="8,5">
              <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE898;" FontSize="13" /><TextBlock Text="Push ▼" /></StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="Push" Click="Push_Click" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Force push with lease…" Click="ForcePushWithLease_Click" IsEnabled="{Binding CanForcePushWithLease}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Click="RefreshAll_Click" Padding="8,5">
              <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE72C;" FontSize="13" /><TextBlock Text="Refresh" /></StackPanel>
            </Button>
            <ProgressRing x:Name="BusyIndicator" IsActive="{Binding IsBusy}" Width="18" Height="18" Margin="8,0,0,0" />
          </StackPanel>
          <Button Grid.Column="6" Width="36" Height="32" Padding="0" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE712;" FontSize="15" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="More Git operations…" Click="MoreOperations_Click" />
                <MenuFlyoutItem Text="Settings…" Click="Settings_Click" />
                <MenuFlyoutItem Text="Appearance…" Click="Appearance_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>

      <controls:OperationBanner Grid.Row="1" Visibility="{Binding OperationVisibility}" />

      <Grid Grid.Row="2" MinHeight="320">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="292" MinWidth="190" MaxWidth="450" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="*" MinWidth="540" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
          <Grid RowDefinitions="40,*">
            <TextBlock Text="Repository" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
            <TreeView x:Name="RepositoryTree" Grid.Row="1" SelectionMode="Single" Padding="4,2,4,4" ItemInvoked="RepositoryTree_ItemInvoked" RightTapped="RepositoryTree_RightTapped" DoubleTapped="RepositoryTree_DoubleTapped">
              <TreeView.ItemTemplate>
                <DataTemplate>
                  <TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=OneWay}" MinHeight="34" Padding="2,0" HorizontalContentAlignment="Stretch">
                    <TreeViewItem.Content>
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" Visibility="{Binding IconVisibility}" />
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </StackPanel>
                    </TreeViewItem.Content>
                  </TreeViewItem>
                </DataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Grid>
        </Border>

        <controls:GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                               MinimumFirst="190" MaximumFirst="450" MinimumSecond="540"
                               HorizontalAlignment="Stretch" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Column="2">
          <Grid x:Name="HistoryPane">
            <Grid.RowDefinitions>
              <RowDefinition Height="44" />
              <RowDefinition Height="*" MinHeight="180" />
              <RowDefinition Height="6" />
              <RowDefinition Height="300" MinHeight="140" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,5">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="HistoryFilter" Text="{Binding FilterText, Mode=TwoWay}" PlaceholderText="Filter commits…" KeyDown="HistoryFilter_KeyDown" />
                <ComboBox x:Name="ScopeCombo" Grid.Column="1" ItemsSource="{Binding Scopes}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedScope, Mode=TwoWay}" MinWidth="155" />
                <StackPanel x:Name="ReferenceScopePanel" Grid.Column="1" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" VerticalAlignment="Center">
                  <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                    <TextBlock x:Name="ActiveReferenceText" />
                  </Border>
                  <Button Content="All refs" Click="ClearReference_Click" Padding="8,4" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="1" RowDefinitions="30,*,Auto">
              <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="6,0">
                <Grid ColumnDefinitions="120,*,160,150,90">
                  <TextBlock Text="GRAPH" FontSize="11" Opacity="0.58" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="MESSAGE" FontSize="11" Opacity="0.58" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="AUTHOR" FontSize="11" Opacity="0.58" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="DATE" FontSize="11" Opacity="0.58" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="HASH" FontSize="11" Opacity="0.58" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ListView x:Name="HistoryList" Grid.Row="1" SelectedItem="{Binding SelectedHistoryRow, Mode=TwoWay}" IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="120,*,160,150,90" Height="34" Padding="6,0">
                      <controls:CommitGraphControl Graph="{Binding Topology, Converter={StaticResource CommitTopologyToGraphVisualConverter}}" VerticalAlignment="Stretch" />
                      <Grid Grid.Column="1" ColumnDefinitions="Auto,*" MinWidth="120">
                        <TextBlock Text="{Binding Commit.Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Commit.References}" Margin="8,0,0,0" VerticalAlignment="Center">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                                <TextBlock Text="{Binding}" FontSize="11" Opacity="0.82" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                      <TextBlock Grid.Column="2" Text="{Binding Commit.Author}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <controls:CommitTimeText Grid.Column="3" Value="{Binding Commit.AuthoredAt}" VerticalAlignment="Center" FontSize="12" />
                      <TextBlock Grid.Column="4" Text="{Binding Commit.ShortHash}" FontFamily="Consolas" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <Button x:Name="LoadMoreHistoryButton" Grid.Row="2" Content="Load more" Click="LoadMoreHistory_Click" HorizontalAlignment="Center" Padding="10,3" Margin="0,3" />
            </Grid>

            <controls:GridSplitter Grid.Row="2" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                   MinimumFirst="180" MinimumSecond="140"
                                   VerticalAlignment="Stretch" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Pivot x:Name="DetailsTabs" Grid.Row="3" Visibility="{Binding DetailsVisibility}">
              <PivotItem Header="Commit">
                <ScrollViewer x:Name="DetailsScroller" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" MinHeight="140">
                  <StackPanel Padding="12,8" Spacing="8">
                    <TextBlock Text="{Binding SelectedCommit.Commit.Message}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14" />
                    <ItemsControl ItemsSource="{Binding SelectedCommit.Commit.References}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,0">
                            <TextBlock Text="{Binding}" FontSize="11" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="74,*" RowSpacing="6" ColumnSpacing="10">
                      <TextBlock Text="Author" Opacity="0.58" /><TextBlock Grid.Column="1" Text="{Binding SelectedCommit.Commit.Author}" />
                      <TextBlock Grid.Row="1" Text="Date" Opacity="0.58" /><controls:CommitTimeText Grid.Row="1" Grid.Column="1" Value="{Binding SelectedCommit.Commit.AuthoredAt}" />
                      <TextBlock Grid.Row="2" Text="Hash" Opacity="0.58" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCommit.Commit.Hash}" FontFamily="Consolas" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="3" Text="Parents" Opacity="0.58" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCommit.Commit.ParentsDisplay}" FontFamily="Consolas" TextWrapping="Wrap" />
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </PivotItem>

              <PivotItem x:Name="FilesTab" Header="Changes">
                <Grid MinHeight="140" Loaded="ChangesSurface_Loaded">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38*" MinWidth="220" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="62*" MinWidth="280" />
                  </Grid.ColumnDefinitions>

                  <Grid RowDefinitions="32,*">
                    <Grid Padding="8,0" ColumnDefinitions="*,28,52,52">
                      <TextBlock Text="Changed files" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="S" FontSize="10" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="+" FontSize="10" Opacity="0.55" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="−" FontSize="10" Opacity="0.55" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TreeView x:Name="ChangedFilesTree" Grid.Row="1" SelectionMode="Single" Padding="2,0,2,2" ItemInvoked="ChangedFilesTree_ItemInvoked">
                      <TreeView.ItemTemplate>
                        <DataTemplate>
                          <TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" MinHeight="28" Padding="1,0" HorizontalContentAlignment="Stretch">
                            <TreeViewItem.Content>
                              <Grid ColumnDefinitions="*,28,52,52" Padding="2,0" ColumnSpacing="4">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Path}" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding AddedDisplay}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding RemovedDisplay}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                              </Grid>
                            </TreeViewItem.Content>
                          </TreeViewItem>
                        </DataTemplate>
                      </TreeView.ItemTemplate>
                    </TreeView>

                    <ListView x:Name="CommitFilesList" Grid.Row="1" Visibility="Collapsed"
                              SelectionChanged="CommitFilesList_SelectionChanged"
                              DoubleTapped="CommitFilesList_DoubleTapped"
                              KeyDown="CommitFilesList_KeyDown" />
                  </Grid>

                  <controls:GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                         MinimumFirst="220" MinimumSecond="280"
                                         HorizontalAlignment="Stretch" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                  <Grid Grid.Column="2" RowDefinitions="36,22,*">
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                      <TextBlock Text="{Binding SelectedFile.Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" ToolTipService.ToolTip="{Binding SelectedFile.Path}" />
                    </Border>

                    <Border Grid.Row="1" Visibility="{Binding DiffVisibility}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="46,46,*">
                        <TextBlock Text="OLD" FontSize="9" Opacity="0.52" HorizontalAlignment="Right" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="NEW" FontSize="9" Opacity="0.52" HorizontalAlignment="Right" Margin="0,0,7,0" VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                      <InfoBar IsOpen="True" Severity="Informational" Title="Binary file"
                               Message="Binary file — text diff is not available."
                               Visibility="{Binding BinaryVisibility}" IsClosable="False" VerticalAlignment="Top" />
                      <ListView x:Name="CompactDiffList" Visibility="{Binding DiffVisibility}" SelectionMode="None"
                                HorizontalContentAlignment="Stretch"
                                ScrollViewer.HorizontalScrollMode="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollMode="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                          <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="22" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                          </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{Binding Kind, Converter={StaticResource DiffLineKindToBrushConverter}}">
                              <Grid ColumnDefinitions="46,46,*" MinHeight="22">
                                <TextBlock Text="{Binding OldLineNumber}" FontFamily="Consolas" FontSize="11" Opacity="0.58"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Grid.Column="1" Text="{Binding NewLineNumber}" FontFamily="Consolas" FontSize="11" Opacity="0.58"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="Consolas" FontSize="12"
                                           TextWrapping="NoWrap" VerticalAlignment="Center" Padding="6,2" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListView.ItemTemplate>
                      </ListView>
                    </Grid>
                  </Grid>
                </Grid>
              </PivotItem>
            </Pivot>
          </Grid>

          <Grid x:Name="WorkingTreePane" Visibility="Collapsed" RowDefinitions="Auto,*,Auto" Padding="12">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Working tree" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Staged and unstaged changes are shown independently." Opacity="0.62" />
              </StackPanel>
              <Button Grid.Column="1" Content="Back to history" Click="ShowHistory_Click" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="330,6,*" MinHeight="180">
              <Grid Grid.Column="0" RowDefinitions="*,12,*">
                <Grid Grid.Row="0" RowDefinitions="Auto,*,Auto">
                  <TextBlock x:Name="UnstagedHeader" Text="Unstaged changes" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <ListView x:Name="UnstagedChangesList" Grid.Row="1" SelectionChanged="UnstagedChangesList_SelectionChanged">
                    <ListView.ItemTemplate>
                      <DataTemplate><Grid ColumnDefinitions="32,*" Padding="6,3"><TextBlock Text="{Binding WorkingTreeStatus}" FontFamily="Consolas" /><TextBlock Grid.Column="1" Text="{Binding Path}" /></Grid></DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <Button Content="Stage" Command="{Binding StageCommand}" />
                    <Button Content="Discard…" Command="{Binding RequestDiscardCommand}" />
                  </StackPanel>
                </Grid>

                <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
                  <TextBlock x:Name="StagedHeader" Text="Staged changes" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <ListView x:Name="StagedChangesList" Grid.Row="1" SelectionChanged="StagedChangesList_SelectionChanged">
                    <ListView.ItemTemplate>
                      <DataTemplate><Grid ColumnDefinitions="32,*" Padding="6,3"><TextBlock Text="{Binding IndexStatus}" FontFamily="Consolas" /><TextBlock Grid.Column="1" Text="{Binding Path}" /></Grid></DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                  <Button Grid.Row="2" Content="Unstage" Command="{Binding UnstageCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                </Grid>
              </Grid>

              <controls:GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                     MinimumFirst="220" MinimumSecond="280"
                                     HorizontalAlignment="Stretch" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

              <Grid Grid.Column="2" RowDefinitions="36,22,*" Margin="10,0,0,0">
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="WorkingTreeDiffHeader" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock x:Name="WorkingTreeDiffKindText" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Opacity="0.72" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="38,38,*">
                    <TextBlock Text="OLD" FontSize="9" Opacity="0.52" HorizontalAlignment="Right" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="NEW" FontSize="9" Opacity="0.52" HorizontalAlignment="Right" Margin="0,0,5,0" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Grid Grid.Row="2">
                  <InfoBar x:Name="WorkingTreeBinaryInfo" IsOpen="True" Severity="Informational" Title="Binary file"
                           Message="Binary file — text diff is not available." Visibility="Collapsed" IsClosable="False" VerticalAlignment="Top" />
                  <InfoBar x:Name="WorkingTreeNoChangesInfo" IsOpen="True" Severity="Informational" Title="No changes"
                           Message="The selected delta no longer exists." Visibility="Collapsed" IsClosable="False" VerticalAlignment="Top" />
                  <ListView x:Name="WorkingTreeCompactDiffList" Visibility="Collapsed" SelectionMode="None"
                            HorizontalContentAlignment="Stretch"
                            ScrollViewer.HorizontalScrollMode="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollMode="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
              </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
              <StackPanel Spacing="8">
                <TextBox x:Name="CommitMessageEditor" Header="Commit message" Text="{Binding CommitMessage, Mode=TwoWay}" AcceptsReturn="True" MinHeight="74" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Commit" Command="{Binding CommitCommand}" />
                  <Button Content="Amend" Command="{Binding AmendCommand}" />
                </StackPanel>
                <InfoBar IsOpen="True" Severity="Warning" Title="The index is empty" Message="Choose whether to stage all working-tree changes, create an intentional empty commit, or cancel. Nothing has been staged implicitly." Visibility="{Binding EmptyIndexChoiceVisibility}" IsClosable="False">
                  <InfoBar.ActionButton><Button Content="Stage all and commit" Command="{Binding StageAllAndCommitCommand}" /></InfoBar.ActionButton>
                </InfoBar>
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding EmptyIndexChoiceVisibility}">
                  <Button Content="Create empty commit" Command="{Binding ConfirmEmptyCommitCommand}" />
                  <Button Content="Cancel" Command="{Binding CancelCommitCommand}" />
                </StackPanel>
                <InfoBar IsOpen="True" Severity="Warning" Title="Confirm discarding unstaged changes" Message="This action restores the working-tree version from the index (or deletes an untracked file). Staged changes are preserved." Visibility="{Binding DiscardConfirmationVisibility}" IsClosable="False">
                  <InfoBar.ActionButton><Button Content="Confirm discard" Command="{Binding ConfirmDiscardCommand}" /></InfoBar.ActionButton>
                </InfoBar>
                <Button Content="Cancel discard" Command="{Binding CancelDiscardCommand}" Visibility="{Binding DiscardConfirmationVisibility}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="10,0">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="16">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE8F0;" FontSize="12" />
            <TextBlock x:Name="StatusBranchText" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="StatusTrackingText" Grid.Column="1" Opacity="0.66" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusChangesText" Grid.Column="2" Opacity="0.66" VerticalAlignment="Center" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE73E;" FontSize="11" Opacity="0.66" />
            <TextBlock x:Name="StatusOperationText" Opacity="0.66" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <InfoBar IsOpen="{Binding HasError}" Severity="Error" Title="Error" Message="{Binding ErrorMessage}" IsClosable="False" VerticalAlignment="Bottom" Margin="16,0,16,34" />
  </Grid>
</Page>