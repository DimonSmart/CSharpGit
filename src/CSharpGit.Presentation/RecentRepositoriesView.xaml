<UserControl
    x:Class="CSharpGit.Presentation.RecentRepositoriesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CSharpGit.Presentation.Controls">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <ItemsPanelTemplate x:Key="RecentRepositoriesItemsPanelTemplate">
      <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="344" ItemHeight="156" />
    </ItemsPanelTemplate>

    <Style x:Key="RecentRepositoryGridItemStyle" TargetType="GridViewItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <DataTemplate x:Key="RecentRepositoryTileTemplate">
      <Grid Height="156" Padding="6">
        <Grid.ContextFlyout>
          <MenuFlyout>
            <MenuFlyoutItem Text="Move earlier"
                            Command="{Binding MoveEarlierCommand}"
                            IsEnabled="{Binding CanMoveEarlier}"
                            Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <MenuFlyoutItem Text="Move later"
                            Command="{Binding MoveLaterCommand}"
                            IsEnabled="{Binding CanMoveLater}"
                            Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </MenuFlyout>
        </Grid.ContextFlyout>

        <Button Command="{Binding OpenCommand}"
                Padding="0"
                BorderThickness="0"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
          <Border Style="{StaticResource FormCardStyle}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="10"
                  Opacity="{Binding TileOpacity}">
            <Grid>
              <Grid Visibility="{Binding RepositoryCompactLayoutVisibility}"
                    ColumnDefinitions="64,*"
                    RowDefinitions="Auto,Auto,*"
                    ColumnSpacing="{StaticResource Spacing.XL}">
                <Border Grid.RowSpan="3"
                        Width="64" Height="64" CornerRadius="9"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        VerticalAlignment="Top">
                  <Grid>
                    <FontIcon Glyph="&#xE8B7;"
                              FontSize="25"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Opacity="{Binding RepositoryGlyphOpacity}" />
                    <Image Source="{Binding RepositoryImage}"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Opacity="{Binding RepositoryImageOpacity}"
                           ImageFailed="RepositoryImage_ImageFailed" />
                  </Grid>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplayName}"
                           Style="{StaticResource TitleTextStyle}"
                           Margin="0,1,76,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Path}"
                           Style="{StaticResource TechnicalSecondaryTextStyle}"
                           Margin="0,5,10,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{Binding Path}" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding Metadata}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,8,10,0"
                           VerticalAlignment="Top"
                           TextTrimming="CharacterEllipsis" />
              </Grid>

              <Grid Visibility="{Binding RepositoryPreviewLayoutVisibility}"
                    ColumnDefinitions="*,280"
                    RowDefinitions="Auto,Auto,*"
                    ColumnSpacing="{StaticResource Spacing.XL}">
                <TextBlock Text="{Binding DisplayName}"
                           Style="{StaticResource TitleTextStyle}"
                           Margin="0,1,76,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1"
                           Text="{Binding Path}"
                           Style="{StaticResource TechnicalSecondaryTextStyle}"
                           Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{Binding Path}" />
                <TextBlock Grid.Row="2"
                           Text="{Binding Metadata}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,8,0,0"
                           VerticalAlignment="Top"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.RowSpan="3"
                        Grid.Column="1"
                        Width="280" Height="116"
                        CornerRadius="7"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                  <Image Source="{Binding RepositoryPreview}"
                         Stretch="UniformToFill"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         ImageFailed="RepositoryPreview_ImageFailed" />
                </Border>
              </Grid>
            </Grid>
          </Border>
        </Button>

        <StackPanel Orientation="Horizontal"
                    Spacing="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,12,0">
          <Button Command="{Binding PinCommand}"
                  Width="30" Height="30"
                  Padding="0"
                  Background="Transparent"
                  BorderThickness="0"
                  ToolTipService.ToolTip="{Binding PinActionLabel}"
                  AutomationProperties.Name="{Binding PinActionLabel}">
            <FontIcon Glyph="{Binding PinGlyph}"
                      FontSize="{StaticResource Icon.Small}"
                      Opacity="{Binding PinIndicatorOpacity}" />
          </Button>
          <Button Command="{Binding RemoveCommand}"
                  Width="30" Height="30"
                  Padding="0"
                  Background="Transparent"
                  BorderThickness="0"
                  ToolTipService.ToolTip="Remove from recent"
                  AutomationProperties.Name="Remove from recent">
            <FontIcon Glyph="&#xE711;" FontSize="{StaticResource Icon.Small}" />
          </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="1120"
                  Margin="{StaticResource Padding.Page}"
                  Spacing="{StaticResource Spacing.XL}"
                  HorizontalAlignment="Center">
        <TextBlock Text="Repositories" Style="{StaticResource TitleTextStyle}" />

        <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="Search by name or path…"
                 Style="{StaticResource CompactTextBoxStyle}"
                 AutomationProperties.Name="Search repositories by name or path" />

        <StackPanel Spacing="{StaticResource Spacing.S}"
                    Visibility="{Binding HasPinnedRepositories, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Text="Pinned" Style="{StaticResource BodyStrongTextStyle}" />
          <controls:RecentRepositoriesGridView x:Name="PinnedRepositoriesGridView"
                                               ItemsSource="{Binding PinnedRepositories}"
                                               SelectionMode="None"
                                               IsItemClickEnabled="False"
                                               CanDragItems="True"
                                               CanReorderItems="False"
                                               AllowDrop="True"
                                               DragItemsStarting="PinnedRepositoriesGridView_DragItemsStarting"
                                               DragOver="PinnedRepositoriesGridView_DragOver"
                                               DragLeave="PinnedRepositoriesGridView_DragLeave"
                                               Drop="PinnedRepositoriesGridView_Drop"
                                               DragItemsCompleted="PinnedRepositoriesGridView_DragItemsCompleted"
                                               HorizontalAlignment="Stretch"
                                               Padding="0"
                                               ItemsPanel="{StaticResource RecentRepositoriesItemsPanelTemplate}"
                                               ItemContainerStyle="{StaticResource RecentRepositoryGridItemStyle}"
                                               ItemTemplate="{StaticResource RecentRepositoryTileTemplate}" />
        </StackPanel>

        <StackPanel Spacing="{StaticResource Spacing.S}"
                    Visibility="{Binding HasRecentRepositories, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Text="Recent" Style="{StaticResource BodyStrongTextStyle}" />
          <controls:RecentRepositoriesGridView x:Name="RecentRepositoriesGridView"
                                               ItemsSource="{Binding RecentRepositories}"
                                               SelectionMode="None"
                                               IsItemClickEnabled="False"
                                               CanDragItems="False"
                                               HorizontalAlignment="Stretch"
                                               Padding="0"
                                               ItemsPanel="{StaticResource RecentRepositoriesItemsPanelTemplate}"
                                               ItemContainerStyle="{StaticResource RecentRepositoryGridItemStyle}"
                                               ItemTemplate="{StaticResource RecentRepositoryTileTemplate}" />
        </StackPanel>

        <TextBlock Text="No repositories match your search."
                   Style="{StaticResource BodySubduedTextStyle}"
                   Visibility="{Binding ShowNoSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <ItemsControl HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="252" ItemHeight="94" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <Button Command="{Binding OpenRepositoryCommand}"
                  Width="240" Height="82"
                  Margin="0,0,12,12"
                  Padding="{StaticResource Padding.Form}"
                  HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="42,*" ColumnSpacing="{StaticResource Spacing.XL}">
              <FontIcon Glyph="&#xE8B7;" FontSize="24" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="{StaticResource Spacing.XS}" VerticalAlignment="Center">
                <TextBlock Text="Open repository" Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="Choose a folder…" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </Grid>
          </Button>

          <Button Command="{Binding CreateRepositoryCommand}"
                  Width="240" Height="82"
                  Margin="0,0,12,12"
                  Padding="{StaticResource Padding.Form}"
                  HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="42,*" ColumnSpacing="{StaticResource Spacing.XL}">
              <FontIcon Glyph="&#xE710;" FontSize="24" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="{StaticResource Spacing.XS}" VerticalAlignment="Center">
                <TextBlock Text="Create repository" Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="Create a new local repository…" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </Grid>
          </Button>

          <Button Command="{Binding RemoveUnavailableRepositoriesCommand}"
                  IsEnabled="{Binding HasUnavailableRepositories}"
                  Width="240" Height="82"
                  Margin="0,0,12,12"
                  Padding="{StaticResource Padding.Form}"
                  HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="42,*" ColumnSpacing="{StaticResource Spacing.XL}">
              <FontIcon Glyph="&#xE74D;" FontSize="24" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="{StaticResource Spacing.XS}" VerticalAlignment="Center">
                <TextBlock Text="Remove missing" Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="Clean up recent list" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </Grid>
          </Button>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
