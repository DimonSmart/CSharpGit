<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <UnoSingleProject>true</UnoSingleProject>
    <AssemblyName>CSharpGit</AssemblyName>
    <ApplicationTitle>CSharpGit</ApplicationTitle>
    <ApplicationId>io.csharpgit.desktop</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <MicrosoftLoggingVersion>10.0.10</MicrosoftLoggingVersion>
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="../CSharpGit.Application/CSharpGit.Application.csproj" />
    <ProjectReference Include="../CSharpGit.Domain/CSharpGit.Domain.csproj" />
    <ProjectReference Include="../CSharpGit.Git/CSharpGit.Git.csproj" />
    <ProjectReference Include="../CSharpGit.Infrastructure/CSharpGit.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
