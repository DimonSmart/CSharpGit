    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/RepositoryTreeGuideLayout.cs" Link="RepositoryTree/RepositoryTreeGuideLayout.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/TreeHierarchyGuideBuilder.cs" Link="RepositoryTree/TreeHierarchyGuideBuilder.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/RepositoryTreeNodeKind.cs" Link="RepositoryTree/RepositoryTreeNodeKind.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/MiddleEllipsis.cs" Link="RepositoryTree/MiddleEllipsis.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/WorktreePresentation.cs" Link="RepositoryTree/WorktreePresentation.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/BranchFolderInfo.cs" Link="RepositoryTree/BranchFolderInfo.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/BranchMovePlanning.cs" Link="RepositoryTree/BranchMovePlanning.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/BranchFolderDeletionPlanning.cs" Link="RepositoryTree/BranchFolderDeletionPlanning.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/RepositoryTreeDescriptor.cs" Link="RepositoryTree/RepositoryTreeDescriptor.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/IncrementalTreeReconciler.cs" Link="RepositoryTree/IncrementalTreeReconciler.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/RepositoryTreeExpansion.cs" Link="RepositoryTree/RepositoryTreeExpansion.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/RepositoryTreeSelection.cs" Link="RepositoryTree/RepositoryTreeSelection.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/PathTreeBuilder.cs" Link="Trees/PathTreeBuilder.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/ChangedFileTreeNode.cs" Link="Changes/ChangedFileTreeNode.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/WorkingTreeTreeNode.cs" Link="WorkingTree/WorkingTreeTreeNode.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/WorkingTreeTreeSelection.cs" Link="WorkingTree/WorkingTreeTreeSelection.cs" />
    <Compile Include="../../src/CSharpGit.Presentation/ViewModels/CompactDiffLine.cs" Link="Changes/CompactDiffLine.cs" />
